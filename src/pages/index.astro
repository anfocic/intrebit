---
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/shared/SocialIcon.astro";
---

<Layout title="Coming Soon" showHeader={false} showFooter={false}>
    <main class="coming">
        <!-- Hero -->
        <section class="hero" aria-label="Coming soon hero">
            <!-- Background blobs -->
            <div class="blob blob--1"></div>
            <div class="blob blob--2"></div>
            <div class="blob blob--3"></div>

            <div class="hero__inner">
                <header class="hero__header">
                    <h1 class="hero__title">Intrebit</h1>
                    <p class="hero__subtitle">
                        No buzzwords. No junk. Just solid tools that work.
                    </p>
                </header>

                <div class="hero__actions">
                    <a class="btn btn--primary" href="mailto:hello@intrebit.com">
                        Get in touch
                    </a>
                    <a
                            class="btn btn--ghost"
                            href="https://www.linkedin.com/company/intrebit"
                            target="_blank"
                            rel="noopener noreferrer"
                    >
                        Follow us
                    </a>
                </div>

                <div class="badge" aria-label="Launch badge">
                    <span class="badge__dot"></span>
                    <span class="badge__text">Launching in Q1 2026</span>
                </div>
            </div>
        </section>

        <!-- Newsletter -->
        <section class="newsletter" aria-label="Newsletter signup">
            <div class="container newsletter__inner">
                <div class="card">
                    <div class="card__header">
                        <h2 class="card__title">Stay in the loop</h2>
                        <p class="card__subtitle">
                            Get notified when we launch. No spam, no corporate emails. Just real updates.
                        </p>
                    </div>

                    <form class="form" id="newsletter-form">
                        <!-- Honeypot (spam trap) -->
                        <label class="honeypot" aria-hidden="true">
                            Do not fill
                            <input type="text" name="company" tabindex="-1" autocomplete="off"/>
                        </label>

                        <input
                                class="input"
                                type="email"
                                name="email"
                                id="newsletter-email"
                                placeholder="your@email.com"
                                required
                                autocomplete="email"
                        />
                        <button class="btn btn--primary" type="submit">
                            Notify me
                        </button>
                    </form>

                    <p class="note">One email when we launch. That’s it.</p>
                    <p class="status" id="newsletter-status" aria-live="polite"></p>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <p class="footer__text">
                © 2026 Intrebit. We're just millennials trying to not burn out.
            </p>

            <div class="footer__social">
                <SocialIcon
                        icon="mastodon"
                        href="https://mastodon.social/@intrebit"
                        title="Mastodon"
                        rel="me noopener noreferrer"
                        className="footer__social-icon"
                />
            </div>
        </footer>
    </main>

    <script is:inline>
        (() => {
            const API_BASE = "https://api.intrebit.com";
            const ENDPOINT = "/contact"; // ✅ same route as contact form

            const form = document.getElementById("newsletter-form");
            const status = document.getElementById("newsletter-status");

            if (!form || !status) return;

            // ✅ Status helper (adds green success + red error)
            const setStatus = (msg, type = "info") => {
                status.textContent = msg;
                status.classList.remove("status--success", "status--error", "status--info");
                status.classList.add(`status--${type}`);
            };

            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                setStatus("Sending…", "info");

                const data = new FormData(form);

                // Honeypot → silent success
                if (data.get("company")) {
                    setStatus("Thanks — you're on the list.", "success");
                    form.reset();
                    return;
                }

                const email = data.get("email")?.toString().trim();

                if (!email) {
                    setStatus("Please enter a valid email.", "error");
                    return;
                }

                // ✅ Send to same endpoint as contact form
                const payload = {
                    name: "Newsletter signup",
                    email,
                    message: `Newsletter signup: ${email}`,
                };

                try {
                    const res = await fetch(`${API_BASE}${ENDPOINT}`, {
                        method: "POST",
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify(payload),
                    });

                    if (!res.ok) throw new Error(`Request failed (${res.status})`);

                    setStatus("Thanks — you're on the list.", "success");
                    form.reset();
                } catch (err) {
                    console.error(err);
                    setStatus("Something went wrong. Try again.", "error");
                }
            });
        })();
    </script>
    <style>
        /* =========================================================
           Coming Soon — Intrebit (DRY + theme-aware)
           Drop-in replacement for the page <style>.
           Focus: bigger input, smaller button in newsletter form.
           ========================================================= */

        /* ---------- Layout ---------- */
        .coming {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--bg);
            color: var(--text);
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* ---------- Hero ---------- */
        .hero {
            position: relative;
            flex: 1;
            display: grid;
            place-items: center;
            padding: 5rem 2rem 4rem;
            overflow: hidden;
        }

        .hero__inner {
            text-align: center;
            max-width: 650px;
            position: relative;
            z-index: 2;
            animation: fadeUp 0.8s ease-out both;
        }

        .hero__title {
            font-size: clamp(2.5rem, 7vw, 4rem);
            font-weight: 750;
            letter-spacing: -0.04em;
            margin: 0 0 0.6rem;
            color: var(--text);
        }

        .hero__subtitle {
            margin: 0 auto 2.25rem;
            font-size: 1.15rem;
            color: var(--text-muted);
            max-width: 560px;
            line-height: 1.6;
        }

        .hero__actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        /* ---------- Buttons (base) ---------- */
        .btn {
            height: 50px;
            padding: 0 1.35rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 650;
            text-decoration: none;
            border: 1px solid transparent;
            transition:
                    transform 0.16s var(--ease),
                    background 0.16s var(--ease),
                    border-color 0.16s var(--ease),
                    color 0.16s var(--ease),
                    box-shadow 0.16s var(--ease),
                    filter 0.16s var(--ease);
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn--primary {
            background: linear-gradient(
                    180deg,
                    rgba(255, 255, 255, 0.06),
                    rgba(255, 255, 255, 0.02)
            );
            color: var(--text);
            border-color: rgba(255, 255, 255, 0.12);
            box-shadow:
                    0 10px 28px rgba(0, 0, 0, 0.22),
                    inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }

        .btn--primary:hover {
            border-color: rgba(255, 255, 255, 0.18);
            box-shadow:
                    0 14px 34px rgba(0, 0, 0, 0.28),
                    inset 0 1px 0 rgba(255, 255, 255, 0.12);
        }

        .btn--ghost {
            background: rgba(255, 255, 255, 0.03);
            color: var(--text);
            border-color: rgba(255, 255, 255, 0.1);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }

        .btn--ghost:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.16);
        }

        /* Light theme: buttons should feel more “navy/ink” */
        :root[data-theme="light"] .btn--primary {
            background: var(--text);
            color: var(--bg);
            border-color: rgba(14, 42, 71, 0.22);
            box-shadow: 0 16px 44px rgba(14, 42, 71, 0.18);
        }

        :root[data-theme="light"] .btn--ghost {
            background: rgba(14, 42, 71, 0.04);
            border-color: rgba(14, 42, 71, 0.14);
            color: var(--text);
        }

        /* ---------- Badge ---------- */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.75rem 1.25rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.10);
            box-shadow:
                    0 14px 40px rgba(0, 0, 0, 0.22),
                    inset 0 1px 0 rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
        }

        .badge__dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--accent);
            box-shadow:
                    0 0 0 6px color-mix(in srgb, var(--accent) 18%, transparent),
                    0 0 24px color-mix(in srgb, var(--accent) 30%, transparent);
            animation: pulse 1.6s ease-in-out infinite;
        }

        .badge__text {
            font-size: 0.82rem;
            font-weight: 750;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--text);
        }

        /* ---------- Newsletter ---------- */
        .newsletter {
            padding: 3.75rem 0;
            border-top: 1px solid var(--border);
            background: color-mix(in srgb, var(--text) 3%, transparent);
        }

        .newsletter__inner {
            display: flex;
            justify-content: center;
        }

        /* Card */
        .card {
            width: 100%;
            max-width: 760px;
            border-radius: 18px;
            padding: 2.25rem;
            text-align: center;
            background: var(--surface);
            border: 1px solid var(--border);
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.06);
            backdrop-filter: blur(10px);
            color: var(--text);
        }

        :root[data-theme="dark"] .card {
            box-shadow: 0 22px 60px rgba(0, 0, 0, 0.25);
        }

        .card__title {
            margin: 0 0 0.6rem;
            font-size: 1.85rem;
            letter-spacing: -0.03em;
            color: var(--text);
        }

        .card__subtitle {
            margin: 0 auto 1.8rem;
            max-width: 560px;
            line-height: 1.6;
            color: var(--text-muted);
        }

        /* ---------- Form (BIGGER input, SMALLER button) ---------- */
        .form {
            display: flex;
            gap: 0.85rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            margin-top: 1.2rem;
        }

        /* Input gets bigger + visually stronger */
        .input {
            min-width: 320px;         /* ⬅️ bigger */
            max-width: 520px;         /* prevents it becoming massive on desktop */
            height: 60px;             /* ⬅️ bigger */
            padding: 0 1.35rem;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: var(--bg);
            color: var(--text);
            font-size: 1.08rem;
            letter-spacing: -0.01em;
            transition: border-color 0.16s var(--ease), box-shadow 0.16s var(--ease);
        }

        .input::placeholder {
            color: var(--text-muted);
            opacity: 0.8;
        }

        /* Dark mode input: deep glass */
        :root[data-theme="dark"] .input {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.14);
            color: rgba(246, 244, 239, 0.92);
        }

        :root[data-theme="dark"] .input::placeholder {
            color: rgba(246, 244, 239, 0.55);
        }

        .input:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--accent) 55%, transparent);
            box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 18%, transparent);
        }

        /* Newsletter submit button: smaller + tighter */
        .form .btn {
            height: 48px;             /* ⬅️ smaller */
            padding: 0 1.1rem;        /* ⬅️ smaller */
            font-size: 1rem;
            min-width: 140px;
        }

        /* ---------- Note + Status ---------- */
        .note {
            margin: 1.1rem 0 0;
            font-size: 0.95rem;
            color: var(--text-muted);
            opacity: 0.92;
        }

        .status {
            margin-top: 1.2rem;
            padding: 0.9rem 1.2rem;
            border-radius: 14px;
            font-size: 0.95rem;
            font-weight: 600;
            line-height: 1.4;
            text-align: center;
            border: 1px solid transparent;
            background: transparent;
            color: rgba(255, 255, 255, 0.86);
            opacity: 0;
            transform: translateY(4px);
            transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
        }

        .status:not(:empty) {
            opacity: 1;
            transform: translateY(0);
        }

        .status--success {
            background: rgba(34, 197, 94, 0.14);
            border-color: rgba(34, 197, 94, 0.35);
            color: rgba(220, 252, 231, 0.95);
        }

        .status--error {
            background: rgba(239, 68, 68, 0.14);
            border-color: rgba(239, 68, 68, 0.35);
            color: rgba(254, 226, 226, 0.95);
        }

        .status--info {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.82);
        }

        /* Light mode: status text should be ink */
        :root[data-theme="light"] .status {
            color: rgba(14, 42, 71, 0.82);
        }

        :root[data-theme="light"] .status--success {
            color: rgba(12, 74, 40, 0.95);
        }

        :root[data-theme="light"] .status--error {
            color: rgba(127, 29, 29, 0.95);
        }

        /* ---------- Honeypot ---------- */
        .honeypot {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
        }

        /* ---------- Footer ---------- */
        .footer {
            padding: 2rem;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            background: transparent;
        }

        .footer__text {
            margin: 0;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-align: center;
        }

        .footer__social {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .footer__social-icon {
            width: 40px;
            height: 40px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.75);
            transition: transform 0.16s var(--ease), background 0.16s var(--ease),
            border-color 0.16s var(--ease), color 0.16s var(--ease);
        }

        .footer__social-icon:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.22);
            color: rgba(255, 255, 255, 1);
        }

        :root[data-theme="light"] .footer__social-icon {
            background: rgba(14, 42, 71, 0.05);
            border-color: rgba(14, 42, 71, 0.12);
            color: rgba(14, 42, 71, 0.75);
        }

        :root[data-theme="light"] .footer__social-icon:hover {
            background: rgba(14, 42, 71, 0.08);
            border-color: rgba(14, 42, 71, 0.2);
            color: rgba(14, 42, 71, 1);
        }

        /* ---------- Background blobs ---------- */
        .blob {
            position: absolute;
            border-radius: 999px;
            opacity: 0.05;
            pointer-events: none;
        }

        .blob--1,
        .blob--3 {
            background: var(--accent);
        }

        .blob--2 {
            background: color-mix(in srgb, var(--accent) 45%, white);
            opacity: 0.05;
        }

        .blob--1 {
            width: 320px;
            height: 320px;
            top: -110px;
            right: -90px;
            animation: float 6s ease-in-out infinite;
        }

        .blob--2 {
            width: 220px;
            height: 220px;
            bottom: -70px;
            left: -70px;
            animation: drift 8s ease-in-out infinite;
        }

        .blob--3 {
            width: 160px;
            height: 160px;
            top: 55%;
            left: 10%;
            animation: float 7s ease-in-out infinite;
        }

        /* ---------- Animations ---------- */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.85; }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-18px); }
        }

        @keyframes drift {
            0%, 100% { transform: translateX(0px) translateY(0px); }
            50% { transform: translateX(18px) translateY(-18px); }
        }

        /* ---------- Mobile ---------- */
        @media (max-width: 520px) {
            .hero {
                padding: 3.25rem 1.25rem 2.5rem;
            }

            .container {
                padding: 0 1.25rem;
            }

            .hero__subtitle {
                font-size: 1.05rem;
                margin-bottom: 1.75rem;
            }

            .hero__actions {
                margin-bottom: 1.75rem;
                gap: 0.75rem;
            }

            .newsletter {
                padding: 2.75rem 0;
            }

            .card {
                padding: 1.5rem;
            }

            .card__title {
                font-size: 1.5rem;
            }

            .card__subtitle {
                font-size: 1rem;
                margin-bottom: 1.4rem;
            }

            .form {
                flex-direction: column;
                gap: 0.75rem;
                align-items: stretch;
            }

            .input {
                width: 100%;
                min-width: 0;
                max-width: none;
                height: 62px;           /* still big on mobile */
            }

            .form .btn {
                width: 100%;
                height: 52px;           /* slightly larger tap target */
            }

            .footer {
                padding: 1.5rem 1.25rem;
                flex-direction: column;
                gap: 0.75rem;
            }
        }
    </style>
</Layout>