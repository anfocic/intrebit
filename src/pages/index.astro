---
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/shared/SocialIcon.astro";
import {pageSEO} from "../config/seo.pages.ts";
---

<Layout seo={pageSEO.comingSoon} showHeader={false} showFooter={false}>
    <main class="coming">
        <!-- Hero -->
        <section class="hero" aria-label="Coming soon hero">
            <!-- Background blobs -->
            <div class="blob blob--1" data-blob></div>
            <div class="blob blob--2" data-blob></div>
            <div class="blob blob--3" data-blob></div>

            <div class="hero__inner">
                <header class="hero__header">
                    <h1 class="hero__title">intrebit</h1>
                    <p class="hero__subtitle">
                        <strong>Software, built properly.</strong><br/>
                        <span class="hero__subtitle--soft">No buzzwords. No nonsense.</span>
                    </p>
                </header>

                <p class="hero__availability">
                    Open for new work.
                </p>

                <div class="hero__actions">
                    <a class="btn btn--primary" href="#contact">
                        Get in touch
                    </a>
                    <a
                            class="btn btn--ghost"
                            href="https://www.linkedin.com/company/intrebit"
                            target="_blank"
                            rel="noopener noreferrer"
                    >
                        Follow us
                    </a>
                </div>

            </div>
        </section>
        <div class="scroll-cue" aria-hidden="true">
            <span></span>
        </div>
        <div class="section-divider"></div>
        <!-- About -->
        <section class="about" aria-label="About Intrebit">
            <div class="container about__inner">
                <header class="about__header">
                    <h2 class="about__title">What we do</h2>
                    <p class="about__subtitle">
                        Build it right. Keep it running.
                    </p>
                </header>

                <div class="about__grid" role="list">
                    <article class="about-card" role="listitem">
                        <h3 class="about-card__title">Development</h3>
                        <p class="about-card__text">
                            We ship it, deploy it, and keep it stable. You shouldn’t have to care about the rest.
                        </p>
                    </article>

                    <article class="about-card" role="listitem">
                        <h3 class="about-card__title">Consulting</h3>
                        <p class="about-card__text">
                            We look at what you’ve got, spot what’s broken, and give you a clear plan forward.
                        </p>
                    </article>

                    <article class="about-card" role="listitem">
                        <h3 class="about-card__title">Automation</h3>
                        <p class="about-card__text">
                            Less admin. More time. Happy days.
                        </p>
                    </article>
                </div>

            </div>
        </section>

        <!-- Contact -->
        <div class="section-divider"></div>

        <section id="contact" class="contact" aria-label="Contact form">
            <div class="container contact__inner">
                <div class="card">
                    <div class="card__header">
                        <h2 class="card__title">Let’s talk</h2>
                        <p class="card__subtitle">
                            The site’s still cooking, but we’re available.
                        </p>
                    </div>

                    <form class="form form--contact" id="contact-form">
                        <!-- Honeypot (spam trap) -->
                        <label class="honeypot" aria-hidden="true">
                            Do not fill
                            <input type="text" name="company" tabindex="-1" autocomplete="off"/>
                        </label>

                        <div class="form__row">
                            <input
                                    class="input"
                                    type="text"
                                    name="name"
                                    id="contact-name"
                                    placeholder="Your name (optional)"
                                    autocomplete="name"
                            />

                            <input
                                    class="input"
                                    type="email"
                                    name="email"
                                    id="contact-email"
                                    placeholder="your@email.com"
                                    required
                                    autocomplete="email"
                            />
                        </div>

                        <textarea
                                class="textarea"
                                name="message"
                                id="contact-message"
                                placeholder="What do you need help with?"
                                rows="4"
                                required
                        ></textarea>

                        <button class="btn btn--primary" type="submit">
                            Send
                        </button>
                    </form>

                    <p class="note">
                        Or email <span id="email-slot"></span>
                    </p>

                    <p class="note">
                        We’ll only use this to reply. No spam.
                    </p>

                    <p class="status" id="contact-status" aria-live="polite"></p>
                </div>
            </div>
        </section>
        <!-- Footer -->
        <footer class="footer">
            <p class="footer__text">
                © 2026 Intrebit. We're just millennials trying to not burn out.
            </p>
            <button class="theme-toggle" type="button" aria-label="Toggle theme">
                🌗
            </button>
            <div class="footer__social">
                <SocialIcon
                        icon="mastodon"
                        href="https://mastodon.social/@intrebit"
                        title="Mastodon"
                        rel="me noopener noreferrer"
                        className="footer__social-icon"
                />
                <SocialIcon
                        icon="linkedin"
                        href="https://www.linkedin.com/company/intrebit"
                        title="LinkedIn"
                        target="_blank"
                        rel="noopener noreferrer"
                        className="footer__social-icon"
                />
            </div>
        </footer>
    </main>

    <script is:inline src="/scripts/contact.js" defer/>
    <style>
        .coming {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--bg);
            color: var(--text);
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* ---------- Hero ---------- */
        .hero {
            position: relative;
            flex: 1;
            display: grid;
            place-items: center;
            overflow: hidden;
            padding: 8rem 2rem 6rem;
        }

        .hero__inner {
            text-align: center;
            max-width: 650px;
            position: relative;
            z-index: 2;
            animation: fadeUp 0.8s ease-out both;
        }

        .hero__title {
            font-family: var(--font-brand), serif;
            letter-spacing: 0.05em;
            font-size: clamp(2.5rem, 7vw, 4rem);
            font-weight: 750;
            margin: 0 0 0.6rem;
            color: var(--brand-navy);
        }

        .hero__subtitle {
            margin: 0 auto 2.25rem;
            font-size: 1.15rem;
            color: var(--text-muted);
            max-width: 560px;
            line-height: 1.6;
        }

        .hero__actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        /* ---------- Buttons (base) ---------- */
        .btn {
            height: 56px;                 /* match inputs */
            padding: 0 1.35rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;

            font-weight: 650;
            font-size: 1rem;
            letter-spacing: -0.01em;

            cursor: pointer;
            user-select: none;
            text-decoration: none;

            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: rgba(255, 255, 255, 0.92);

            transition:
                    transform 0.16s var(--ease),
                    background 0.16s var(--ease),
                    border-color 0.16s var(--ease),
                    box-shadow 0.16s var(--ease),
                    filter 0.16s var(--ease);
        }

        .btn:hover {
            transform: translateY(-1px);
            background: rgba(255, 255, 255, 0.10);
            border-color: rgba(255, 255, 255, 0.22);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
        }

        .btn:active {
            transform: translateY(0);
            filter: brightness(0.98);
        }

        /* keyboard accessibility */
        .btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 5px rgba(178, 223, 219, 0.18);
        }

        .btn--primary {
            background: rgba(255,255,255,0.10);
            border-color: rgba(255,255,255,0.22);
        }

        .btn--primary:hover {
            background: rgba(255,255,255,0.14);
            border-color: rgba(255,255,255,0.28);
        }

        .btn--ghost {
            background: rgba(255, 255, 255, 0.03);
            color: var(--text);
            border-color: rgba(255, 255, 255, 0.1);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }

        .btn--ghost:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.16);
        }

        /* Light theme: buttons should feel more “navy/ink” */
        :root[data-theme="light"] .btn--primary {
            background: var(--text);
            color: var(--bg);
            border-color: rgba(14, 42, 71, 0.22);
            box-shadow: 0 16px 44px rgba(14, 42, 71, 0.18);
        }

        :root[data-theme="light"] .btn--ghost {
            background: rgba(14, 42, 71, 0.04);
            border-color: rgba(14, 42, 71, 0.14);
            color: var(--text);
        }

        .section--glow {
            background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.05), transparent 55%);
        }

        /* ---------- Contact section ---------- */
        .contact {
            position: relative;
            padding: 5rem 0;
            background: transparent;
        }

        .section::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top, rgba(255,255,255,0.04), transparent 60%);
            pointer-events: none;
        }

        .contact__inner {
            display: flex;
            justify-content: center;
        }

        .hero__availability {
            margin: 0 0 1.2rem;
            font-size: 0.95rem;
            font-weight: 650;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            color: var(--text-muted);
            opacity: 0.9;
            padding: 2rem 0;
        }

        .hero__availability {
            color: var(--brand-ivory);
        }
        :root[data-theme="light"] .hero__availability {
            color: var(--brand-navy);
        }

        /* Contact form layout */
        .form--contact {
            display: grid;
            gap: 0.95rem;
            margin-top: 1.4rem;
        }

        .form__row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            width: 100%;
        }


        .textarea::placeholder {
            color: rgba(255, 255, 255, 0.45);
            font-weight: 500;
        }

        .input:focus,
        textarea:focus {
            border-color: rgba(178, 223, 219, 0.6);
            box-shadow: 0 0 0 6px rgba(178, 223, 219, 0.12);
        }

        /* Dark mode textarea */
        :root[data-theme="dark"] .textarea {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.14);
            color: rgba(246, 244, 239, 0.92);
        }

        /* Make the button full width */
        .form--contact .btn {
            width: 100%;
            height: 52px;
        }



        /* Mobile: stack inputs */
        @media (max-width: 520px) {
            .form__row {
                grid-template-columns: 1fr;
            }
        }

        /* Card */
        .card {
            width: 100%;
            max-width: 760px;
            border-radius: 18px;
            padding: 2.25rem;
            text-align: center;
            background: var(--surface);
            border: 1px solid var(--border);
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.06);
            backdrop-filter: blur(10px);
            color: var(--text);
        }

        :root[data-theme="dark"] .card {
            background: var(--surface);
            border: 1px solid var(--border);
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.06);
        }

        .card__title {
            margin: 0 0 0.6rem;
            font-size: 1.85rem;
            letter-spacing: -0.03em;
            color: var(--text);
        }

        .card__subtitle {
            margin: 0 auto 3rem;
            max-width: 560px;
            line-height: 1.6;
            color: var(--text-muted);
        }

        .section::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top, rgba(255,255,255,0.04), transparent 60%);
            pointer-events: none;
        }

        /* ---------- Form (BIGGER input, SMALLER button) ---------- */
        .form {
            display: flex;
            gap: 0.85rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            margin-top: 1.2rem;
        }

        .input,
        .textarea {
            width: 100%;
            border-radius: 16px;
            padding: 18px 20px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            background: rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.92);
            font-size: 1.05rem;
            line-height: 1.5;
        }

        /* input-specific height */
        .input {
            height: 58px;
        }

        .scroll-cue {
            margin-top: 3.2rem;
            display: flex;
            justify-content: center;
            opacity: 0.55;
        }
        .scroll-cue span {
            width: 52px;
            height: 1px;
            background: rgba(255,255,255,0.14);
            border-radius: 999px;
        }

        /* textarea-specific height */
        .textarea {
            min-height: 180px;
            resize: none;
        }
        .input::placeholder,
        .textarea::placeholder {
            color: rgba(255,255,255,0.45);
            font-weight: 500;
        }

        /* Dark mode input: deep glass */
        :root[data-theme="dark"] .input {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.14);
            color: rgba(246, 244, 239, 0.92);
        }

        :root[data-theme="dark"] .input::placeholder {
            color: rgba(246, 244, 239, 0.55);
        }

        /* ---------------------------------------
   Light theme: form fields should be visible
---------------------------------------- */
        :root[data-theme="light"] .input,
        :root[data-theme="light"] .textarea {
            background: rgba(255, 255, 255, 0.9);
            border-color: rgba(14, 42, 71, 0.16);
            color: rgba(14, 42, 71, 0.95);
        }

        :root[data-theme="light"] .input::placeholder,
        :root[data-theme="light"] .textarea::placeholder {
            color: rgba(14, 42, 71, 0.45);
        }

        :root[data-theme="light"] .input:focus,
        :root[data-theme="light"] .textarea:focus {
            border-color: rgba(14, 42, 71, 0.35);
            box-shadow: 0 0 0 6px rgba(14, 42, 71, 0.08);
        }

        .input:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--text-muted) 55%, transparent);
            box-shadow: 0 0 0 6px color-mix(in srgb, var(--text-muted) 18%, transparent);
        }

        /* Newsletter submit button: smaller + tighter */
        .form .btn {
            height: 48px; /* ⬅️ smaller */
            padding: 0 1.1rem; /* ⬅️ smaller */
            font-size: 1rem;
            min-width: 140px;
        }

        /* ---------- Note + Status ---------- */
        .note {
            margin: 1.1rem 0 0;
            font-size: 0.95rem;
            color: var(--text-muted);
            opacity: 0.92;
        }

        .status {
            display: none;
            margin-top: 1.2rem;
            padding: 0.9rem 1.2rem;
            border-radius: 14px;
            font-size: 0.95rem;
            font-weight: 600;
            line-height: 1.4;
            text-align: center;
            border: 1px solid transparent;
            background: transparent;
            color: rgba(255, 255, 255, 0.86);
            opacity: 0;
            transform: translateY(4px);
            transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
        }

        .status:not(:empty) {
            opacity: 1;
            transform: translateY(0);
        }

        .status--success {
            background: rgba(34, 197, 94, 0.14);
            border-color: rgba(34, 197, 94, 0.35);
            color: rgba(220, 252, 231, 0.95);
        }

        .status--error {
            background: rgba(239, 68, 68, 0.14);
            border-color: rgba(239, 68, 68, 0.35);
            color: rgba(254, 226, 226, 0.95);
        }

        .status--info {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.82);
        }

        /* Light mode: status text should be ink */
        :root[data-theme="light"] .status {
            color: rgba(14, 42, 71, 0.82);
        }

        :root[data-theme="light"] .status--success {
            color: rgba(12, 74, 40, 0.95);
        }

        :root[data-theme="light"] .status--error {
            color: rgba(127, 29, 29, 0.95);
        }

        /* ---------- Honeypot ---------- */
        .honeypot {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
        }

        /* ---------- Footer ---------- */
        .footer {
            padding: 2rem;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between; /* ✅ spread text + icons */
            gap: 1rem;
            flex-wrap: wrap;
            background: transparent;
        }

        .footer__text {
            margin: 0;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-align: left; /* ✅ left on desktop */
        }

        .footer__social {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .footer__social-icon {
            width: 40px;
            height: 40px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.75);
            transition: transform 0.16s var(--ease), background 0.16s var(--ease),
            border-color 0.16s var(--ease), color 0.16s var(--ease);
        }

        .footer__social-icon:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.22);
            color: rgba(255, 255, 255, 1);
        }

        :root[data-theme="light"] .footer__social-icon {
            background: rgba(14, 42, 71, 0.05);
            border-color: rgba(14, 42, 71, 0.12);
            color: rgba(14, 42, 71, 0.75);
        }

        :root[data-theme="light"] .footer__social-icon:hover {
            background: rgba(14, 42, 71, 0.08);
            border-color: rgba(14, 42, 71, 0.2);
            color: rgba(14, 42, 71, 1);
        }

        /* ---------- Background blobs ---------- */
        .blob {
            position: absolute;
            border-radius: 999px;
            opacity: 0.05;
            pointer-events: none;
        }

        .blob--1,
        .blob--3 {
            background: var(--text-muted);
        }

        .blob--2 {
            background: color-mix(in srgb, var(--text-muted) 45%, white);
            opacity: 0.05;
        }

        .blob--1 {
            width: 320px;
            height: 320px;
            top: -110px;
            right: -90px;
            animation: float 6s ease-in-out infinite;
        }

        .blob--2 {
            width: 220px;
            height: 220px;
            bottom: -70px;
            left: -70px;
            animation: drift 8s ease-in-out infinite;
        }

        .blob--3 {
            width: 160px;
            height: 160px;
            top: 55%;
            left: 10%;
            animation: float 7s ease-in-out infinite;
        }

        /* ---------- Animations ---------- */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.15);
                opacity: 0.85;
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-18px);
            }
        }

        @keyframes drift {
            0%, 100% {
                transform: translateX(0px) translateY(0px);
            }
            50% {
                transform: translateX(18px) translateY(-18px);
            }
        }

        /* ---------- Mobile ---------- */
        @media (max-width: 520px) {
            .hero {
                padding: 3.25rem 1.25rem 2.5rem;
            }

            .container {
                padding: 0 1.25rem;
            }

            .hero__subtitle {
                font-size: 1.05rem;
                margin-bottom: 1.75rem;
            }

            .hero__actions {
                margin-bottom: 1.75rem;
                gap: 0.75rem;
            }

            .footer {
                padding: 1.5rem 1.25rem;
                flex-direction: column;
                gap: 0.75rem;
                justify-content: center;
                align-items: center;
            }

            .footer__text {
                text-align: center; /* ✅ center on mobile */
            }

            .newsletter {
                padding: 2.75rem 0;
            }

            .card {
                padding: 1.5rem;
            }

            .card__title {
                font-size: 1.5rem;
            }

            .card__subtitle {
                font-size: 1rem;
                margin-bottom: 1.4rem;
            }

            .form {
                flex-direction: column;
                gap: 0.75rem;
                align-items: stretch;
            }

            .input {
                width: 100%;
                min-width: 0;
                max-width: none;
                height: 62px; /* still big on mobile */
            }

            .form .btn {
                width: 100%;
                height: 52px; /* slightly larger tap target */
            }

            .footer {
                padding: 1.5rem 1.25rem;
                flex-direction: column;
                gap: 0.75rem;
            }
        }

        /* ---------- About ---------- */
        .about {
            padding: 6rem 0 5rem;
            position: relative;
        }

        .about__inner {
            text-align: center;
        }

        .about__header {
            max-width: 720px;
            margin: 0 auto 2.5rem;
            animation: fadeUp 0.8s ease-out both;
        }

        .about__title {
            margin: 0 0 0.8rem;
            font-size: clamp(1.85rem, 4vw, 2.4rem);
            letter-spacing: -0.03em;
            color: var(--text);
            font-weight: 750;
        }

        .about__subtitle {
            margin: 0 auto;
            max-width: 640px;
            line-height: 1.65;
            color: var(--text-muted);
            font-size: 1.08rem;
        }

        .about__grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
            max-width: 920px;
            margin: 0 auto;
            justify-content: center;

        }

        .about-card {
            border-radius: 18px;
            padding: 1.5rem 1.6rem;
            background: var(--surface);
            border: 1px solid var(--border);
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.06);
            text-align: left;
            transition: transform 0.18s var(--ease),
            box-shadow 0.18s var(--ease),
            border-color 0.18s var(--ease);
        }

        .about-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 26px 80px rgba(0, 0, 0, 0.12);
        }

        /* Desktop upgrade only */
        @media (min-width: 1024px) {
            .about__grid {
                grid-template-columns: repeat(3, minmax(280px, 1fr));
                gap: 1.6rem;
                max-width: 1080px;
            }

            .about-card {
                padding: 1.8rem 2rem;
                border-radius: 20px;
            }
        }

        :root[data-theme="dark"] .about-card {
            box-shadow: 0 22px 60px rgba(0, 0, 0, 0.25);
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.12);
        }

        .about-card:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--text-muted) 28%, var(--border));
