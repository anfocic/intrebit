---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Coming Soon">
    <main style="min-height: 100vh; display: flex; flex-direction: column; background-color: var(--color-bg-main);">
        {/* Hero Section */}
        <section style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; position: relative; overflow: hidden;">
            {/* Animated background elements */}
            <div class="bg-element bg-element-1"></div>
            <div class="bg-element bg-element-2"></div>
            <div class="bg-element bg-element-3"></div>

            <div style="text-align: center; max-width: 600px; margin: 0 auto; position: relative; z-index: 1;">
                {/* Coming Soon Badge */}


                {/* Logo/Brand */}
                <div style="margin-bottom: 2rem; animation: fadeInUp 0.8s ease-out 0.2s both;">
                    <h1 style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 700;">
                        <span style="color: var(--color-text-main);">Intrebit</span>
                    </h1>
                    <p style="color: var(--color-text-light); font-size: 1.2rem; font-weight: 500;">                        No buzzwords. No junk. Just solid tools that work.
                    </p>
                </div>


                {/* CTA Buttons */}
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; animation: fadeInUp 0.8s ease-out 0.6s both;">
                    <a href="mailto:hello@intrebit.com">
                        <button class="scandi-btn scandi-btn-primary">
                            Get in touch
                        </button>
                    </a>
                    <a href="https://linkedin.com" target="_blank">
                        <button class="scandi-btn scandi-btn-outline">
                            Follow us
                        </button>
                    </a>
                </div>

                <div class="launch-badge">
                    <span class="launch-dot"></span>
                    <span class="launch-text">Launching in Q1 2026</span>
                </div>
            </div>
        </section>

        <section class="newsletter">
            <div class="container" style="max-width: 700px;">
                <div class="newsletter-card">
                    <div class="newsletter-header">
                        <h2 class="newsletter-title">Stay in the loop</h2>
                        <p class="newsletter-subtitle">
                            Get notified when we launch. No spam, no corporate emails. Just real updates.
                        </p>
                    </div>

                    <form class="newsletter-form">
                        <input
                                type="email"
                                placeholder="your@email.com"
                                required
                                class="newsletter-input"
                        />
                        <button type="submit" class="scandi-btn scandi-btn-primary newsletter-btn">
                            Notify me
                        </button>
                    </form>

                    <p class="newsletter-note">One email when we launch. That’s it.</p>
                </div>
            </div>
        </section>
        <footer
                style="padding: 2rem; border-top: 1px solid rgba(0,0,0,0.05); width: 100%; display: flex; justify-content: center;"
        >
            <p style="margin: 0; text-align: center; color: var(--color-text-light); font-size: 0.85rem;">
                © 2026 Intrebit. We're just millennials trying to not burn out.
            </p>
        </footer>
    </main>



    <style>

        .launch-badge{
            display:inline-flex;
            align-items:center;
            gap:.55rem;
            padding:.7rem 1.1rem;
            border-radius:999px;
            border:1px solid rgba(178,223,219,.55);
            background: linear-gradient(
                    135deg,
                    rgba(178,223,219,.35),
                    rgba(178,223,219,.10)
            );
            box-shadow: 0 12px 30px rgba(0,0,0,.06);
            backdrop-filter: blur(8px);
            animation: fadeInDown 0.8s ease-out;
        }

        .launch-dot{
            width:10px;
            height:10px;
            border-radius:999px;
            background: var(--color-accent-primary);
            box-shadow: 0 0 0 6px rgba(178,223,219,.20);
            animation: pulse 1.6s ease-in-out infinite;
        }

        .launch-text{
            font-size:.82rem;
            font-weight:700;
            color: var(--color-text-main);
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }

        @keyframes pulse{
            0%,100%{ transform: scale(1); opacity:1; }
            50%{ transform: scale(1.15); opacity:.85; }
        }

        .newsletter{
            padding: 3.5rem 2rem;
            background: rgba(178,223,219,0.08);
            border-top: 1px solid rgba(178,223,219,0.25);
        }

        .newsletter-card{
            text-align:center;
            padding: 2.25rem;
            border-radius: 18px;
            border: 1px solid rgba(178,223,219,0.35);
            background: rgba(255,255,255,0.65);
            box-shadow: 0 18px 55px rgba(0,0,0,0.06);
            backdrop-filter: blur(10px);
        }

        .newsletter-title{
            font-size: 1.85rem;
            margin: 0 0 .6rem 0;
            color: var(--color-text-main);
            letter-spacing: -0.02em;
        }

        .newsletter-subtitle{
            margin: 0 auto 1.6rem;
            color: var(--color-text-light);
            white-space: nowrap;
            max-width: none;
            width: max-content;
            padding-bottom: 0.4rem;
        }

        .newsletter-form{
            display:flex;
            gap:.6rem;
            justify-content:center;
            flex-wrap:wrap;
        }

        .newsletter-input{
            flex: 1;
            min-width: 240px;
            padding: .85rem 1rem;
            border: 1px solid var(--color-border-scandi);
            border-radius: var(--radius-soft);
            font-family: var(--font-sans);
            font-size: 1rem;
            background: rgba(255,255,255,0.9);
            transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
        }

        .newsletter-input:focus{
            outline:none;
            border-color: rgba(178,223,219,0.9);
            box-shadow: 0 0 0 6px rgba(178,223,219,0.18);
            transform: translateY(-1px);
        }

        .newsletter-btn{
            padding-left: 1.25rem;
            padding-right: 1.25rem;
        }

        .newsletter-note{
            margin: 1.1rem 0 0;
            font-size: .9rem;
            color: var(--color-text-light);
            opacity: .9;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        @keyframes drift {
            0%, 100% {
                transform: translateX(0px) translateY(0px);
            }
            50% {
                transform: translateX(20px) translateY(-20px);
            }
        }

        .bg-element {
            position: absolute;
            border-radius: 50%;
            opacity: 0.05;
            pointer-events: none;
        }

        .bg-element-1 {
            width: 300px;
            height: 300px;
            background-color: var(--color-accent-primary);
            top: -100px;
            right: -100px;
            animation: float 6s ease-in-out infinite;
        }

        .bg-element-2 {
            width: 200px;
            height: 200px;
            background-color: var(--color-accent-secondary);
            bottom: -50px;
            left: -50px;
            animation: drift 8s ease-in-out infinite;
        }

        .bg-element-3 {
            width: 150px;
            height: 150px;
            background-color: var(--color-accent-primary);
            top: 50%;
            left: 10%;
            animation: float 7s ease-in-out infinite;
        }

        .text-serif {
            font-family: var(--font-serif);
            font-style: italic;
        }


        @media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }

            h2 {
                font-size: 1.75rem;
            }

            .bg-element-1 {
                width: 200px;
                height: 200px;
            }

            .bg-element-2 {
                width: 150px;
                height: 150px;
            }

            .service-card {
                padding: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 2rem;
            }

            h2 {
                font-size: 1.5rem;
            }

            form {
                flex-direction: column;
            }

            input, button {
                width: 100%;
            }

            .bg-element {
                opacity: 0.02;
            }
        }
    </style>
</Layout>
