        /* =========================================================
   QUICK FIX PACK — light/dark form + buttons + divider
   Drop into this page <style>.
   Remove duplicates tomorrow.
   ========================================================= */

        /* ---- Accent fallback (so focus rings work even if not defined) ---- */
        :root {
            --accent: var(--text);
            --accent-soft: rgba(14, 42, 71, 0.14);
        }
        :root[data-theme="dark"] {
            --accent: rgba(178, 223, 219, 1);
            --accent-soft: rgba(178, 223, 219, 0.22);
        }

        /* =========================================================
           Divider (works on both themes)
           ========================================================= */
        .section-divider {
            width: 80px;
            height: 1px;
            margin: 0 auto;
            background: color-mix(in srgb, var(--border) 90%, transparent);
            border-radius: 999px;
            opacity: 0.9;
        }

        /* =========================================================
           Buttons (theme-aware)
           ========================================================= */
        .btn {
            height: 56px;
            padding: 0 1.35rem;
            border-radius: 999px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            font-weight: 650;
            font-size: 1rem;
            letter-spacing: -0.01em;

            cursor: pointer;
            user-select: none;
            text-decoration: none;

            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text);

            transition:
                    transform 0.16s var(--ease),
                    background 0.16s var(--ease),
                    border-color 0.16s var(--ease),
                    box-shadow 0.16s var(--ease),
                    filter 0.16s var(--ease);
        }

        .btn:hover {
            transform: translateY(-1px);
            background: var(--surface-strong);
            border-color: color-mix(in srgb, var(--border) 70%, var(--text) 18%);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
        }

        .btn:active {
            transform: translateY(0);
            filter: brightness(0.98);
        }

        .btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 6px var(--accent-soft);
        }

        /* Primary button = solid ink */
        .btn--primary {
            background: var(--text);
            color: var(--bg);
            border-color: transparent;
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
        }

        :root[data-theme="dark"] .btn--primary {
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
        }

        .btn--primary:hover {
            filter: brightness(1.05);
        }

        /* Ghost button = subtle surface */
        .btn--ghost {
            background: var(--surface);
            color: var(--text);
            border-color: var(--border);
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text) 6%, transparent);
        }

        .btn--ghost:hover {
            background: var(--surface-strong);
            border-color: color-mix(in srgb, var(--border) 70%, var(--text) 18%);
        }

        /* =========================================================
           Forms (inputs + textarea visible in light & dark)
           ========================================================= */
        .input,
        .textarea {
            width: 100%;
            border-radius: 16px;
            padding: 18px 20px;

            border: 1px solid var(--border);
            background: var(--surface-strong);
            color: var(--text);

            font-size: 1.05rem;
            line-height: 1.5;

            transition:
                    border-color 0.16s var(--ease),
                    box-shadow 0.16s var(--ease),
                    background 0.16s var(--ease);
        }

        /* input height so it matches your buttons */
        .input {
            height: 58px;
        }

        /* textarea height */
        .textarea {
            min-height: 180px;
            resize: none;
        }

        .input::placeholder,
        .textarea::placeholder {
            color: color-mix(in srgb, var(--text-muted) 85%, transparent);
            font-weight: 500;
        }

        /* focus ring */
        .input:focus,
        .textarea:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
            box-shadow: 0 0 0 6px var(--accent-soft);
        }

        /* =========================================================
           Contact form layout only (keeps your structure)
           ========================================================= */
        .form--contact {
            display: grid;
            gap: 0.95rem;
            margin-top: 1.4rem;
        }

        .form__row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form--contact .btn {
            width: 100%;
            height: 56px;
        }

        /* mobile: stack inputs */
        @media (max-width: 520px) {
            .form__row {
                grid-template-columns: 1fr;
            }
        }

        /* =========================================================
           Cards (make sure both cards match in both themes)
           ========================================================= */
        .card,
        .about-card {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text);
        }

        .card {
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.06);
        }

        :root[data-theme="dark"] .card {
            box-shadow: 0 22px 60px rgba(0, 0, 0, 0.25);
        }

        .about-card:hover {
            border-color: color-mix(in srgb, var(--accent) 28%, var(--border));
        }

        .hero__title {
            color: var(--text) !important;
        }

        .hero__subtitle,
        .hero__subtitle strong,
        .hero__subtitle--soft {
            color: var(--text-muted) !important;
        }
    </style>
