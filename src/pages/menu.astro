---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/shared/CTASection.astro";
import {pageSEO} from "../config/seo.pages.ts";
---

<Layout seo={pageSEO.menu}>
    <main>
        <section class="section">
            <div class="container menu">
                <header class="menu__header">
                    <h1>We're not a restaurant.</h1>
                    <p class="menu__subtitle">
                        But if you're looking for pricing, here's the real talk:
                    </p>
                </header>

                <div class="menu__stack">
                    <article class="card menu-card">
                        <h3>How pricing works</h3>
                        <p>
                            We don't have a menu with fixed prices. Every project is different, and we price accordingly.
                        </p>

                        <p><strong>Here's what we do:</strong></p>

                        <ol class="menu-list">
                            <li>You tell us what you need</li>
                            <li>We understand your problem and constraints</li>
                            <li>We give you a transparent quote</li>
                            <li>No hidden fees, no surprise invoices</li>
                        </ol>
                    </article>

                    <article class="card menu-card">
                        <h3>What affects the cost</h3>
                        <ul class="menu-list">
                            <li><strong>Scope:</strong> How big is the project? What features?</li>
                            <li><strong>Timeline:</strong> How fast do you need it?</li>
                            <li><strong>Complexity:</strong> How complex is the tech?</li>
                            <li><strong>Team size:</strong> How many people do you need?</li>
                            <li><strong>Maintenance:</strong> Do you need ongoing support?</li>
                        </ul>
                    </article>

                    <article class="card menu-card">
                        <h3>What we're not</h3>

                        <div class="menu-bullets">
                            <p><strong>❌ The cheapest option</strong> — We're not racing to the bottom. You get quality work.</p>
                            <p><strong>❌ Overpriced</strong> — We're fair. We don't charge for meetings about meetings.</p>
                            <p><strong>❌ A fixed-price trap</strong> — We don't lock you into a price and then ask for change orders every week.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <CTASection
                heading="Ready to talk about your project?"
                subtitle="We'll give you a clear quote, a realistic timeline, and no weird surprises."
                buttonLabel="Get a quote"
                buttonHref="/contact"
        />
    </main>

    <style>
        .section {
            padding: 5.5rem 0 3rem;
        }

        .menu {
            max-width: 860px;
        }

        .menu__header {
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .menu__subtitle {
            margin: 1.25rem auto 0;
            font-size: 1.2rem;
            color: var(--text-muted);
            max-width: 620px;
            line-height: 1.6;
        }

        .menu__stack {
            display: grid;
            gap: 2rem;
        }

        .menu-card {
            padding: 2.25rem;
        }

        .menu-card h3 {
            margin-bottom: 1.25rem;
        }

        .menu-card p {
            margin: 0 0 1.25rem;
            color: var(--text-muted);
            line-height: 1.75;
            font-size: 1.05rem;
        }

        .menu-card p strong {
            color: var(--text);
        }

        .menu-list {
            margin: 1rem 0 0;
            padding-left: 1.25rem;
            display: grid;
            gap: 0.85rem;
            color: var(--text-muted);
            line-height: 1.7;
            font-size: 1.05rem;
        }

        .menu-list li strong {
            color: var(--text);
        }

        /* Make ordered list numbers look crisp */
        ol.menu-list {
            padding-left: 1.35rem;
        }

        .menu-bullets p {
            margin: 0 0 1rem;
        }

        .menu-bullets p:last-child {
            margin-bottom: 0;
        }

        @media (max-width: 768px) {
            .section {
                padding: 4rem 0 2rem;
            }

            .menu-card {
                padding: 2rem;
            }
        }
    </style>
</Layout>