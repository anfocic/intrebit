---
import Layout from "../layouts/Layout.astro";
---

<Layout title="intrebit — sign in" seo={{robots: "noindex, nofollow"}}>
    <section class="login">
        <form class="login__form" id="login-form" novalidate>
            <h1 class="login__title">sign in</h1>
            <label class="login__field">
                <span class="login__label">username</span>
                <input
                    type="text"
                    name="username"
                    autocomplete="username"
                    autocapitalize="none"
                    autocorrect="off"
                    spellcheck="false"
                    required
                />
            </label>
            <label class="login__field">
                <span class="login__label">password</span>
                <input
                    type="password"
                    name="password"
                    autocomplete="current-password"
                    required
                />
            </label>
            <p class="login__error" data-error hidden>invalid credentials</p>
            <button type="submit" class="login__submit">sign in</button>
        </form>
    </section>
</Layout>

<style is:global>
    .login {
        max-width: 360px;
        margin: 0 auto;
        padding: var(--page-pad-top) var(--page-pad-x) var(--page-pad-bottom);
    }
    .login__form {
        display: grid;
        gap: var(--s-4);
    }
    .login__title {
        font-size: var(--text-2xl);
        margin: 0 0 var(--s-2);
        letter-spacing: -0.02em;
    }
    .login__field {
        display: grid;
        gap: var(--s-2);
    }
    .login__label {
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--ink-3);
        font-weight: 600;
    }
    .login__field input {
        font: inherit;
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--rule-2);
        border-radius: 6px;
        background: var(--bg);
        color: var(--ink);
    }
    .login__field input:focus {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
    }
    .login__error {
        margin: 0;
        color: #c92a2a;
        font-size: var(--text-sm);
    }
    .login__submit {
        margin-top: var(--s-2);
        background: var(--ink);
        color: var(--bg);
        border: 0;
        padding: 0.7rem 1rem;
        border-radius: 6px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }
    .login__submit[disabled] {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<script src="/scripts/login.js" defer></script>
