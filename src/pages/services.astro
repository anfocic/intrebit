---
import Layout from "../layouts/Layout.astro";
import { pageSEO } from "../config/seo.pages.ts";
import ServicesCTA from "../components/services/ServicesCTA.astro";
import ServicesGrid from "../components/services/ServicesGrid.astro";
import ServicesHero from "../components/services/ServicesHero.astro";
import HowWeWork from "../components/services/HowWeWork.astro";
import SectionDivider from "../components/shared/SectionDivider.astro";
---

<Layout seo={pageSEO.services}>
    <main class="services">
        <ServicesHero />

        <SectionDivider />

        <ServicesGrid />

        <SectionDivider/>

        <HowWeWork />

        <SectionDivider/>

        <ServicesCTA />
    </main>

</Layout>

