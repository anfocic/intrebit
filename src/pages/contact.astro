---
import Layout from "../layouts/Layout.astro";
import {pageSEO} from "../config/seo.ts";
import {contactSchemas} from "../config/schema.ts";

import ContactHero from "../components/contact/ContactHero.astro";
import ContactForm from "../components/contact/ContactForm.astro";
---

<Layout seo={pageSEO.contact} schemas={contactSchemas}>
    <div class="contact-split">
        <ContactHero/>
        <ContactForm/>
    </div>
</Layout>

<style is:global>
    @media (min-width: 901px) {
        .contact-split {
            max-width: var(--container-width);
            margin: 0 auto;
            padding: 64px var(--section-pad-x) 80px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: start;
        }

        .contact-split .chero,
        .contact-split .cform {
            padding: 0;
        }

        .contact-split .chero__inner,
        .contact-split .cform__inner {
            max-width: none;
        }
    }
</style>
