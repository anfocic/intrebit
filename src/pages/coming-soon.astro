---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Coming Soon">
  <main style="min-height: 100vh; display: flex; flex-direction: column; background-color: var(--color-bg-main);">
    {/* Hero Section */}
    <section style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; position: relative; overflow: hidden;">
      {/* Animated background elements */}
      <div class="bg-element bg-element-1"></div>
      <div class="bg-element bg-element-2"></div>
      <div class="bg-element bg-element-3"></div>

      <div style="text-align: center; max-width: 600px; margin: 0 auto; position: relative; z-index: 1;">
        {/* Coming Soon Badge */}
        <div style="display: inline-block; padding: 0.5rem 1rem; background-color: rgba(178, 223, 219, 0.2); border: 1px solid rgba(178, 223, 219, 0.4); border-radius: 20px; margin-bottom: 2rem; animation: fadeInDown 0.8s ease-out;">
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-accent-primary); text-transform: uppercase; letter-spacing: 1px;">Coming Soon</span>
        </div>

        {/* Logo/Brand */}
        <div style="margin-bottom: 2rem; animation: fadeInUp 0.8s ease-out 0.2s both;">
          <h1 style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 700;">
            <span style="color: var(--color-text-main);">Intrebit</span>
          </h1>
          <p style="color: var(--color-text-light); font-size: 1.2rem; font-weight: 500;">Software that doesn't suck</p>
        </div>

        {/* Main Message */}
        <div style="margin-bottom: 3rem; animation: fadeInUp 0.8s ease-out 0.4s both;">
          <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--color-text-main); line-height: 1.3;">
            We're building something <span class="text-serif" style="color: var(--color-accent-primary);">better</span>
          </h2>
          <p style="font-size: 1.1rem; color: var(--color-text-light); line-height: 1.8; margin-bottom: 1.5rem;">
            No corporate BS, no bloatware—just clean, efficient software solutions that actually solve problems.
          </p>
          <p style="font-size: 1rem; color: var(--color-text-light);">
            We're working on something we're proud of. It'll be ready soon.
          </p>
        </div>

        {/* CTA Buttons */}
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; animation: fadeInUp 0.8s ease-out 0.6s both;">
          <a href="mailto:hello@intrebit.com">
            <button class="scandi-btn scandi-btn-primary">
              Get in touch
            </button>
          </a>
          <a href="https://linkedin.com" target="_blank">
            <button class="scandi-btn scandi-btn-outline">
              Follow us
            </button>
          </a>
        </div>

        {/* Launch Date */}
        <div style="color: var(--color-text-light); font-size: 0.95rem; animation: fadeInUp 0.8s ease-out 0.8s both;">
          <p style="font-weight: 500;">Launching Q1 2026</p>
        </div>
      </div>
    </section>

    {/* What We're Building Section */}
    <section style="padding: 4rem 2rem; background-color: rgba(178, 223, 219, 0.05); border-top: 1px solid rgba(178, 223, 219, 0.2);">
      <div class="container" style="max-width: 1000px;">
        <div style="text-align: center; margin-bottom: 3rem;">
          <h2 style="font-size: 2rem; margin-bottom: 1rem; color: var(--color-text-main);">What we're building</h2>
          <p style="font-size: 1.1rem; color: var(--color-text-light); max-width: 600px; margin: 0 auto;">
            A complete software solution for companies tired of enterprise bloatware and consultants who don't deliver.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
          {/* Service 1 */}
          <div class="service-card">
            <div class="service-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7L2 17C2 20.866 7.373 23 12 23C16.627 23 22 20.866 22 17V7L12 2Z"></path>
                <path d="M12 12V23"></path>
                <path d="M2 7L12 12L22 7"></path>
              </svg>
            </div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.75rem; color: var(--color-text-main);">Custom Software</h3>
            <p style="color: var(--color-text-light); font-size: 0.95rem; line-height: 1.6;">
              Built from scratch for your specific needs. Not a template. Not a framework. Your solution.
            </p>
          </div>

          {/* Service 2 */}
          <div class="service-card">
            <div class="service-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="1"></circle>
                <path d="M12 1V3M12 21V23M4.22 4.22L5.64 5.64M18.36 18.36L19.78 19.78M1 12H3M21 12H23M4.22 19.78L5.64 18.36M18.36 5.64L19.78 4.22"></path>
              </svg>
            </div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.75rem; color: var(--color-text-main);">Outsourcing</h3>
            <p style="color: var(--color-text-light); font-size: 0.95rem; line-height: 1.6;">
              Need a team? We'll scale with you. Developers, designers, strategists—all vetted and ready.
            </p>
          </div>

          {/* Service 3 */}
          <div class="service-card">
            <div class="service-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12H21M3 6H21M3 18H21"></path>
                <rect x="3" y="2" width="18" height="20" rx="2"></rect>
              </svg>
            </div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.75rem; color: var(--color-text-main);">Infrastructure</h3>
            <p style="color: var(--color-text-light); font-size: 0.95rem; line-height: 1.6;">
              Cloud, servers, databases, DevOps. We handle the boring stuff so you can focus on your product.
            </p>
          </div>

          {/* Service 4 */}
          <div class="service-card">
            <div class="service-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"></path>
              </svg>
            </div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.75rem; color: var(--color-text-main);">Consulting</h3>
            <p style="color: var(--color-text-light); font-size: 0.95rem; line-height: 1.6;">
              Need advice? We'll tell you what we actually think, not what you want to hear.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Why Us Section */}
    <section style="padding: 4rem 2rem;">
      <div class="container" style="max-width: 800px;">
        <div style="text-align: center; margin-bottom: 3rem;">
          <h2 style="font-size: 2rem; margin-bottom: 1rem; color: var(--color-text-main);">Why us?</h2>
        </div>

        <div style="display: grid; gap: 1.5rem;">
          <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 24px; height: 24px; background-color: var(--color-accent-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 0.25rem;">
              <span style="color: white; font-weight: bold; font-size: 0.85rem;">✓</span>
            </div>
            <div>
              <h3 style="font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text-main);">We actually listen</h3>
              <p style="color: var(--color-text-light);">Not a 500-person agency with 10 account managers. Just people who care about your success.</p>
            </div>
          </div>

          <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 24px; height: 24px; background-color: var(--color-accent-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 0.25rem;">
              <span style="color: white; font-weight: bold; font-size: 0.85rem;">✓</span>
            </div>
            <div>
              <h3 style="font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text-main);">No corporate BS</h3>
              <p style="color: var(--color-text-light);">No synergies, no "circle back on that," no meaningless meetings. Just honest work.</p>
            </div>
          </div>

          <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 24px; height: 24px; background-color: var(--color-accent-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 0.25rem;">
              <span style="color: white; font-weight: bold; font-size: 0.85rem;">✓</span>
            </div>
            <div>
              <h3 style="font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text-main);">We ship quality</h3>
              <p style="color: var(--color-text-light);">Code that's maintainable. Design that works. Products that scale. No shortcuts.</p>
            </div>
          </div>

          <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 24px; height: 24px; background-color: var(--color-accent-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 0.25rem;">
              <span style="color: white; font-weight: bold; font-size: 0.85rem;">✓</span>
            </div>
            <div>
              <h3 style="font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text-main);">We're here long-term</h3>
              <p style="color: var(--color-text-light);">We don't disappear after launch. We maintain, we support, we help you grow.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Newsletter Signup */}
    <section style="padding: 3rem 2rem; background-color: rgba(178, 223, 219, 0.1); border-top: 1px solid rgba(178, 223, 219, 0.2);">
      <div class="container" style="max-width: 500px;">
        <div style="text-align: center;">
          <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-text-main);">Stay in the loop</h2>
          <p style="color: var(--color-text-light); margin-bottom: 2rem;">
            Get notified when we launch. No spam, no corporate emails. Just real updates.
          </p>

          <form style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
            <input 
              type="email" 
              placeholder="your@email.com"
              required
              style="flex: 1; min-width: 200px; padding: 0.75rem; border: 1px solid var(--color-border-scandi); border-radius: var(--radius-soft); font-family: var(--font-sans); font-size: 1rem;"
            />
            <button type="submit" class="scandi-btn scandi-btn-primary">
              Notify me
            </button>
          </form>
        </div>
      </div>
    </section>

    {/* Footer */}
    <footer style="padding: 2rem; text-align: center; border-top: 1px solid rgba(0, 0, 0, 0.05);">
      <p style="color: var(--color-text-light); font-size: 0.9rem; margin-bottom: 1rem;">
        <a href="mailto:hello@intrebit.com" style="color: var(--color-accent-primary); text-decoration: none;">hello@intrebit.com</a>
      </p>
      <p style="color: var(--color-text-light); font-size: 0.85rem;">
        © 2025 Intrebit. We're just millennials trying to not burn out.
      </p>
    </footer>
  </main>

  <style>
    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    @keyframes drift {
      0%, 100% {
        transform: translateX(0px) translateY(0px);
      }
      50% {
        transform: translateX(20px) translateY(-20px);
      }
    }

    .bg-element {
      position: absolute;
      border-radius: 50%;
      opacity: 0.05;
      pointer-events: none;
    }

    .bg-element-1 {
      width: 300px;
      height: 300px;
      background-color: var(--color-accent-primary);
      top: -100px;
      right: -100px;
      animation: float 6s ease-in-out infinite;
    }

    .bg-element-2 {
      width: 200px;
      height: 200px;
      background-color: var(--color-accent-secondary);
      bottom: -50px;
      left: -50px;
      animation: drift 8s ease-in-out infinite;
    }

    .bg-element-3 {
      width: 150px;
      height: 150px;
      background-color: var(--color-accent-primary);
      top: 50%;
      left: 10%;
      animation: float 7s ease-in-out infinite;
    }

    .text-serif {
      font-family: var(--font-serif);
      font-style: italic;
    }

    .service-card {
      padding: 2rem;
      background-color: var(--color-surface);
      border-radius: var(--radius-soft);
      border: 1px solid rgba(178, 223, 219, 0.2);
      transition: var(--transition-smooth);
    }

    .service-card:hover {
      transform: translateY(-4px);
      border-color: var(--color-accent-primary);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
    }

    .service-icon {
      width: 60px;
      height: 60px;
      background-color: rgba(178, 223, 219, 0.1);
      border-radius: var(--radius-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-accent-primary);
      margin-bottom: 1.5rem;
      transition: var(--transition-smooth);
    }

    .service-card:hover .service-icon {
      background-color: rgba(178, 223, 219, 0.2);
      transform: scale(1.1);
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }

      h2 {
        font-size: 1.75rem;
      }

      .bg-element-1 {
        width: 200px;
        height: 200px;
      }

      .bg-element-2 {
        width: 150px;
        height: 150px;
      }

      .service-card {
        padding: 1.5rem;
      }
    }

    @media (max-width: 480px) {
      h1 {
        font-size: 2rem;
      }

      h2 {
        font-size: 1.5rem;
      }

      form {
        flex-direction: column;
      }

      input, button {
        width: 100%;
      }

      .bg-element {
        opacity: 0.02;
      }
    }
  </style>
</Layout>
