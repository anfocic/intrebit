---
interface FAQItem {
    question: string;
    answer: string; // can include safe HTML like links
}

interface Props {
    title?: string;
    subtitle?: string;
    items: FAQItem[];
}

const {
    title = "FAQ",
    subtitle = "Questions we get asked. Honest answers.",
    items,
} = Astro.props;
---

<section class="section" aria-label="Frequently asked questions">
    <div class="container">
        <header class="faq__header">
            <h2>{title}</h2>
            <p class="faq__subtitle">{subtitle}</p>
        </header>

        <div class="faq__list">
            {items.map((item) => (
                    <details class="faq__item">
                        <summary class="faq__summary">
                            <span class="faq__question">{item.question}</span>
                            <span class="faq__icon" aria-hidden="true">+</span>
                        </summary>

                        <div class="faq__content">
                            <p set:html={item.answer}/>
                        </div>
                    </details>
            ))}
        </div>
    </div>
</section>

<style>
    .section {
        padding: 5.5rem 0;
    }

    .faq__header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .faq__subtitle {
        margin-top: 1rem;
        font-size: 1.05rem;
        color: var(--text-muted);
        max-width: 620px;
        margin-left: auto;
        margin-right: auto;
    }

    .faq__list {
        max-width: 820px;
        margin: 0 auto;
        display: grid;
        gap: 1.25rem;
    }

    .faq__item {
        border: 1px solid var(--border);
        border-radius: var(--radius-soft);
        background: var(--surface);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
        transition: transform 0.18s var(--ease), border-color 0.18s var(--ease);
    }

    .faq__item:hover {
        transform: translateY(-2px);
        border-color: rgba(178, 223, 219, 0.35);
    }

    .faq__summary {
        cursor: pointer;
        list-style: none;
        padding: 1.4rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        user-select: none;
    }

    /* Remove default triangle marker */
    .faq__summary::-webkit-details-marker {
        display: none;
    }

    .faq__question {
        font-weight: 650;
        font-size: 1.05rem;
        color: var(--text);
        line-height: 1.35;
    }

    .faq__icon {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        background: rgba(178, 223, 219, 0.12);
        border: 1px solid rgba(178, 223, 219, 0.25);
        font-size: 1.2rem;
        transition: transform 0.2s var(--ease), background 0.2s var(--ease);
    }

    details[open] .faq__icon {
        transform: rotate(45deg);
        background: rgba(178, 223, 219, 0.18);
    }

    .faq__content {
        padding: 0 1.5rem 1.5rem;
    }

    .faq__content p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.75;
    }

    /* Style links inside answers */
    .faq__content :global(a) {
        color: var(--accent);
        font-weight: 650;
        text-decoration: none;
    }

    .faq__content :global(a:hover) {
        text-decoration: underline;
    }

    /* Focus visible (keyboard navigation) */
    .faq__summary:focus-visible {
        outline: 3px solid rgba(178, 223, 219, 0.35);
        outline-offset: 2px;
    }

    @media (max-width: 768px) {
        .section {
            padding: 4rem 0;
        }

        .faq__summary {
            padding: 1.2rem 1.25rem;
        }

        .faq__content {
            padding: 0 1.25rem 1.25rem;
        }
    }
</style>

<script is:inline>
    document.querySelectorAll(".faq__item").forEach((detail) => {
        detail.addEventListener("toggle", () => {
            if (!detail.open) return;
            document.querySelectorAll(".faq__item").forEach((d) => {
                if (d !== detail) d.open = false;
            });
        });
    });
</script>