---
import {getPathname} from "../../utils/helpers.ts";
import {navLinks} from "../../config/navLinks.ts";
import Link from "../shared/Link.astro";
import MobileMenu from "../shared/MobileMenu.astro";
const pathname = getPathname(Astro.url);
---

<nav class="nav" aria-label="Primary navigation">
    <div class="nav__content">
        <a href="/" class="nav__logo" aria-label="intrebit home">intrebit</a>

        <!-- Desktop nav links -->
        <div class="nav__right nav__right--desktop">
            <ul class="nav__links">
                {navLinks.map(({ path, label }) => {
                    const isActive = path === "/" ? pathname === "/" : pathname.startsWith(path);
                    return (
                            <Link
                                    path={path}
                                    label={label}
                                    className={isActive ? "nav__link nav__link--active" : "nav__link"}
                            />
                    );
                })}
            </ul>
        </div>

        <!-- Right side: CTA + Hamburger -->
        <div class="nav__actions">
            <a class="nav__cta" href="#contact" aria-label="Get in touch">
                Talk to us <span aria-hidden="true">→</span>
            </a>

            <!-- Mobile hamburger -->
            <button
                    class="nav__hamburger"
                    data-mobile-open
                    aria-label="Open menu"
                    aria-expanded="false"
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
</nav>

<!-- MobileNav outside nav to avoid z-index issues -->
<MobileMenu />

<style>
    .nav__logo {
        text-decoration: none;
        font-family: var(--font-brand), serif;
        letter-spacing: 0.05em;
        font-weight: 750;
        margin: 0;
        font-size: 1.75rem;
        color: var(--text);
    }

    .nav {
        background-color: transparent;
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(12px);
    }

    .nav__content {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 1.25rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    .nav__right {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .nav__links {
        display: flex;
        gap: 1.75rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    :global(.nav__link) {
        color: var(--text-muted);
        font-weight: 600;
        font-size: var(--text-sm);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    :global(.nav__link:hover) {
        color: var(--text);
    }

    :global(.nav__link--active) {
        color: var(--text);
        position: relative;
    }

    :global(.nav__link--active::after) {
        content: "";
        position: absolute;
        left: 0;
        bottom: -10px;
        width: 100%;
        height: 2px;
        background: var(--text-muted);
        border-radius: 2px;
    }

    /* Right actions: CTA + hamburger */
    .nav__actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .nav__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 650;
        font-size: 0.95rem;
        color: var(--text);
        border: 1px solid var(--border);
        background: rgba(255,255,255,0.03);
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .nav__cta:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.14);
    }

    /* Hamburger - hidden on desktop */
    .nav__hamburger {
        display: none;
        width: 44px;
        height: 44px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        -webkit-tap-highlight-color: transparent;
    }

    /* Mobile */
    @media (max-width: 768px) {
        .nav__right--desktop {
            display: none;
        }

        .nav__hamburger {
            display: flex;
        }

        .nav__content {
            padding: 1rem 1.25rem;
        }

        .nav__cta {
            padding: 0.55rem 0.85rem;
            font-size: 0.9rem;
        }
    }

    @media (max-width: 400px) {
        .nav__cta span {
            display: none;
        }
    }
</style>