---
import {getPathname} from "../../utils/helpers.ts";
import {navLinks} from "../../config/navLinks.ts";
import Link from "../shared/Link.astro";
import MobileNav from "../shared/MobileNav.astro";
const pathname = getPathname(Astro.url);
---

<nav class="nav" aria-label="Primary navigation">
    <div class="nav__content">
        <a href="/" class="nav__logo" aria-label="Intrebit home">
            Intrebit
        </a>

        <!-- Desktop nav -->
        <div class="nav__right nav__right--desktop">
            <ul class="nav__links">
                {navLinks.map(({ path, label }) => {
                    const isActive = path === "/" ? pathname === "/" : pathname.startsWith(path);

                    return (
                            <Link
                                    path={path}
                                    label={label}
                                    className={isActive ? "nav__link nav__link--active" : "nav__link"}
                            />
                    );
                })}
            </ul>

            <button class="theme-toggle" type="button" aria-label="Toggle theme">
                🌗
            </button>
        </div>

        <!-- Mobile open button -->
        <button
                class="nav__menu-btn"
                type="button"
                aria-label="Open menu"
                data-mobile-open
        >
            ☰
        </button>
    </div>

    <!-- Mobile sidebar -->
    <MobileNav>
        <div slot="actions">
            <button class="theme-toggle theme-toggle--sidebar" type="button">
                Toggle theme
            </button>
        </div>
    </MobileNav>
</nav>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(12px);
    }

    .nav__content {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 1.25rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    .nav__right {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .nav__links {
        display: flex;
        gap: 1.75rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav__link {
        color: var(--text-muted);
        font-weight: 600;
        font-size: var(--text-sm);
        text-decoration: none;
        transition: color 0.2s var(--ease);
    }

    .nav__link:hover {
        color: var(--text);
    }

    .nav__link--active {
        color: var(--text);
        position: relative;
    }

    .nav__link--active::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -10px;
        width: 100%;
        height: 2px;
        background: var(--accent);
        border-radius: 2px;
    }

    /* Mobile open button */
    .nav__menu-btn {
        display: none;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text);
        font-size: 1.25rem;
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .nav__right--desktop {
            display: none;
        }

        .nav__menu-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
    }
</style>