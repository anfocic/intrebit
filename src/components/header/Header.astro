---
import {navLinks} from "../../config/site.ts";
import MobileMenu from "./MobileMenu.astro";
---

<header class="nav" aria-label="Primary navigation">
    <div class="nav__inner">
        <a href="/" class="nav__brand" aria-label="intrebit home">
            <span class="nav__brand-mark" aria-hidden="true"></span>
            <span class="nav__brand-text">intrebit</span>
        </a>

        <nav class="nav__links" aria-label="Primary">
            {navLinks.map(({href, label}) => (
                <a href={href} class="nav__link">{label}</a>
            ))}
        </nav>

        <a href="/contact" class="nav__cta">
            <span>Start a project</span><span class="nav__cta-arrow">→</span>
        </a>

        <button
            class="nav__hamburger"
            data-mobile-open
            aria-label="Open menu"
            aria-expanded="false"
        >
            <span aria-hidden="true">≡</span>
        </button>
    </div>
    <span class="nav__progress" data-scroll-progress aria-hidden="true"></span>
</header>

<MobileMenu/>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--bg);
        border-bottom: 1px solid var(--rule);
    }

    .nav__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 20px var(--section-pad-x);
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .nav__brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--ink);
    }

    .nav__brand-mark {
        width: 8px;
        height: 8px;
        background: var(--accent);
        border-radius: 2px;
        display: inline-block;
    }

    .nav__brand-text {
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.02em;
        font-weight: 500;
    }

    .nav__links {
        display: flex;
        gap: 28px;
        margin: 0 auto;
    }

    .nav__link {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--ink-2);
        text-decoration: none;
        transition: color 0.2s var(--ease);
    }

    .nav__link:hover {
        color: var(--ink);
    }

    .nav__cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 12px;
        background: var(--ink);
        color: var(--bg);
        padding: 8px 14px;
        border-radius: 999px;
        text-decoration: none;
        transition: transform 0.25s var(--ease);
    }

    .nav__cta:hover {
        transform: translateY(-2px);
    }

    .nav__cta-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .nav__cta:hover .nav__cta-arrow {
        transform: translateX(4px);
    }

    .nav__hamburger {
        display: none;
        width: 36px;
        height: 36px;
        border: 1px solid var(--rule-2);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 18px;
        line-height: 1;
        -webkit-tap-highlight-color: transparent;
    }

    .nav__progress {
        position: absolute;
        left: 0;
        bottom: -1px;
        height: 1px;
        width: 0;
        background: var(--accent);
        pointer-events: none;
    }

    @media (max-width: 768px) {
        .nav__inner {
            padding: 14px var(--section-pad-x-mobile);
            gap: 16px;
        }

        .nav__links,
        .nav__cta {
            display: none;
        }

        .nav__hamburger {
            display: inline-flex;
            margin-left: auto;
        }
    }
</style>
