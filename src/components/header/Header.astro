---
import {navLinks} from "../../config/site.ts";
import {header} from "../../config/copy.ts";
import MobileMenu from "./MobileMenu.astro";
---

<header class="nav" aria-label="Primary navigation">
    <div class="nav__inner">
        <a href="/" class="nav__brand" aria-label={`${header.brand} home`}>
            <span class="nav__brand-text">{header.brand}</span>
        </a>

        <nav class="nav__links" aria-label="Primary">
            {navLinks.map(({href, label}) => (
                <a href={href} class="nav__link" data-nav-link={href}>{label}</a>
            ))}
        </nav>

        <a href={header.cta.href} class="nav__cta">
            <span>{header.cta.label}</span><span class="nav__cta-arrow">→</span>
        </a>

        <button
            class="nav__hamburger"
            data-mobile-open
            aria-label="Open menu"
            aria-expanded="false"
        >
            <span aria-hidden="true">≡</span>
        </button>
    </div>
    <span class="nav__progress" data-scroll-progress aria-hidden="true"></span>
</header>

<MobileMenu/>

<script>
    const SCROLL_THRESHOLD = 8;

    function setupHeader() {
        const nav = document.querySelector<HTMLElement>(".nav");
        if (!nav) return () => {};

        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
        );

        const updateScrolled = () => {
            nav.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
        };
        updateScrolled();
        window.addEventListener("scroll", updateScrolled, {passive: true});

        const path = window.location.pathname.replace(/\/$/, "") || "/";
        const sectionLinks = new Map<string, HTMLAnchorElement>();
        const routeLinks: HTMLAnchorElement[] = [];

        links.forEach((link) => {
            const href = link.getAttribute("data-nav-link") || "";
            link.classList.remove("is-active");
            const hashMatch = href.match(/^\/?#(.+)$/) || href.match(/^\/#(.+)$/);
            if (hashMatch && (path === "/" || path === "")) {
                sectionLinks.set(hashMatch[1], link);
            } else {
                const linkPath = href.split("#")[0].replace(/\/$/, "") || "/";
                if (linkPath === path) link.classList.add("is-active");
                routeLinks.push(link);
            }
        });

        let observer: IntersectionObserver | null = null;
        if (sectionLinks.size) {
            const sections = Array.from(sectionLinks.keys())
                .map((id) => document.getElementById(id))
                .filter((el): el is HTMLElement => el !== null);

            const visible = new Map<string, number>();
            const setActive = (id: string | null) => {
                sectionLinks.forEach((link, key) => {
                    link.classList.toggle("is-active", key === id);
                });
            };

            observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((e) => {
                        if (e.isIntersecting) visible.set(e.target.id, e.intersectionRatio);
                        else visible.delete(e.target.id);
                    });
                    if (visible.size === 0) {
                        setActive(null);
                        return;
                    }
                    let topId: string | null = null;
                    let topY = Infinity;
                    visible.forEach((_, id) => {
                        const el = document.getElementById(id);
                        if (!el) return;
                        const y = el.getBoundingClientRect().top;
                        if (y < topY) {
                            topY = y;
                            topId = id;
                        }
                    });
                    setActive(topId);
                },
                {rootMargin: "-40% 0px -55% 0px", threshold: [0, 0.1, 0.5, 1]}
            );

            sections.forEach((s) => observer!.observe(s));
        }

        return () => {
            window.removeEventListener("scroll", updateScrolled);
            observer?.disconnect();
        };
    }

    let teardown = setupHeader();
    document.addEventListener("astro:before-swap", () => teardown?.());
    document.addEventListener("astro:page-load", () => {
        teardown = setupHeader();
    });
</script>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--bg);
        border-bottom: 1px solid transparent;
        transition: background 0.25s var(--ease), border-color 0.25s var(--ease), backdrop-filter 0.25s var(--ease);
    }

    .nav.is-scrolled {
        background: color-mix(in srgb, var(--bg) 72%, transparent);
        border-bottom-color: var(--rule);
        backdrop-filter: saturate(140%) blur(10px);
        -webkit-backdrop-filter: saturate(140%) blur(10px);
    }

    @supports not (backdrop-filter: blur(1px)) {
        .nav.is-scrolled {
            background: var(--bg);
        }
    }

    .nav__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 20px var(--section-pad-x);
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .nav__brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--ink);
    }

    .nav__brand-text {
        font-family: var(--font-mono);
        font-size: 16px;
        letter-spacing: 0.01em;
        font-weight: 600;
    }

    .nav__links {
        display: flex;
        gap: 28px;
        margin: 0 auto;
    }

    .nav__link {
        position: relative;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--ink-2);
        text-decoration: none;
        transition: color 0.2s var(--ease);
    }

    .nav__link::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -6px;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.25s var(--ease);
    }

    .nav__link:hover {
        color: var(--ink);
    }

    .nav__link.is-active {
        color: var(--ink);
    }

    .nav__link.is-active::after {
        transform: scaleX(1);
    }

    .nav__cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 12px;
        background: var(--ink);
        color: var(--bg);
        padding: 8px 14px;
        border-radius: 999px;
        text-decoration: none;
        transition: transform 0.25s var(--ease);
    }

    .nav__cta:hover {
        transform: translateY(-2px);
    }

    .nav__cta-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .nav__cta:hover .nav__cta-arrow {
        transform: translateX(4px);
    }

    .nav__hamburger {
        display: none;
        width: 44px;
        height: 44px;
        border: none;
        background: transparent;
        color: var(--accent);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 30px;
        font-weight: 600;
        line-height: 1;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
    }

    .nav__progress {
        position: absolute;
        left: 0;
        bottom: -1px;
        height: 1px;
        width: 0;
        background: var(--accent);
        pointer-events: none;
    }

    @media (max-width: 768px) {
        .nav__inner {
            padding: 14px var(--section-pad-x-mobile);
            gap: 16px;
        }

        .nav__links,
        .nav__cta {
            display: none;
        }

        .nav__hamburger {
            display: inline-flex;
            margin-left: auto;
        }
    }
</style>
