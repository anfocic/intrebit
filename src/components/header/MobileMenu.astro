---
import {navLinks} from "../../config/site.ts";
import {footer} from "../../config/copy.ts";
import ThemeToggle from "../shared/ThemeToggle.astro";
---

<div class="mobile-nav__overlay" data-mobile-overlay></div>
<aside
    class="mobile-nav__panel"
    data-mobile-sidebar
    aria-label="Mobile navigation panel"
    aria-hidden="true"
    hidden
    inert
>
    <nav class="mobile-nav__menu" aria-label="Mobile navigation">
        {navLinks.map(({href, label}, i) => (
            <a href={href} class="mobile-nav__link" style={`--i:${i}`}>
                <span class="mobile-nav__num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="mobile-nav__label">{label}</span>
                <span class="mobile-nav__arrow" aria-hidden="true">→</span>
            </a>
        ))}
    </nav>

    <div class="mobile-nav__bottom">
        <a href="/contact" class="mobile-nav__cta">
            <span>Start a project</span><span class="mobile-nav__cta-arrow">→</span>
        </a>
        <div class="mobile-nav__meta">
            <a href="/contact" data-email-user="hello" data-email-host="intrebit.com" class="mobile-nav__email mono">Email us</a>
            <div class="mobile-nav__icons">
                <a
                    href={footer.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                    class="mobile-nav__icon-link"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"/>
                    </svg>
                </a>
                <ThemeToggle/>
            </div>
        </div>
    </div>
</aside>

<style>
    .mobile-nav__overlay {
        position: fixed;
        inset: var(--header-height) 0 0 0;
        z-index: 40;
        background: rgba(7, 24, 38, 0.35);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s var(--ease);
    }

    .mobile-nav__overlay.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-nav__panel {
        position: fixed;
        left: 0;
        right: 0;
        top: var(--header-height);
        z-index: 41;
        background: var(--bg);
        border-bottom: 1px solid var(--rule);
        transform: translateY(-12px);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.3s var(--ease), opacity 0.25s var(--ease);
        overflow: hidden;
    }

    .mobile-nav__panel::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--accent);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.4s var(--ease) 0.05s;
    }

    .mobile-nav__panel.is-open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-nav__panel.is-open::before {
        transform: scaleY(1);
    }

    .mobile-nav__eyebrow {
        margin: 0;
        padding: 18px var(--section-pad-x-mobile) 0;
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    }

    .mobile-nav__panel.is-open .mobile-nav__eyebrow {
        opacity: 1;
        transform: none;
        transition-delay: 0.08s;
    }

    .mobile-nav__menu {
        display: flex;
        flex-direction: column;
        padding: 12px var(--section-pad-x-mobile);
    }

    .mobile-nav__link {
        position: relative;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: baseline;
        gap: 18px;
        padding: 22px 0;
        font-family: var(--font-display);
        font-size: 32px;
        letter-spacing: -0.025em;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
        opacity: 0;
        transform: translateY(12px);
        transition:
            opacity 0.35s var(--ease),
            transform 0.35s var(--ease),
            color 0.2s var(--ease);
    }

    .mobile-nav__panel.is-open .mobile-nav__link {
        opacity: 1;
        transform: none;
        transition-delay: calc(0.12s + var(--i, 0) * 0.06s);
    }

    .mobile-nav__link:last-of-type {
        border-bottom: none;
    }

    .mobile-nav__link:active,
    .mobile-nav__link:hover {
        color: var(--accent);
    }

    .mobile-nav__num {
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.12em;
        align-self: center;
        transition: color 0.2s var(--ease);
    }

    .mobile-nav__link:hover .mobile-nav__num,
    .mobile-nav__link:active .mobile-nav__num {
        color: var(--accent);
    }

    .mobile-nav__label {
        text-wrap: nowrap;
    }

    .mobile-nav__arrow {
        align-self: center;
        font-family: var(--font-mono);
        font-size: 18px;
        color: var(--ink-3);
        transform: translateX(-6px);
        opacity: 0;
        transition: transform 0.25s var(--ease), opacity 0.25s var(--ease), color 0.2s var(--ease);
    }

    .mobile-nav__link:hover .mobile-nav__arrow,
    .mobile-nav__link:active .mobile-nav__arrow {
        transform: translateX(0);
        opacity: 1;
        color: var(--accent);
    }

    .mobile-nav__bottom {
        position: relative;
        padding: 24px var(--section-pad-x-mobile) 28px;
        border-top: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
        gap: 16px;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
    }

    .mobile-nav__panel.is-open .mobile-nav__bottom {
        opacity: 1;
        transform: none;
        transition-delay: calc(0.12s + 4 * 0.06s);
    }

    .mobile-nav__cta {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        background: var(--accent);
        color: var(--accent-ink);
        padding: 18px 22px;
        font-family: var(--font-mono);
        font-size: 14px;
        letter-spacing: 0.04em;
        text-decoration: none;
        transition: transform 0.25s var(--ease);
    }

    .mobile-nav__cta:active {
        transform: translateY(1px);
    }

    .mobile-nav__cta-arrow {
        transition: transform 0.3s var(--ease);
    }

    .mobile-nav__cta:hover .mobile-nav__cta-arrow,
    .mobile-nav__cta:active .mobile-nav__cta-arrow {
        transform: translateX(4px);
    }

    .mobile-nav__meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .mobile-nav__icons {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .mobile-nav__icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: var(--ink-3);
        transition: color 0.2s var(--ease);
    }

    .mobile-nav__icon-link:hover {
        color: var(--ink);
    }

    .mobile-nav__email {
        font-size: 12px;
        color: var(--ink-2);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 1px;
    }

    .mobile-nav__avail-row {
        display: flex;
        justify-content: flex-start;
    }

    .mobile-nav__avail {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.04em;
    }

    .mobile-nav__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--ok, #356b3c);
        box-shadow: 0 0 0 0 currentColor;
        animation: mobile-nav-pulse 2.4s ease-out infinite;
    }

    @keyframes mobile-nav-pulse {
        0% { box-shadow: 0 0 0 0 rgba(53, 107, 60, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(53, 107, 60, 0); }
        100% { box-shadow: 0 0 0 0 rgba(53, 107, 60, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .mobile-nav__panel,
        .mobile-nav__panel::before,
        .mobile-nav__eyebrow,
        .mobile-nav__link,
        .mobile-nav__bottom {
            transition: opacity 0.15s linear !important;
            transform: none !important;
        }

        .mobile-nav__dot {
            animation: none;
        }
    }

    :global(body.menu-open) {
        overflow: hidden;
    }
</style>
