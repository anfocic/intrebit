---
import {navLinks} from "../../config/site.ts";
---

<div class="mobile-nav__overlay" data-mobile-overlay></div>
<aside
    class="mobile-nav__panel"
    data-mobile-sidebar
    aria-label="Mobile navigation panel"
    aria-hidden="true"
    hidden
    inert
>
    <nav class="mobile-nav__menu" aria-label="Mobile navigation">
        {navLinks.map(({href, label}) => (
            <a href={href} class="mobile-nav__link">{label}</a>
        ))}
    </nav>

    <div class="mobile-nav__bottom">
        <a href="/contact" class="mobile-nav__cta">
            <span>Start a project</span><span>→</span>
        </a>
        <a href="mailto:hello@intrebit.com" class="mobile-nav__email">hello@intrebit.com</a>
    </div>
</aside>

<style>
    .mobile-nav__overlay {
        position: fixed;
        inset: var(--header-height) 0 0 0;
        z-index: 40;
        background: rgba(20, 19, 16, 0.18);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s var(--ease);
    }

    .mobile-nav__overlay.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-nav__panel {
        position: fixed;
        left: 0;
        right: 0;
        top: var(--header-height);
        z-index: 41;
        background: var(--bg);
        border-bottom: 1px solid var(--rule);
        transform: translateY(-8px);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
    }

    .mobile-nav__panel.is-open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-nav__menu {
        display: flex;
        flex-direction: column;
        padding: 12px var(--section-pad-x-mobile);
    }

    .mobile-nav__link {
        padding: 18px 0;
        font-family: var(--font-display);
        font-size: 28px;
        letter-spacing: -0.02em;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }

    .mobile-nav__link:last-child {
        border-bottom: none;
    }

    .mobile-nav__bottom {
        padding: 20px var(--section-pad-x-mobile) 24px;
        border-top: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .mobile-nav__cta {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        background: var(--ink);
        color: var(--bg);
        padding: 14px 18px;
        font-family: var(--font-mono);
        font-size: 13px;
        text-decoration: none;
    }

    .mobile-nav__email {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--ink-3);
        text-decoration: none;
    }

    :global(body.menu-open) {
        overflow: hidden;
    }
</style>
