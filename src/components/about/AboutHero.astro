---
interface Props {
    heading?: string;
    lead?: string[];
    imageSrc?: string;
    imageAlt?: string;
}

const {
    heading = "Who are we?",
    lead = [
        `A bunch of millennials who got tired of corporate PowerPoint presentations, meaningless synergies, and "let's circle back on that." We decided to actually build something that doesn't suck.`,
        `We're engineers, designers, and strategists who believe that good software shouldn't require a 47-slide deck to explain. No buzzwords. No BS. Just clean code, thoughtful design, and solutions that actually work.`,
        `We're here to prove that you can build world-class tech without the corporate theater.`,
    ],
    imageSrc = "https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&q=80",
    imageAlt = "Modern workspace",
} = Astro.props;
---

<section class="section">
    <div class="container about-hero">
        <div class="about-hero__content">
            <h1>
                {heading.split(" ").slice(0, 2).join(" ")}{" "}
                <span class="text-serif">{heading.split(" ").slice(2).join(" ")}</span>
            </h1>

            <div class="about-hero__text">
                {lead.map((p) => (
                        <p>{p}</p>
                ))}
            </div>
        </div>

        <div class="about-hero__media">
            <img src={imageSrc} alt={imageAlt} loading="lazy" class="about-hero__image" />
        </div>
    </div>
</section>

<style>
    .section {
        padding: 5.5rem 0;
    }

    .about-hero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 5rem;
        align-items: center;
    }

    .about-hero__text {
        margin-top: 2rem;
        display: grid;
        gap: 1.25rem;
    }

    .about-hero__text p {
        font-size: 1.08rem;
        color: var(--text-muted);
        margin: 0;
        max-width: 620px;
    }

    .about-hero__image {
        width: 100%;
        border-radius: var(--radius-soft);
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--border);
    }

    @media (max-width: 900px) {
        .about-hero {
            grid-template-columns: 1fr;
            gap: 2.75rem;
        }

        .section {
            padding: 4rem 0;
        }

        .about-hero__text p {
            max-width: none;
        }
    }
</style>