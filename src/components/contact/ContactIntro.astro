<style>
    .contact-intro {
        position: sticky;
        top: calc(var(--header-height, 72px) + 2rem);
    }

    .contact-intro__title {
        font-family: var(--font-brand, sans-serif), serif;
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 750;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin: 0 0 1.25rem;
        padding-bottom: 2rem;
        color: var(--text);
    }

    .contact-intro__about {
        margin-bottom: 2.5rem;
        padding-bottom: 4.5rem;
        border-bottom: 0.3px solid var(--text);
    }

    .contact-intro__about-label {
        font-size: 1rem;
        letter-spacing: 0.1em;
    }

    .contact-intro__about p {
        margin: 0;
        font-size: 1rem;
    }

    .contact-intro__about p:last-child {
        margin-bottom: 0;
    }

    /* Contact details */
    .contact-intro__details {
        display: flex;
        flex-direction: row;
        gap: 5rem;
    }

    .contact-intro__detail {
        display: flex;
        flex-direction: column;
    }

    .contact-intro__detail-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        opacity: 0.7;
    }

    .contact-intro__detail-value {
        font-size: 1rem;
        color: var(--text);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    a.contact-intro__detail-value:hover {
        color: var(--text-muted);
    }

    /* Socials */
    .contact-intro__socials {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }

    .contact-intro__social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .contact-intro__social:hover {
        border-color: var(--text-muted);
        color: var(--text);
    }

    .contact-intro__social svg {
        display: block;
    }

    /* Mobile */
    @media (max-width: 900px) {
        .contact-intro {
            position: static;
        }
    }

    @media (max-width: 600px) {
        .contact-intro__details {
            display: none
        }
    }

    @media (max-width: 520px) {
        .contact-intro__title {
            font-size: 1.75rem;
        }
    }
</style>