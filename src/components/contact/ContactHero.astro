---
import AsteriskGlyph from "../shared/glyphs/AsteriskGlyph.astro";
---

<section class="chero" aria-label="Contact">
    <div class="chero__inner">
        <div class="chero__glyph" aria-hidden="true">
            <AsteriskGlyph size={200}/>
        </div>

        <p class="label chero__eyebrow">
            <span class="chero__dot">●</span>
            Replies within a day · No sales calls
        </p>

        <h1 class="chero__title">
            Tell us what's broken<br/>
            <em>— or what you want built.</em>
        </h1>

        <p class="chero__lead">
            Drop us a line. We'll ask a couple of questions, then send back
            a straight answer — a proposal, or an honest no. No spam. No drip
            campaigns. No &ldquo;just circling back.&rdquo;
        </p>
    </div>
</section>

<style>
    .chero {
        position: relative;
        overflow: hidden;
        padding: 80px var(--section-pad-x) 40px;
    }

    .chero__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .chero__glyph {
        position: absolute;
        top: -10px;
        right: 0;
        color: var(--ink);
        opacity: 0.85;
        pointer-events: none;
    }

    .chero__eyebrow {
        margin: 0 0 32px;
    }

    .chero__dot {
        color: var(--accent);
    }

    .chero__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(48px, 11vw, 132px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        margin: 0;
        max-width: 1100px;
        text-wrap: balance;
        position: relative;
        color: var(--ink);
    }

    .chero__title em {
        font-style: italic;
        color: var(--accent);
    }

    .chero__lead {
        font-family: var(--font-sans);
        font-size: 20px;
        line-height: 1.4;
        color: var(--ink-2);
        margin: 40px 0 0;
        max-width: 640px;
        text-wrap: pretty;
    }

    @media (max-width: 900px) {
        .chero {
            padding: 32px var(--section-pad-x-mobile) 24px;
        }

        .chero__glyph {
            opacity: 0.5;
            top: 20px;
            right: -40px;
        }

        .chero__title {
            font-size: 48px;
            line-height: 0.95;
        }

        .chero__lead {
            font-size: 15px;
            margin-top: 20px;
        }
    }
</style>
