---
import {contact} from "../../config/copy.ts";

const {hero} = contact;
---

<section class="chero" aria-label="Contact">
    <div class="chero__inner">
        <h1 class="chero__title" transition:name="cta-heading" set:html={hero.title}/>
    </div>
</section>

<style>
    .chero {
        position: relative;
        overflow: hidden;
        padding: 56px var(--section-pad-x) 32px;
    }

    .chero__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .chero__glyph {
        position: absolute;
        top: -10px;
        right: 0;
        opacity: 0.7;
        color: var(--ink);
        pointer-events: none;
    }

    .chero__eyebrow {
        margin: 0 0 24px;
    }

    .chero__dot {
        color: var(--accent);
    }

    .chero__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 7vw, 80px);
        line-height: 1.12;
        letter-spacing: -0.035em;
        margin: 0;
        max-width: 900px;
        text-wrap: balance;
        color: var(--ink);
    }

    .chero__title em {
        font-style: italic;
        color: var(--accent);
    }

    .chero__lead {
        font-family: var(--font-sans);
        font-size: 17px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 24px 0 0;
        max-width: 560px;
        text-wrap: pretty;
    }

    @media (max-width: 900px) {
        .chero {
            padding: 32px var(--section-pad-x-mobile) 24px;
        }

        .chero__glyph {
            opacity: 0.5;
            top: 20px;
            right: -40px;
        }

        .chero__title {
            font-size: 48px;
            line-height: 1.15;
        }

        .chero__lead {
            font-size: 15px;
            margin-top: 20px;
        }
    }
</style>
