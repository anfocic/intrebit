---
/**
    * ContactHero — Split layout contact section
    * Left: Personality, who we are, contact info
    * Right: Contact form
    */
---

<section id="contact" class="contact-section" aria-label="Contact">
    <div class="contact-container">
        <div class="contact-grid">

            <!-- Left: Personality & Info -->
            <div class="contact-intro">
                <h2 class="contact-intro__title">Let's build something.</h2>

                <p class="contact-intro__lead">
                    We're a small team that takes on a handful of projects at a time.
                    No account managers, no endless meetings — you talk directly to the people doing the work.
                </p>

                <div class="contact-intro__about">
                    <h3 class="contact-intro__about-label">Who we are</h3>
                    <p>
                        Engineers and designers who got tired of watching good ideas
                        die in corporate bureaucracy. We left to build things properly —
                        software that works, scales, and doesn't make you want to throw
                        your laptop out the window.
                    </p>
                    <p>
                        Based in Europe, working with clients worldwide.
                        Remote-first since before it was trendy.
                    </p>
                </div>

                <div class="contact-intro__details">
                    <div class="contact-intro__detail">
                        <span class="contact-intro__detail-label">Email</span>
                        <a href="mailto:hello@intrebit.com" class="contact-intro__detail-value">
                            hello@intrebit.com
                        </a>
                    </div>

                    <div class="contact-intro__detail">
                        <span class="contact-intro__detail-label">Response time</span>
                        <span class="contact-intro__detail-value">Usually within 24h</span>
                    </div>

                    <div class="contact-intro__detail">
                        <span class="contact-intro__detail-label">Follow</span>
                        <div class="contact-intro__socials">
                            <a
                                    href="https://www.linkedin.com/company/intrebit"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="contact-intro__social"
                                    aria-label="LinkedIn"
                            >
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                            </a>
                            <a
                                    href="https://mastodon.social/@intrebit"
                                    target="_blank"
                                    rel="me noopener noreferrer"
                                    class="contact-intro__social"
                                    aria-label="Mastodon"
                            >
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Form -->
            <div class="contact-form-card">
                <form class="contact-form" id="contact-form">
                    <!-- Honeypot (spam trap) -->
                    <label class="honeypot" aria-hidden="true">
                        Do not fill
                        <input type="text" name="company" tabindex="-1" autocomplete="off"/>
                    </label>

                    <div class="contact-form__field">
                        <label for="contact-name" class="contact-form__label">Name</label>
                        <input
                                class="contact-form__input"
                                type="text"
                                name="name"
                                id="contact-name"
                                placeholder="What should we call you?"
                                autocomplete="name"
                        />
                    </div>

                    <div class="contact-form__field">
                        <label for="contact-email" class="contact-form__label">
                            Email <span class="contact-form__required">*</span>
                        </label>
                        <input
                                class="contact-form__input"
                                type="email"
                                name="email"
                                id="contact-email"
                                placeholder="you@company.com"
                                required
                                autocomplete="email"
                        />
                    </div>

                    <div class="contact-form__field">
                        <label for="contact-message" class="contact-form__label">
                            What's on your mind? <span class="contact-form__required">*</span>
                        </label>
                        <textarea
                                class="contact-form__textarea"
                                name="message"
                                id="contact-message"
                                placeholder="Tell us about your project, problem, or idea. The more detail, the better we can help."
                                rows="5"
                                required
                        ></textarea>
                    </div>

                    <button class="contact-form__submit" type="submit">
                        Send message
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>

                    <p class="contact-form__note">
                        We'll only use this to reply. No spam, no newsletters, no BS.
                    </p>
                </form>

                <p class="contact-form__status" id="contact-status" aria-live="polite"></p>
            </div>
        </div>
    </div>
</section>

<style>
    /* ========================
       Section & Container
       ======================== */
    .contact-section {
        position: relative;
        padding: 6rem 0 7rem;
    }

    .contact-container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* ========================
       Grid Layout
       ======================== */
    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    /* ========================
       Left: Intro & Info
       ======================== */
    .contact-intro {
        position: sticky;
        top: calc(var(--header-height, 72px) + 2rem);
    }

    .contact-intro__title {
        font-family: var(--font-brand, sans-serif);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 750;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin: 0 0 1.25rem;
        color: var(--text);
    }

    .contact-intro__lead {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--text-muted);
        margin: 0 0 2.5rem;
        max-width: 44ch;
    }

    /* About block */
    .contact-intro__about {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
    }

    .contact-intro__about-label {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 0 0 1rem;
    }

    .contact-intro__about p {
        font-size: 0.98rem;
        line-height: 1.7;
        color: var(--text-muted);
        margin: 0 0 1rem;
    }

    .contact-intro__about p:last-child {
        margin-bottom: 0;
    }

    /* Contact details */
    .contact-intro__details {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .contact-intro__detail {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .contact-intro__detail-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        opacity: 0.7;
    }

    .contact-intro__detail-value {
        font-size: 1rem;
        color: var(--text);
        text-decoration: none;
        transition: color 0.2s var(--ease, ease);
    }

    a.contact-intro__detail-value:hover {
        color: var(--text-muted);
    }

    /* Socials */
    .contact-intro__socials {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.25rem;
    }

    .contact-intro__social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
        text-decoration: none;
        transition:
                background 0.2s var(--ease, ease),
                border-color 0.2s var(--ease, ease),
                color 0.2s var(--ease, ease),
                transform 0.2s var(--ease, ease);
    }

    .contact-intro__social:hover {
        background: color-mix(in srgb, var(--surface) 100%, var(--text) 8%);
        border-color: color-mix(in srgb, var(--border) 100%, var(--text) 15%);
        color: var(--text);
        transform: translateY(-2px);
    }

    .contact-intro__social svg {
        display: block;
    }

    /* ========================
       Right: Form Card
       ======================== */
    .contact-form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-soft, 16px);
        padding: 2.25rem;
        backdrop-filter: blur(10px);
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Form fields */
    .contact-form__field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .contact-form__label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text);
    }

    .contact-form__required {
        color: #f87171;
        margin-left: 2px;
    }

    /* Inputs */
    .contact-form__input,
    .contact-form__textarea {
        width: 100%;
        border-radius: 12px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface) 50%, transparent);
        color: var(--text);
        font-size: 1rem;
        font-family: inherit;
        line-height: 1.5;
        transition:
                border-color 0.2s var(--ease, ease),
                box-shadow 0.2s var(--ease, ease);
    }

    .contact-form__input {
        height: 52px;
    }

    .contact-form__textarea {
        min-height: 140px;
        resize: vertical;
    }

    .contact-form__input::placeholder,
    .contact-form__textarea::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }

    .contact-form__input:focus,
    .contact-form__textarea:focus {
        outline: none;
        border-color: color-mix(in srgb, var(--text) 30%, var(--border));
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--text) 6%, transparent);
    }

    /* Submit button */
    .contact-form__submit {
        width: 100%;
        height: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 0.5rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        font-size: 1rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition:
                background 0.2s var(--ease, ease),
                border-color 0.2s var(--ease, ease),
                transform 0.2s var(--ease, ease),
                box-shadow 0.2s var(--ease, ease);
    }

    .contact-form__submit:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.22);
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .contact-form__submit:active {
        transform: translateY(0);
    }

    .contact-form__submit svg {
        transition: transform 0.2s var(--ease, ease);
    }

    .contact-form__submit:hover svg {
        transform: translate(3px, -3px);
    }

    /* Form note */
    .contact-form__note {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-align: center;
        margin: 0;
        opacity: 0.8;
    }

    /* Status message */
    .contact-form__status {
        margin-top: 1rem;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.5;
        text-align: center;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text);
        opacity: 0;
        transform: translateY(4px);
        transition:
                opacity 0.2s var(--ease, ease),
                transform 0.2s var(--ease, ease);
    }

    .contact-form__status:not(:empty) {
        opacity: 1;
        transform: translateY(0);
    }

    /* Status variants - using :global for JS-added classes */
    :global(.contact-form__status.status--success) {
        background: rgba(34, 197, 94, 0.12);
        border-color: rgba(34, 197, 94, 0.3);
        color: #4ade80;
    }

    :global(.contact-form__status.status--error) {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.3);
        color: #f87171;
    }

    /* ========================
       Responsive
       ======================== */
    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .contact-intro {
            position: static;
        }

        .contact-intro__lead {
            max-width: none;
        }
    }

    @media (max-width: 520px) {
        .contact-section {
            padding: 4rem 0 5rem;
        }

        .contact-container {
            padding: 0 1.25rem;
        }

        .contact-form-card {
            padding: 1.5rem;
        }

        .contact-intro__title {
            font-size: 1.75rem;
        }

        .contact-form__input,
        .contact-form__textarea {
            padding: 12px 14px;
        }

        .contact-form__input {
            height: 48px;
        }

        .contact-form__submit {
            height: 50px;
        }
    }

    /* ========================
       Light mode adjustments
       ======================== */
    :global(:root[data-theme="light"]) .contact-form-card {
        background: rgba(255, 255, 255, 0.7);
        box-shadow: 0 12px 40px rgba(14, 42, 71, 0.06);
    }

    :global(:root[data-theme="light"]) .contact-form__input,
    :global(:root[data-theme="light"]) .contact-form__textarea {
        background: rgba(255, 255, 255, 0.8);
    }

    :global(:root[data-theme="light"]) .contact-intro__social {
        background: rgba(255, 255, 255, 0.6);
    }

    :global(:root[data-theme="light"]) .contact-form__submit {
        background: var(--text);
        color: var(--bg);
        border-color: var(--text);
    }

    :global(:root[data-theme="light"]) .contact-form__submit:hover {
        box-shadow: 0 12px 32px rgba(14, 42, 71, 0.2);
    }

    :global(:root[data-theme="light"] .contact-form__status.status--success) {
        color: #16a34a;
    }

    :global(:root[data-theme="light"] .contact-form__status.status--error) {
        color: #dc2626;
    }
</style>

<script is:inline src="/scripts/contact.js" defer></script>