---
import {contact} from "../../config/copy.ts";

const {pageHero, serviceVariants} = contact;
---

<section class="chero" aria-label="Contact" id="contact-hero">
    <div class="chero__inner">
        <h1 class="chero__title" data-default-title={pageHero.title} transition:name="cta-heading" set:html={pageHero.title}/>
        <p class="chero__about" data-default-about={pageHero.about} set:html={pageHero.about} />
    </div>
</section>

<script define:vars={{ variants: serviceVariants }}>
    const service = localStorage.getItem("contact-service");
    const variant = variants[service];
    if (variant) {
        const titleEl = document.querySelector("#contact-hero .chero__title");
        const aboutEl = document.querySelector("#contact-hero .chero__about");
        if (titleEl) titleEl.innerHTML = variant.title;
        if (aboutEl) aboutEl.innerHTML = variant.about;
        localStorage.removeItem("contact-service");
    }
</script>

<style>
    .chero {
        position: relative;
        overflow: hidden;
        padding: 56px var(--section-pad-x) 32px;
    }

    .chero__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .chero__glyph {
        position: absolute;
        top: -10px;
        right: 0;
        opacity: 0.7;
        color: var(--ink);
        pointer-events: none;
    }

    .chero__eyebrow {
        margin: 0 0 24px;
    }

    .chero__dot {
        color: var(--accent);
    }

    .chero__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(36px, 5vw, 64px);
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0;
        max-width: 520px;
        text-wrap: balance;
        color: var(--ink);
    }

    .chero__title em {
        font-style: italic;
        color: var(--accent);
    }

    .chero__lead {
        font-family: var(--font-sans);
        font-size: 17px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 24px 0 0;
        max-width: 560px;
        text-wrap: pretty;
    }

    .chero__lead em {
        font-style: italic;
        color: var(--accent);
    }

    .chero__about {
        font-size: 17px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 24px 0 0;
        max-width: 480px;
    }

    .chero__about em {
        font-style: normal;
        color: var(--accent);
    }

    @media (max-width: 900px) {
        .chero {
            padding: 32px var(--section-pad-x-mobile) 24px;
        }

        .chero__glyph {
            opacity: 0.5;
            top: 20px;
            right: -40px;
        }

        .chero__title {
            font-size: 40px;
            line-height: 1.05;
        }

        .chero__lead {
            font-size: 15px;
            margin-top: 20px;
        }

        .chero__about {
            margin-top: 24px;
        }
    }
</style>
