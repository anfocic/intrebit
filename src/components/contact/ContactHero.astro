---
import {contact} from "../../config/copy.ts";

const {pageHero, serviceVariants, assurances} = contact;
---

<section class="chero" aria-label="Contact" id="contact-hero">
    <div class="chero__inner">
        <h1 class="chero__title" set:html={pageHero.title}/>
        <p class="chero__about" set:html={pageHero.about} />

        <div class="chero__assurances">
            <span class="chero__assurances-label">{assurances.label}</span>
            <ul class="chero__assurances-list">
                {assurances.items.map((item) => (
                    <li class="chero__assurances-item">{item}</li>
                ))}
            </ul>
        </div>
    </div>
</section>

<script define:vars={{ variants: serviceVariants }}>
    const service = localStorage.getItem("contact-service");
    const variant = service && variants[service];
    if (variant) {
        const titleEl = document.querySelector("#contact-hero .chero__title");
        const aboutEl = document.querySelector("#contact-hero .chero__about");
        if (titleEl) titleEl.innerHTML = variant.title;
        if (aboutEl) aboutEl.innerHTML = variant.about;
        localStorage.removeItem("contact-service");
    }
</script>

<style>
    .chero {
        position: relative;
        padding: 56px var(--section-pad-x) 32px;
    }

    .chero__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .chero__glyph {
        position: absolute;
        top: -10px;
        right: 0;
        opacity: 0.7;
        color: var(--ink);
        pointer-events: none;
    }

    .chero__eyebrow {
        margin: 0 0 24px;
    }

    .chero__dot {
        color: var(--accent);
    }

    .chero__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(36px, 5vw, 64px);
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0;
        max-width: 520px;
        text-wrap: balance;
        color: var(--ink);
    }

    .chero__title em {
        font-style: italic;
        color: var(--accent);
    }

    .chero__lead {
        font-family: var(--font-sans);
        font-size: 17px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 24px 0 0;
        max-width: 560px;
        text-wrap: pretty;
    }

    .chero__lead em {
        font-style: italic;
        color: var(--accent);
    }

    .chero__about {
        font-size: 17px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 24px 0 0;
        max-width: 480px;
    }

    .chero__assurances {
        margin-top: 44px;
        max-width: 480px;
    }

    .chero__assurances-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin-bottom: 16px;
    }

    .chero__assurances-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .chero__assurances-item {
        font-size: 16px;
        line-height: 1.45;
        color: var(--ink);
    }

    @media (max-width: 900px) {
        .chero {
            padding: 32px var(--section-pad-x-mobile) 24px;
        }

        .chero__glyph {
            opacity: 0.5;
            top: 20px;
            right: -40px;
        }

        .chero__title {
            font-size: 40px;
            line-height: 1.05;
        }

        .chero__lead {
            font-size: 15px;
            margin-top: 20px;
        }

        .chero__about {
            margin-top: 24px;
        }
    }
</style>
