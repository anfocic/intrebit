---
import ContactIntro from "./ContactIntro.astro";
import ContactForm from "./ContactForm.astro";
---

<section id="contact" class="contact-section" aria-label="Contact">
    <div class="contact-container">
        <div class="contact-grid">
            <div class="desktop-only">
                <ContactIntro />
            </div>
            <ContactForm />
        </div>
    </div>
</section>

<style>
    .contact-section {
        position: relative;
        padding: 6rem 0 7rem;
    }

    .contact-container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: start;
    }

    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 3.5rem;
        }
    }

    @media (max-width: 520px) {
        .contact-section {
            padding: 4rem 0 5rem;
        }

        .contact-container {
            padding: 0 1.25rem;
        }
    }
</style>