---
import ContactIntro from "./ContactIntro.astro";
import ContactForm from "./ContactForm.astro";
---

<section id="contact" class="contact-section" aria-label="Contact">
    <div class="contact-container">
        <div class="contact-grid">
            <div class="desktop-only">
                <ContactIntro />
            </div>
            <ContactForm />
        </div>
    </div>
</section>

<style>
    .contact-section {
        position: relative;
        padding: 6rem 0 7rem;
    }

    .contact-container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: start;
    }

    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 3.5rem;
        }
    }

    @media (max-width: 520px) {
        .contact-section {
            padding: 4rem 0 5rem;
        }

        .contact-container {
            padding: 0 1.25rem;
        }
    }

    .contact-intro,
    .contact-card,
    .contact-form__field {
        will-change: transform, opacity, filter;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReduced =
        window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;

    if (!prefersReduced) {
        const section = document.querySelector(".contact-section");
        const intro = document.querySelector(".contact-intro");
        const card = document.querySelector(".contact-card");
        const fields = gsap.utils.toArray(".contact-form__field");
        const btn = document.querySelector(".contact-form__submit");

        if (section) {
            // Base states
            if (intro) gsap.set(intro, { opacity: 0, y: 18, filter: "blur(6px)" });
            if (card) gsap.set(card, { opacity: 0, y: 22, filter: "blur(8px)" });

            // Section reveal
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: section,
                    start: "top 80%",
                    once: true,
                },
                defaults: { ease: "power2.out" },
            });

            if (intro) {
                tl.to(intro, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.9 }, 0);
            }

            if (card) {
                tl.to(card, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.95 }, 0.12);
            }

            if (fields.length) {
                tl.fromTo(
                    fields,
                    { opacity: 0, y: 10 },
                    { opacity: 1, y: 0, duration: 0.5, stagger: 0.08 },
                    0.35
                );
            }
        }

        // Button micro-feedback (only on hover-capable devices)
        if (btn && window.matchMedia?.("(hover: hover)")?.matches) {
            btn.addEventListener("mouseenter", () => {
                gsap.to(btn, { y: -2, duration: 0.18, ease: "power2.out", overwrite: "auto" });
            });
            btn.addEventListener("mouseleave", () => {
                gsap.to(btn, { y: 0, duration: 0.24, ease: "power2.out", overwrite: "auto" });
            });
            btn.addEventListener("mousedown", () => {
                gsap.to(btn, { scale: 0.98, duration: 0.08, overwrite: "auto" });
            });
            btn.addEventListener("mouseup", () => {
                gsap.to(btn, { scale: 1, duration: 0.12, overwrite: "auto" });
            });
        }
    } else {
        // Reduced motion: ensure everything is visible
        gsap.set([".contact-intro", ".contact-card", ".contact-form__field"], {
            opacity: 1,
            y: 0,
            filter: "none",
        });
    }
</script>