<div class="contact-card">
    <form class="contact-form" id="contact-form">
        <!-- Honeypot (spam trap) -->
        <label class="honeypot" aria-hidden="true">
            Do not fill
            <input type="text" name="company" tabindex="-1" autocomplete="off"/>
        </label>

        <div class="contact-form__field">
            <label for="contact-name" class="contact-form__label">Name</label>
            <input
                    class="contact-form__input"
                    type="text"
                    name="name"
                    id="contact-name"
                    placeholder="What should we call you?"
                    autocomplete="name"
            />
        </div>

        <div class="contact-form__field">
            <label for="contact-email" class="contact-form__label">
                Email <span class="contact-form__required">*</span>
            </label>
            <input
                    class="contact-form__input"
                    type="email"
                    name="email"
                    id="contact-email"
                    placeholder="you@company.com"
                    required
                    autocomplete="email"
            />
        </div>

        <div class="contact-form__field">
            <label for="contact-message" class="contact-form__label">
                Message <span class="contact-form__required">*</span>
            </label>
            <textarea
                    class="contact-form__textarea"
                    name="message"
                    id="contact-message"
                    placeholder="Tell us about your project..."
                    rows="4"
                    required
            ></textarea>
        </div>

        <div class="contact-form__footer">
            <p class="contact-form__note">
                You can also email us at <a href="mailto:hello@intrebit.com">hello@intrebit.com</a>
            </p>
            <button class="contact-form__submit" type="submit">
                Send message
            </button>
        </div>
    </form>

    <div class="contact-form__status" id="contact-status" aria-live="polite"></div>
</div>

<style>
    /* Card wrapper - subtle border like Linear */
    .contact-card {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.75rem;
        background: transparent;
    }

    /* Form */
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* Honeypot */
    .honeypot {
        position: absolute;
        left: -9999px;
        opacity: 0;
        pointer-events: none;
    }

    /* Field */
    .contact-form__field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .contact-form__label {
        font-size: 0.875rem;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.5);
    }

    /* INPUTS - Linear style: dark filled, visible background */
    .contact-form__input,
    .contact-form__textarea {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--text);
        font-size: 0.9375rem;
        font-family: inherit;
        line-height: 1.5;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    .contact-form__textarea {
        min-height: 140px;
        resize: vertical;
    }

    .contact-form__input::placeholder,
    .contact-form__textarea::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .contact-form__input:hover,
    .contact-form__textarea:hover {
        border-color: rgba(255, 255, 255, 0.15);
    }

    .contact-form__input:focus,
    .contact-form__textarea:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.25);
        background: rgba(255, 255, 255, 0.07);
    }

    /* Footer */
    .contact-form__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    /* Note */
    .contact-form__note {
        font-size: 0.8125rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0;
    }

    .contact-form__note a {
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
    }

    .contact-form__note a:hover {
        color: rgba(255, 255, 255, 0.7);
    }

    /* Submit button - Linear style: subtle filled */
    .contact-form__submit {
        padding: 0.625rem 1rem;
        border-radius: 6px;
        border: none;
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.875rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
        white-space: nowrap;
    }

    .contact-form__submit:hover {
        background: rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.9);
    }

    .contact-form__submit:active {
        background: rgba(255, 255, 255, 0.12);
    }

    /* Status message */
    .contact-form__status {
        margin-top: 1.25rem;
        padding: 0.875rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        display: none;
    }

    .contact-form__status:not(:empty) {
        display: block;
    }

    .contact-form__status.status--success {
        background: rgba(34, 197, 94, 0.1);
        color: #4ade80;
    }

    .contact-form__status.status--error {
        background: rgba(239, 68, 68, 0.1);
        color: #f87171;
    }

    /* Mobile */
    @media (max-width: 600px) {
        .contact-card {
            padding: 1.25rem;
        }

        .contact-card__title {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
        }

        .contact-form__footer {
            flex-direction: column-reverse;
            align-items: stretch;
            gap: 0.875rem;
        }

        .contact-form__submit {
            width: 100%;
            text-align: center;
            padding: 0.75rem 1rem;
        }

        .contact-form__note {
            text-align: center;
        }
    }

    /* Light mode */
    :global(:root[data-theme="light"]) .contact-card {
        border-color: rgba(0, 0, 0, 0.1);
    }

    :global(:root[data-theme="light"]) .contact-card__title {
        border-bottom-color: rgba(0, 0, 0, 0.08);
    }

    :global(:root[data-theme="light"]) .contact-form__label {
        color: rgba(0, 0, 0, 0.5);
    }

    :global(:root[data-theme="light"]) .contact-form__input,
    :global(:root[data-theme="light"]) .contact-form__textarea {
        border-color: rgba(0, 0, 0, 0.1);
        background: rgba(0, 0, 0, 0.04);
    }

    :global(:root[data-theme="light"]) .contact-form__input::placeholder,
    :global(:root[data-theme="light"]) .contact-form__textarea::placeholder {
        color: rgba(0, 0, 0, 0.35);
    }

    :global(:root[data-theme="light"]) .contact-form__input:hover,
    :global(:root[data-theme="light"]) .contact-form__textarea:hover {
        border-color: rgba(0, 0, 0, 0.18);
    }

    :global(:root[data-theme="light"]) .contact-form__input:focus,
    :global(:root[data-theme="light"]) .contact-form__textarea:focus {
        border-color: rgba(0, 0, 0, 0.25);
        background: rgba(0, 0, 0, 0.06);
    }

    :global(:root[data-theme="light"]) .contact-form__note {
        color: rgba(0, 0, 0, 0.45);
    }

    :global(:root[data-theme="light"]) .contact-form__note a {
        color: rgba(0, 0, 0, 0.55);
    }

    :global(:root[data-theme="light"]) .contact-form__submit {
        background: rgba(0, 0, 0, 0.06);
        color: rgba(0, 0, 0, 0.7);
    }

    :global(:root[data-theme="light"]) .contact-form__submit:hover {
        background: rgba(0, 0, 0, 0.1);
        color: rgba(0, 0, 0, 0.85);
    }
</style>

<script src="/scripts/contact.js" defer></script>