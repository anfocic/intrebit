---
import OrbGlyph from "../shared/glyphs/OrbGlyph.astro";
---

<section class="cform" aria-label="Contact form" data-reveal>
    <div class="cform__inner">
        <aside class="cform__side">
            <p class="label">— Form</p>
            <h2 class="cform__side-title">
                Or just <em>email</em>.
            </h2>
            <p class="cform__side-body">If forms aren't your thing —</p>
            <a class="mono cform__email" href="mailto:hello@intrebit.com">hello@intrebit.com</a>
            <div class="cform__avail">
                <p class="cform__avail-head"># availability</p>
                <p class="cform__avail-body">
                    <span class="cform__avail-dot">●</span>
                    2 client slots open · Q3 2026
                </p>
            </div>
        </aside>

        <form class="cform__form" id="contact-form" novalidate>
            <label class="honeypot" aria-hidden="true">
                Do not fill
                <input type="text" name="company_hp" tabindex="-1" autocomplete="off"/>
            </label>

            <div class="cform__row cform__row--two">
                <div class="cform__field">
                    <label class="cform__label" for="cf-name">Name</label>
                    <input class="cform__input" id="cf-name" name="name" placeholder="Jane Doe" autocomplete="name"/>
                    <div class="cform__err" data-err-for="name"></div>
                </div>
                <div class="cform__field">
                    <label class="cform__label" for="cf-email">Email</label>
                    <input class="cform__input" id="cf-email" name="email" type="email" placeholder="jane@company.com" autocomplete="email"/>
                    <div class="cform__err" data-err-for="email"></div>
                </div>
            </div>

            <div class="cform__field">
                <label class="cform__label" for="cf-company">Company (optional)</label>
                <input class="cform__input" id="cf-company" name="company" placeholder="Acme Co." autocomplete="organization"/>
            </div>

            <div class="cform__field">
                <label class="cform__label">What kind of project?</label>
                <div class="cform__chips" role="radiogroup" aria-label="Project kind">
                    <button type="button" class="cform__chip is-selected" data-kind="build" role="radio" aria-checked="true">Build something new</button>
                    <button type="button" class="cform__chip" data-kind="fix" role="radio" aria-checked="false">Fix something broken</button>
                    <button type="button" class="cform__chip" data-kind="automate" role="radio" aria-checked="false">Automate something</button>
                    <button type="button" class="cform__chip" data-kind="other" role="radio" aria-checked="false">Not sure / something else</button>
                </div>
                <input type="hidden" name="kind" id="cf-kind" value="build"/>
            </div>

            <div class="cform__row cform__row--two">
                <div class="cform__field">
                    <label class="cform__label" for="cf-budget">Budget range (optional)</label>
                    <select class="cform__input cform__select" id="cf-budget" name="budget">
                        <option value="">— select —</option>
                        <option>Under €5k</option>
                        <option>€5k – €15k</option>
                        <option>€15k – €40k</option>
                        <option>€40k+</option>
                        <option>Not sure yet</option>
                    </select>
                </div>
                <div class="cform__field">
                    <label class="cform__label" for="cf-timeline">Timeline (optional)</label>
                    <select class="cform__input cform__select" id="cf-timeline" name="timeline">
                        <option value="">— select —</option>
                        <option>ASAP</option>
                        <option>Next month</option>
                        <option>This quarter</option>
                        <option>Flexible</option>
                    </select>
                </div>
            </div>

            <div class="cform__field">
                <label class="cform__label" for="cf-message">What's the project?</label>
                <textarea
                    class="cform__input cform__textarea"
                    id="cf-message"
                    name="message"
                    placeholder="A few sentences on what you need, what you've tried, and any constraints we should know about."
                ></textarea>
                <div class="cform__row cform__row--meta">
                    <div class="cform__err" data-err-for="message"></div>
                    <span class="mono cform__count" data-char-count>0 chars</span>
                </div>
            </div>

            <div class="cform__footer">
                <span class="mono cform__note">
                    We reply within 1 business day · GDPR-friendly · No newsletter signup
                </span>
                <button type="submit" class="cform__submit">
                    <span data-submit-label>Send message</span>
                    <span class="cform__submit-arrow">→</span>
                </button>
            </div>
        </form>

        <div class="cform__success" id="cform-success" hidden>
            <div class="cform__success-glyph" aria-hidden="true">
                <OrbGlyph size={260}/>
            </div>
            <p class="label cform__success-label">✓ Message sent</p>
            <h2 class="cform__success-title">
                Got it, <span data-success-name>friend</span>.<br/>
                <em>We'll be in touch.</em>
            </h2>
            <p class="cform__success-body">
                We'll reply to <span class="mono cform__success-email" data-success-email>you</span> within a day.
                Usually faster.
            </p>
            <button type="button" class="cform__again" data-send-another>← Send another</button>
        </div>
    </div>
</section>

<style>
    .cform {
        padding: 80px var(--section-pad-x) 60px;
        position: relative;
    }

    .cform__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 80px;
        align-items: start;
        position: relative;
    }

    .cform__side {
        position: sticky;
        top: calc(var(--header-height) + 24px);
    }

    .cform__side-title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 5vw, 56px);
        line-height: 1;
        margin: 12px 0 24px;
        letter-spacing: -0.03em;
    }

    .cform__side-title em {
        font-style: italic;
        color: var(--accent);
    }

    .cform__side-body {
        font-size: 15px;
        line-height: 1.55;
        color: var(--ink-2);
        margin: 0;
    }

    .cform__email {
        display: inline-block;
        margin-top: 12px;
        font-size: 14px;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 2px;
        text-decoration: none;
        color: var(--ink);
    }

    .cform__avail {
        margin-top: 32px;
        padding: 14px 16px;
        background: var(--bg-2);
        border: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-2);
        line-height: 1.6;
    }

    .cform__avail-head {
        color: var(--ink-3);
        margin: 0;
    }

    .cform__avail-body {
        margin: 4px 0 0;
    }

    .cform__avail-dot {
        color: var(--accent);
    }

    .cform__row {
        display: grid;
        gap: 40px;
    }

    .cform__row--two {
        grid-template-columns: 1fr 1fr;
    }

    .cform__row--meta {
        grid-template-columns: 1fr auto;
        gap: 12px;
        margin-top: 6px;
        align-items: center;
    }

    .cform__field {
        display: flex;
        flex-direction: column;
    }

    .cform__field + .cform__field,
    .cform__row + .cform__field,
    .cform__field + .cform__row,
    .cform__row + .cform__row {
        margin-top: 32px;
    }

    .cform__form > .cform__field:first-of-type,
    .cform__form > .cform__row:first-of-type {
        margin-top: 0;
    }

    .cform__label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .cform__input {
        width: 100%;
        padding: 14px 0;
        border: none;
        border-bottom: 1px solid var(--rule-2);
        background: transparent;
        font-family: var(--font-sans);
        font-size: 17px;
        color: var(--ink);
        outline: none;
        border-radius: 0;
    }

    .cform__input::placeholder {
        color: var(--ink-3);
    }

    .cform__input:focus {
        border-bottom-color: var(--ink);
    }

    .cform__select {
        appearance: none;
        cursor: pointer;
        padding-right: 24px;
    }

    .cform__textarea {
        resize: vertical;
        min-height: 140px;
        line-height: 1.5;
    }

    .cform__err {
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 11px;
        margin-top: 6px;
        min-height: 1em;
    }

    .cform__err:empty {
        margin-top: 0;
        min-height: 0;
    }

    .cform__count {
        font-size: 11px;
        color: var(--ink-3);
    }

    .cform__chips {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .cform__chip {
        padding: 10px 16px;
        border: 1px solid var(--rule-2);
        background: transparent;
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 12px;
        cursor: pointer;
        transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
    }

    .cform__chip.is-selected {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
    }

    .cform__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 48px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cform__note {
        font-size: 11px;
        color: var(--ink-3);
    }

    .cform__submit {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        background: var(--ink);
        color: var(--bg);
        padding: 18px 28px;
        border: none;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 14px;
        transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
    }

    .cform__submit:hover {
        transform: translateY(-2px);
    }

    .cform__submit[disabled] {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .cform__submit-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .cform__submit:hover .cform__submit-arrow {
        transform: translateX(6px);
    }

    /* success state */
    .cform__success {
        grid-column: 1 / -1;
        position: relative;
        padding: 0;
        max-width: 720px;
    }

    .cform__success-glyph {
        position: absolute;
        left: -40px;
        top: -20px;
        color: var(--ink);
        opacity: 0.6;
        pointer-events: none;
    }

    .cform__success-label {
        position: relative;
        color: var(--accent);
        margin: 0 0 24px;
    }

    .cform__success-title {
        position: relative;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(48px, 6vw, 80px);
        line-height: 0.95;
        letter-spacing: -0.035em;
        margin: 0;
    }

    .cform__success-title em {
        font-style: italic;
        color: var(--accent);
    }

    .cform__success-body {
        position: relative;
        font-size: 18px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 28px 0 0;
        max-width: 540px;
    }

    .cform__success-email {
        background: var(--bg-2);
        padding: 2px 6px;
    }

    .cform__again {
        margin-top: 32px;
        background: transparent;
        border: 1px solid var(--rule-2);
        color: var(--ink);
        padding: 14px 22px;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 13px;
        transition: background 0.2s var(--ease);
    }

    .cform__again:hover {
        background: var(--bg-2);
    }

    @media (max-width: 900px) {
        .cform {
            padding: 40px var(--section-pad-x-mobile);
        }

        .cform__inner {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .cform__side {
            position: static;
        }

        .cform__row--two {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .cform__field + .cform__field,
        .cform__row + .cform__field,
        .cform__field + .cform__row,
        .cform__row + .cform__row {
            margin-top: 24px;
        }
    }
</style>

<script src="/scripts/contact.js" defer></script>
