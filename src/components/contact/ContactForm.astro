<div class="contact-card">
    <form class="contact-form" id="contact-form">
        <!-- Honeypot (spam trap) -->
        <label class="honeypot" aria-hidden="true">
            Do not fill
            <input type="text" name="company" tabindex="-1" autocomplete="off"/>
        </label>

        <div class="contact-form__field">
            <label for="contact-name" class="contact-form__label">Name</label>
            <input
                    class="contact-form__input"
                    type="text"
                    name="name"
                    id="contact-name"
                    placeholder="What should we call you?"
                    autocomplete="name"
            />
        </div>

        <div class="contact-form__field">
            <label for="contact-email" class="contact-form__label">
                Email <span class="contact-form__required">*</span>
            </label>
            <input
                    class="contact-form__input"
                    type="email"
                    name="email"
                    id="contact-email"
                    placeholder="you@mail.com"
                    required
                    autocomplete="email"
            />
        </div>

        <div class="contact-form__field">
            <label for="contact-message" class="contact-form__label">
                Message <span class="contact-form__required">*</span>
            </label>
            <textarea
                    class="contact-form__textarea"
                    name="message"
                    id="contact-message"
                    placeholder="Tell us about your project..."
                    rows="4"
                    required
            ></textarea>
        </div>

        <div class="contact-form__footer">
            <p class="contact-form__note">
                You can also email us at <br>
                <a href="mailto:hello@intrebit.com">hello@intrebit.com</a>
            </p>
            <button class="contact-form__submit" type="submit">
                Send message
            </button>
        </div>
    </form>

    <div class="contact-form__status" id="contact-status" aria-live="polite"></div>
</div>

<style>
    /* Card wrapper */
    .contact-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.75rem;
        background: var(--surface);
    }

    /* Labels — use tokens, not rgba(white/black) */
    .contact-form__label {
        font-size: 0.875rem;
        font-weight: 500;
        color: color-mix(in srgb, var(--text) 70%, transparent); /* stronger than --text-muted */
    }

    /* Inputs */
    .contact-form__input,
    .contact-form__textarea {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        font-size: 0.9375rem;
        font-family: inherit;
        line-height: 1.5;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    .contact-form__input::placeholder,
    .contact-form__textarea::placeholder {
        color: color-mix(in srgb, var(--text) 45%, transparent);
    }

    .contact-form__input:hover,
    .contact-form__textarea:hover {
        border-color: color-mix(in srgb, var(--text) 22%, var(--border));
    }

    .contact-form__input:focus,
    .contact-form__textarea:focus {
        outline: none;
        border-color: color-mix(in srgb, var(--text) 38%, var(--border));
        background: var(--surface-strong);
    }

    /* Note text — bump contrast */
    .contact-form__note {
        font-size: 0.8125rem;
        color: color-mix(in srgb, var(--text) 70%, transparent);
        margin: 0;
    }

    /* Inline link must not rely on color only */
    .contact-form__note a {
        color: var(--text);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        text-decoration-color: color-mix(in srgb, var(--text) 45%, transparent);
        transition: text-decoration-color 0.15s var(--ease), color 0.15s var(--ease);
    }

    .contact-form__note a:hover {
        text-decoration-color: currentColor;
    }

    .contact-form__footer {
        margin-top: var(--s-5);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Button */
    .contact-form__submit {
        padding: 0.625rem 1rem;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--surface-strong);
        color: var(--text);
        font-size: 0.875rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: transform 0.16s var(--ease), background 0.15s ease;
        white-space: nowrap;
    }

    .contact-form__submit:hover {
        transform: translateY(-1px);
        background: color-mix(in srgb, var(--surface-strong) 70%, var(--text) 6%);
    }

    /* Focus ring */
    .contact-form__input:focus-visible,
    .contact-form__textarea:focus-visible,
    .contact-form__submit:focus-visible,
    .contact-form__note a:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--text) 35%, transparent);
        outline-offset: 3px;
    }
</style>
<script src="/scripts/contact.js" defer></script>