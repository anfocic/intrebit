---
import { contact } from "../../config/copy.ts";

const { form } = contact;
const f = form.fields;
---

<section class="cform" aria-label="Contact form" data-reveal>
    <div class="cform__inner">
        <form class="cform__form" id="contact-form" method="post" novalidate>
            <label class="honeypot" aria-hidden="true">
                Do not fill
                <input
                    type="text"
                    name="company_hp"
                    tabindex="-1"
                    autocomplete="off"
                />
            </label>

            <div class="cform__row cform__row--two">
                <div class="cform__field">
                    <label class="cform__label" for="cf-name"
                        >{f.name.label}</label
                    >
                    <input
                        class="cform__input"
                        id="cf-name"
                        name="name"
                        placeholder={f.name.placeholder}
                        autocomplete="name"
                        required
                    />
                    <div class="cform__err" data-err-for="name"></div>
                </div>
                <div class="cform__field">
                    <label class="cform__label" for="cf-email"
                        >{f.email.label}</label
                    >
                    <input
                        class="cform__input"
                        id="cf-email"
                        name="email"
                        type="email"
                        placeholder={f.email.placeholder}
                        autocomplete="email"
                    />
                    <div class="cform__err" data-err-for="email"></div>
                </div>
            </div>

            <div class="cform__field">
                <label class="cform__label" for="cf-message"
                    >{f.message.label}</label
                >
                <textarea
                    class="cform__input cform__textarea"
                    id="cf-message"
                    name="message"
                    placeholder={f.message.placeholder}></textarea>
                <div class="cform__err" data-err-for="message"></div>
            </div>

            <div class="cform__footer">
                <div class="cform__contact">
                    <a
                        class="cform__email mono"
                        href="/contact"
                        data-email-user={form.email.split("@")[0]}
                        data-email-host={form.email.split("@")[1]}
                        >Email us</a
                    >
                    <span class="cform__reply mono"
                        >We reply the same day.</span
                    >
                </div>
                <button
                    type="submit"
                    class="cform__submit"
                >
                    <span data-submit-label>{form.submit}</span>
                    <span class="cform__submit-arrow">→</span>
                </button>
            </div>
        </form>

        <div class="cform__success is-hidden" id="cform-success">
            <h2 class="cform__success-title">
                {form.success.titleStart}
                <span data-success-name>friend</span>.<br />
                <Fragment set:html={form.success.titleEnd} />
            </h2>
            <p class="cform__success-body">
                {form.success.body.split("{email}")[0]}
                <span class="mono cform__success-email" data-success-email
                    >you</span
                >
                {form.success.body.split("{email}")[1]}
            </p>
            <button type="button" class="cform__again" data-send-another
                >{form.success.again}</button
            >
        </div>
    </div>
</section>

<style>
    .cform {
        padding: 80px var(--section-pad-x) 60px;
        position: relative;
    }

    .cform__inner {
        max-width: 760px;
        margin: 0 auto;
        position: relative;
        display: grid;
        grid-template-areas: "stack";
    }

    .cform__form,
    .cform__success {
        grid-area: stack;
        transition: opacity 0.6s var(--ease), transform 0.7s var(--ease);
    }

    .cform__form.is-hidden,
    .cform__success.is-hidden {
        opacity: 0;
        transform: translateY(12px);
        pointer-events: none;
    }

    .cform__avail-dot {
        color: var(--accent);
    }

    .cform__row {
        display: grid;
        gap: 40px;
    }

    .cform__row--two {
        grid-template-columns: 1fr 1fr;
    }

    .cform__row--meta {
        grid-template-columns: 1fr auto;
        gap: 12px;
        margin-top: 6px;
        align-items: center;
    }

    .cform__field {
        display: flex;
        flex-direction: column;
    }

    .cform__form > .cform__field + .cform__field,
    .cform__form > .cform__row + .cform__field,
    .cform__form > .cform__field + .cform__row,
    .cform__form > .cform__row + .cform__row {
        margin-top: 32px;
    }

    .cform__label {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--ink-3);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 12px;
        transition: color 0.2s var(--ease);
    }

    .cform__input {
        width: 100%;
        padding: 16px 0;
        border: none;
        border-bottom: 1px solid var(--rule-2);
        background: transparent;
        font-family: var(--font-sans);
        font-size: 20px;
        color: var(--ink);
        outline: none;
        border-radius: 0;
        transition: border-bottom-color 0.2s var(--ease);
    }

    .cform__input::placeholder {
        color: var(--ink-3);
    }

    .cform__input:focus {
        border-bottom-color: var(--accent);
    }

    .cform__field:focus-within .cform__label {
        color: var(--accent);
    }

    .cform__field.is-shake {
        animation: cform-shake 0.5s var(--ease);
    }

    @keyframes cform-shake {
        0%, 100% { transform: translateX(0); }
        15% { transform: translateX(-8px); }
        30% { transform: translateX(6px); }
        45% { transform: translateX(-5px); }
        60% { transform: translateX(4px); }
        75% { transform: translateX(-2px); }
        90% { transform: translateX(1px); }
    }

    .cform__select {
        appearance: none;
        cursor: pointer;
        padding-right: 24px;
    }

    .cform__textarea {
        resize: vertical;
        min-height: 140px;
        line-height: 1.5;
    }

    .cform__err {
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 11px;
        margin-top: 6px;
        min-height: 1em;
    }

    .cform__err:empty {
        margin-top: 0;
        min-height: 0;
    }

    .cform__count {
        font-size: 11px;
        color: var(--ink-3);
    }

    .cform__chips {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .cform__chip {
        padding: 10px 16px;
        border: 1px solid var(--rule-2);
        background: transparent;
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 12px;
        cursor: pointer;
        transition:
            background 0.2s var(--ease),
            color 0.2s var(--ease),
            border-color 0.2s var(--ease);
    }

    .cform__chip.is-selected {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
    }

    .cform__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        gap: 24px;
        flex-wrap: wrap;
    }

    .cform__contact {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .cform__email {
        font-size: 14px;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 1px;
        align-self: flex-start;
        transition: color 0.2s var(--ease);
        background-image: linear-gradient(var(--accent), var(--accent));
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: color 0.2s var(--ease), background-size 0.3s var(--ease);
    }

    .cform__email:hover {
        color: var(--accent);
        background-size: 100% 1px;
    }

    .cform__reply {
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.02em;
    }

    .cform__submit {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--ink);
        color: var(--bg);
        padding: 12px 20px;
        border: none;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 13px;
        transition:
            transform 0.25s var(--ease),
            opacity 0.25s var(--ease);
    }

    .cform__submit:hover {
        transform: translateY(-2px);
    }

    .cform__submit[disabled] {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .cform__submit-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .cform__submit:hover .cform__submit-arrow {
        transform: translateX(6px);
    }

/* success state */
    .cform__success {
        grid-column: 1 / -1;
        position: relative;
        padding: 0;
        max-width: 720px;
        text-align: center;
    }

    .cform__success-title {
        position: relative;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(48px, 6vw, 80px);
        line-height: 0.95;
        letter-spacing: -0.035em;
        margin: 0 auto;
    }

    .cform__success-glyph {
        position: absolute;
        left: -40px;
        top: -20px;
        color: var(--ink);
        opacity: 0.6;
        pointer-events: none;
    }

    .cform__success-title em {
        font-style: italic;
        color: var(--accent);
    }

    .cform__success-body {
        position: relative;
        font-size: 18px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 28px auto 0;
        max-width: 540px;
    }

    .cform__success-email {
        background: var(--bg-2);
        padding: 2px 6px;
    }

    .cform__again {
        margin: 32px auto 0;
        background: transparent;
        border: 1px solid var(--rule-2);
        color: var(--ink);
        padding: 14px 22px;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 13px;
        transition: background 0.2s var(--ease);
        display: block;
    }

    .cform__again:hover {
        background: var(--bg-2);
    }

    @media (max-width: 900px) {
        .cform {
            padding: 40px var(--section-pad-x-mobile);
        }

        .cform__row--two {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .cform__field + .cform__field,
        .cform__row + .cform__field,
        .cform__field + .cform__row,
        .cform__row + .cform__row {
            margin-top: 24px;
        }

        .cform__footer {
            flex-wrap: nowrap;
            align-items: center;
            gap: 16px;
        }

        .cform__contact {
            min-width: 0;
            flex: 1;
        }

        .cform__email {
            font-size: 13px;
        }

        .cform__reply {
            display: none;
        }

        .cform__submit {
            flex-shrink: 0;
        }
    }
</style>

<script src="/scripts/contact.js?v=4" defer></script>
