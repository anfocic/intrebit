---
const items = [
    {
        title: "Email",
        content: `<a href="mailto:hello@intrebit.com">hello@intrebit.com</a>`,
    },
    {
        title: "Office",
        content: "We don't have one. We're distributed across time zones.",
    },
    {
        title: "Response Time",
        content: "Usually within 24 hours.",
    },
];
---

<div class="info">
    {items.map((item) => (
            <div class="card info__card">
                <h3>{item.title}</h3>
                <p set:html={item.content} />
            </div>
    ))}
</div>

<style>
    .info {
        display: grid;
        gap: 1.25rem;
    }

    .info__card {
        padding: 1.75rem;
    }

    .info__card h3 {
        margin-bottom: 0.75rem;
    }

    .info__card p {
        margin: 0;
        color: var(--text-muted);
    }

    .info__card a {
        color: var(--text);
        font-weight: 650;
        text-decoration: none;
    }

    .info__card a:hover {
        text-decoration: underline;
    }
</style>