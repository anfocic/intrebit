---
const items = [
    ["01 / Include", "What you've tried, deadline, budget range."],
    ["02 / Expect", "A reply within a day. A couple of clarifying questions."],
    ["03 / Then", "A proposal — or an honest “we're not the right fit.”"],
];
---

<section class="wti" aria-label="What to include" data-reveal data-reveal-stagger>
    {items.map(([t, b]) => (
        <div class="wti__item">
            <p class="mono wti__label">{t}</p>
            <p class="wti__body">{b}</p>
        </div>
    ))}
</section>

<style>
    .wti {
        max-width: var(--container-width);
        margin: 0 auto;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

    .wti__item {
        padding: 28px 32px;
        border-right: 1px solid var(--rule);
    }

    .wti__item:last-child {
        border-right: none;
    }

    .wti__label {
        font-size: 11px;
        color: var(--ink-3);
        margin: 0;
    }

    .wti__body {
        font-size: 15px;
        margin: 12px 0 0;
        color: var(--ink-2);
        line-height: 1.45;
    }

    @media (max-width: 900px) {
        .wti {
            grid-template-columns: 1fr;
        }

        .wti__item {
            padding: 20px 22px;
            border-right: none;
            border-bottom: 1px solid var(--rule);
        }

        .wti__item:last-child {
            border-bottom: none;
        }
    }
</style>
