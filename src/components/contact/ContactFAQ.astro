---
import GridGlyph from "../shared/glyphs/GridGlyph.astro";

const items = [
    ["How fast do you reply?", "Usually within a few hours. Always within one business day."],
    ["Do you do hourly work?", "No. We scope projects up front and bill a fixed price. If something's truly open-ended, we'll do a small paid discovery first."],
    ["Where are you based?", "Europe, GMT+1. We have clients from Lisbon to Tallinn and have worked with US East Coast teams comfortably."],
    ["Will you sign an NDA?", "Yes. Send yours, or we can use a simple mutual one."],
    ["Can you take over something we already started?", "Often, yes. Send a description of what's there and we'll tell you straight if it's a fit."],
];
---

<section class="faq" aria-label="Frequently asked questions" data-reveal>
    <div class="faq__glyph" aria-hidden="true">
        <GridGlyph size={120}/>
    </div>

    <div class="faq__inner">
        <div class="faq__intro">
            <p class="label">— FAQ</p>
            <h2 class="faq__heading">
                Things people<br/>
                <em>usually ask.</em>
            </h2>
        </div>

        <div class="faq__list">
            {items.map(([q, a], i) => (
                <details class="faq__item" open={i === 0}>
                    <summary class="faq__q">
                        <span>{q}</span>
                        <span class="mono faq__toggle" aria-hidden="true">+</span>
                    </summary>
                    <p class="faq__a">{a}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<style>
    .faq {
        position: relative;
        overflow: hidden;
        padding: 80px var(--section-pad-x);
        background: var(--bg-2);
        border-top: 1px solid var(--rule);
    }

    .faq__glyph {
        position: absolute;
        left: var(--section-pad-x);
        bottom: 40px;
        color: var(--ink);
        pointer-events: none;
    }

    .faq__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 80px;
        position: relative;
    }

    .faq__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 6vw, 64px);
        line-height: 1;
        margin: 12px 0 0;
        letter-spacing: -0.03em;
    }

    .faq__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .faq__list {
        border-top: 1px solid var(--rule);
    }

    .faq__item {
        border-bottom: 1px solid var(--rule);
    }

    .faq__q {
        list-style: none;
        cursor: pointer;
        padding: 20px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-display);
        font-size: 22px;
        letter-spacing: -0.015em;
        color: var(--ink);
        gap: 16px;
    }

    .faq__q::-webkit-details-marker {
        display: none;
    }

    .faq__toggle {
        font-size: 0;
        color: var(--ink-3);
        font-family: var(--font-mono);
    }

    .faq__toggle::before {
        font-size: 18px;
        content: "+";
    }

    .faq__item[open] .faq__toggle::before {
        content: "−";
    }

    .faq__a {
        margin: 0 0 20px;
        font-size: 15px;
        line-height: 1.55;
        color: var(--ink-2);
        max-width: 600px;
    }

    @media (max-width: 900px) {
        .faq {
            padding: 56px var(--section-pad-x-mobile);
        }

        .faq__glyph {
            display: none;
        }

        .faq__inner {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .faq__q {
            font-size: 18px;
        }
    }
</style>
