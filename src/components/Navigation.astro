---
import {getPathname} from '../utils/helpers';
import Link from "./shared/Link.astro";

const pathname = getPathname(Astro.url);
---

<nav class="scandi-nav">
    <div class="nav-content">
        <a href="/" class="nav-logo">
            Intre<span class="nav-logo-accent">bit</span>
        </a>
        <ul class="nav-links">
            <Link className=`${pathname === '/' ? 'active' : ''}` path="/" label="Home"/>
            <Link className=`${pathname === '/' ? 'active' : ''}` path="/services" label="Services" />
            <Link className=`${pathname === '/' ? 'active' : ''}` path="/about" label="About"/>
            <Link className=`${pathname === '/' ? 'active' : ''}` path="/contact" label="Contact"/>
            <Link className=`${pathname === '/' ? 'active' : ''}` path="/blog" label="Blog"/>
        </ul>
    </div>
</nav>
