---
interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = "Blog",
    subtitle = "Thoughts on software, work, and building things that don't suck.",
} = Astro.props;
---

<section class="section">
    <div class="container hero">
        <h1>{title}</h1>
        <p class="hero__subtitle">{subtitle}</p>
    </div>
</section>

<style>
    .section {
        padding: 5.5rem 0 2.5rem;
    }

    .hero {
        text-align: center;
        max-width: 720px;
    }

    .hero__subtitle {
        margin-top: 1.25rem;
        font-size: 1.1rem;
        color: var(--text-muted);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }
</style>