---
import TagPill from "./TagPill.astro";
import {formatDate} from "../../utils/helpers.ts";

interface Props {
    title: string;
    author?: string;
    pubDate: string | Date;
    tags?: string[];
    image?: string;
}

const {
    title,
    author = "Intrebit",
    pubDate,
    tags = [],
    image,
} = Astro.props;
---

<article class="post">
    <header class="post__header">
        {tags.length > 0 && (
                <div class="post__tags">
                    {tags.map((tag) => (
                            <TagPill tag={tag} />
                    ))}
                </div>
        )}

        <h1 class="post__title">{title}</h1>

        <div class="post__meta">
            <span class="post__author">{author}</span>
            <span class="post__date">{formatDate(pubDate)}</span>
        </div>
    </header>

    {image && (
            <img class="post__image" src={image} alt={title} loading="lazy" />
    )}

    <div class="prose">
        <slot />
    </div>

    <footer class="post__footer">
        <a href="/blog" class="post__back">← Back to blog</a>
    </footer>
</article>

<style>
    .post {
        max-width: 820px;
        margin: 0 auto;
        padding: 5.5rem 2rem 6rem;
    }

    .post__header {
        margin-bottom: 2.5rem;
    }

    .post__tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

    .post__title {
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        line-height: 1.15;
    }

    .post__meta {
        display: flex;
        gap: 2rem;
        font-size: 0.95rem;
        color: var(--text-muted);
    }

    .post__image {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: var(--radius-soft);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-soft);
        margin-bottom: 3rem;
    }

    .post__footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .post__back {
        color: var(--accent);
        font-weight: 650;
        text-decoration: none;
    }

    .post__back:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .post {
            padding: 4rem 1.25rem 5rem;
        }

        .post__image {
            height: 280px;
        }

        .post__meta {
            gap: 1rem;
            flex-wrap: wrap;
        }
    }
</style>