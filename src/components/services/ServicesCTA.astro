---
import {services} from "../../config/copy.ts";

const c = services.cta;
---

<section class="cta">
    <div class="container">
        <div class="cta-card">
            <h2>{c.heading}</h2>
            <p>{c.body}</p>
            <a class="btn btn--primary" href={c.button.href}>{c.button.label}</a>
        </div>
    </div>
</section>

<style>
    .cta {
        padding: 4rem 0 6rem;
    }

    .container {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .cta-card {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.5rem;
        border-radius: 22px;
        background: var(--surface);
        border: 1px solid var(--border);
        text-align: center;
        box-shadow: var(--shadow-card);
    }

    .cta-card h2 {
        margin: 0 0 0.75rem;
        font-size: 1.8rem;
    }

    .cta-card p {
        margin: 0 0 1.8rem;
        color: var(--text-muted);
        font-size: 1.05rem;
    }

    @media (max-width: 520px) {
        .cta-card {
            padding: 1.8rem;
        }
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.5rem;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn--primary {
        background: var(--bg);
        color: var(--text-muted);
    }

    .btn--primary:hover {
        transform: translateY(-1px);
        color: var(--text);
        box-shadow: var(--text-muted);
    }

    .btn--primary:active {
        transform: translateY(0);
    }
</style>
