---
// src/components/services/ServicesCTA.astro
---

<section class="cta">
    <div class="container">
        <div class="cta-card">
            <h2>Open for new work.</h2>
            <p>If you need reliable software or smoother ops, we'll reply fast.</p>
            <a class="btn btn--primary" href="/#contact">Let's talk</a>
        </div>
    </div>
</section>

<style>
    .cta {
        padding: 4rem 0 6rem;
    }

    .container {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .cta-card {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.5rem;
        border-radius: 22px;
        background: var(--surface);
        border: 1px solid var(--border);
        text-align: center;
        box-shadow: var(--shadow-card);
    }

    .cta-card h2 {
        margin: 0 0 0.75rem;
        font-size: 1.8rem;
    }

    .cta-card p {
        margin: 0 0 1.8rem;
        color: var(--text-muted);
        font-size: 1.05rem;
    }

    @media (max-width: 520px) {
        .cta-card {
            padding: 1.8rem;
        }
    }
</style>