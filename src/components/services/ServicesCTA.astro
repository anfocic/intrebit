---
interface Props {
    heading?: string;
    subtitle?: string;
}

const {
    heading = "Ready to transform your business?",
    subtitle = "Let's discuss how our technology solutions can drive your success.",
} = Astro.props;
---

<section class="section section--soft">
    <div class="container cta">
        <h2>{heading}</h2>
        <p class="cta__subtitle">{subtitle}</p>

        <a href="/contact" class="cta__button">
            <button class="btn btn--primary btn--lg">Get in Touch</button>
        </a>
    </div>
</section>

<style>
    .section {
        padding: 5.5rem 0;
    }

    .section--soft {
        background: rgba(0, 0, 0, 0.01);
        border-top: 1px solid var(--border);
    }

    .cta {
        text-align: center;
        max-width: 720px;
    }

    .cta__subtitle {
        margin-top: 1rem;
        font-size: 1.1rem;
        color: var(--text-muted);
    }

    .cta__button {
        display: inline-flex;
        margin-top: 2rem;
    }
</style>