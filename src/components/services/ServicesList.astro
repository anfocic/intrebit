---
// src/components/services/ServicesList.astro
import ServiceCard from "./ServiceCard.astro";

const services = [
    {
        chip: "PRODUCT",
        title: "Custom Software",
        description:
            "Web apps, mobile apps, APIs—whatever you need. Built right, not rushed.",
    },
    {
        chip: "TEAM",
        title: "Outsourcing",
        description:
            "Need more hands on deck? We've got experienced developers, designers, and QA engineers ready to roll.",
    },
    {
        chip: "SYSTEMS",
        title: "Infrastructure & Consulting",
        description:
            "Cloud architecture, DevOps, security—the boring stuff that actually matters.",
    },
    {
        chip: "OPEN SOURCE",
        title: "Open Source",
        description:
            "We ship tools in public, contribute back, and build reusable components so your product isn’t reinventing the wheel.",
    },
];
---

<section class="services" aria-label="Services preview">
    <div class="container">


        <div class="services__grid">
            {services.map((s) => (
                    <ServiceCard chip={s.chip} title={s.title} description={s.description} />
            ))}
        </div>
    </div>
</section>

<style>
    .services {
        padding: 6rem 0;
        border-top: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg) 96%, var(--accent) 4%);
    }

    :root[data-theme="dark"] .services {
        background: rgba(255, 255, 255, 0.01);
    }

    .services__header {
        text-align: center;
        margin-bottom: 3.75rem;
    }

    .services__title {
        margin: 0 0 0.85rem;
        font-size: clamp(2rem, 1.6rem + 1.2vw, 2.75rem);
        font-weight: 850;
        letter-spacing: -0.04em;
        color: var(--text);
    }

    .services__subtitle {
        margin: 0 auto;
        font-size: 1.1rem;
        color: var(--text-muted);
        max-width: 600px;
    }

    .services__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2.25rem;
        align-items: stretch;
    }

    @media (max-width: 980px) {
        .services__grid {
            grid-template-columns: 1fr;
            gap: 1.75rem;
        }
    }

    @media (max-width: 520px) {
        .services {
            padding: 4.25rem 0;
        }

        .services__header {
            margin-bottom: 2.75rem;
        }
    }
</style>