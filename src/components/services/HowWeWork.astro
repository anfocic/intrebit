---
import ProcessIcon from "../shared/ProcessIcon.astro";
const steps = [
    {
        icon: "phone" as const,
        title: "The Call",
        description: "You complain. We nod.",
        detail:
            "We talk through what's broken, what's annoying you daily, and what working properly looks like — so we're solving the right problem.",
    },
    {
        icon: "clipboard-list" as const,
        title: "The Plan",
        description: "We hand you the plan. You're mildly impressed.",
        detail:
            "You get a clear scope, timeline, and fixed cost — so you know what's being built, what it will do, and what it won't.",
    },
    {
        icon: "hammer" as const,
        title: "The Build",
        description: "This is the part where magic happens.",
        detail:
            "We build in small releases, keep you updated weekly, and show progress early — so nothing disappears into a black hole.",
    },
    {
        icon: "rocket" as const,
        title: "The Launch",
        description: "No drama here. Carry on.",
        detail:
            "We handle the deployment, set up monitoring, and make sure everything works in the real world — not just on our laptops.",
    },
    {
        icon: "life-buoy" as const,
        title: "The Aftermath",
        description: "We are here for you — just don't call before 10AM.",
        detail:
            "Maintenance, fixes, and improvements when things break or need adjusting — so you're not stuck dealing with the tech alone.",
    },
];
---

<section class="process" id="process">
    <div class="container">
        <header class="process__header">
            <h2>The Process</h2>
            <p>Simple steps. Clear costs. You own the code.</p>
        </header>

        <div class="process__list" role="list">
            {steps.map((step, i) => (
                    <article class="process__step" role="listitem">
                        <!-- Centered divider (not on first item) -->
                        {i > 0 && <div class="process__divider" aria-hidden="true" />}

                        <div class="process__content">
                            <div class="process__icon-wrap">
                                <ProcessIcon icon={step.icon} size={24} />
                            </div>

                            <div class="process__body">
                                <h3 class="process__title">{step.title}</h3>
                                <p class="process__desc">{step.description}</p>
                                <p class="process__detail">{step.detail}</p>
                            </div>
                        </div>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .process {
        padding: 6rem 0 7rem;
    }

    .container {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header */
    .process__header {
        text-align: center;
        max-width: 740px;
        margin: 0 auto 3.75rem;
    }

    .process__header h2 {
        margin: 0 0 1rem;
        font-size: clamp(2rem, 3vw, 2.5rem);
        color: var(--text);
        letter-spacing: -0.03em;
    }

    .process__header p {
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.65;
        color: var(--text-muted);
    }

    /* List */
    .process__list {
        max-width: 920px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
    }

    /* Centered divider */
    .process__divider {
        width: 80px;
        height: 1px;
        background: var(--border);
        margin: 0 auto;
    }

    /* Step */
    .process__step {
        position: relative;
    }

    .process__content {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 1.5rem;
        padding: 2.5rem 1rem;
        border-radius: var(--radius-soft, 14px);
        align-items: start;
        transition: background 280ms var(--ease, ease);
    }

    .process__content:hover {
        background: color-mix(in srgb, var(--surface) 50%, transparent);
    }

    /* Icon container */
    .process__icon-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        color: var(--text-muted);
        background: color-mix(in srgb, var(--surface) 84%, var(--text) 4%);
        border: 1px solid var(--border);
        transition:
                color 280ms var(--ease, ease),
                border-color 280ms var(--ease, ease),
                box-shadow 280ms var(--ease, ease);
    }

    /* Hover: icon gets a glow */
    .process__content:hover .process__icon-wrap {
        color: var(--text);
        border-color: color-mix(in srgb, var(--text) 25%, var(--border));
        box-shadow:
                0 0 0 4px color-mix(in srgb, var(--text) 6%, transparent),
                0 8px 24px color-mix(in srgb, var(--text) 8%, transparent);
    }

    /* Body */
    .process__body {
        padding-top: 0.25rem;
    }

    .process__title {
        margin: 0 0 0.5rem;
        font-size: clamp(1.25rem, 2vw, 1.45rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .process__desc {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.5;
        color: var(--text-muted);
        font-weight: 500;
    }

    .process__detail {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--text-muted);
        max-width: 58ch;

        /* Hidden by default on desktop */
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        transition:
                opacity 250ms var(--ease, ease),
                max-height 250ms var(--ease, ease),
                margin 250ms var(--ease, ease);
    }

    /* Reveal on hover */
    .process__content:hover .process__detail {
        opacity: 1;
        max-height: 200px;
        margin: 0.75rem 0 0;
    }

    /* Focus states for accessibility (keyboard users) */
    .process__content:focus-within .process__icon-wrap {
        color: var(--text);
        border-color: color-mix(in srgb, var(--text) 25%, var(--border));
        box-shadow:
                0 0 0 4px color-mix(in srgb, var(--text) 6%, transparent),
                0 8px 24px color-mix(in srgb, var(--text) 8%, transparent);
    }

    .process__content:focus-within .process__detail {
        opacity: 1;
        max-height: 200px;
        margin: 0.75rem 0 0;
    }

    /* Mobile — no hover, always show detail */
    @media (max-width: 720px) {
        .process {
            padding: 4rem 0 5rem;
        }

        .process__divider {
            width: 60px;
        }

        .process__content {
            grid-template-columns: 52px 1fr;
            gap: 1.25rem;
            padding: 2rem 0.5rem;
        }

        .process__icon-wrap {
            width: 44px;
            height: 44px;
            border-radius: 12px;
        }

        .process__icon-wrap :global(svg) {
            width: 20px;
            height: 20px;
        }

        .process__title {
            font-size: 1.15rem;
        }

        .process__desc {
            font-size: 1rem;
        }

        .process__detail {
            /* Always visible on mobile */
            opacity: 1;
            max-height: none;
            margin: 0.75rem 0 0;
            font-size: 0.9rem;
        }
    }

    /* Reduce motion */
    @media (prefers-reduced-motion: reduce) {
        .process__content,
        .process__icon-wrap,
        .process__detail {
            transition: none;
        }
    }
</style>