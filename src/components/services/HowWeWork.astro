---
const steps = [
    {
        icon: "phone",
        title: "Discovery",
        description: "A 30-minute call to understand what you need.",
        detail: "You explain the problem. We ask questions until we're sure we get it. No prep needed on your end.",
    },
    {
        icon: "clipboard-list",
        title: "Proposal",
        description: "A clear scope, timeline, and fixed price.",
        detail: "You'll know exactly what's being built, what it costs, and when it ships. No surprises.",
    },
    {
        icon: "hammer",
        title: "Build",
        description: "Weekly updates. Working software, not slide decks.",
        detail: "Every week you see progress. You can give feedback as we go, not after it's done.",
    },
    {
        icon: "rocket",
        title: "Launch",
        description: "We deploy, monitor, and make sure it works.",
        detail: "It goes live. We watch for issues so you don't have to.",
    },
    {
        icon: "life-buoy",
        title: "Support",
        description: "Something breaks? We fix it.",
        detail: "You message us directly—no tickets, no queue. We handle it.",
    },
];

const icons: Record<string, string> = {
    phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>`,
    "clipboard-list": `<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>`,
    hammer: `<path d="M15 12l-8.5 8.5a2.12 2.12 0 1 1-3-3L12 9"/><path d="M17.64 15L22 10.64"/><path d="m20.91 11.7-1.25-1.25a2.12 2.12 0 0 0-3 0l-1.25 1.25"/><path d="M14 6.5V5a2 2 0 0 0-2-2H9.5a2 2 0 0 0 0 4H12a2 2 0 0 1 2 2v1.5"/>`,
    rocket: `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>`,
    "life-buoy": `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="M4.93 4.93l4.24 4.24"/><path d="M14.83 14.83l4.24 4.24"/><path d="M14.83 9.17l4.24-4.24"/><path d="M9.17 14.83l-4.24 4.24"/>`,
};
---

<section class="process" id="process">
    <div class="process__container">
        <header class="process__header">
            <h2 class="process__title">How we work</h2>
            <p class="process__subtitle">
                Simple steps. Clear costs. You own the code.
            </p>
        </header>

        <div class="process__timeline">
            {
                steps.map((step, i) => (
                    <article class="step">
                        <div class="step__rail">
                            <div class="step__icon">
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    set:html={icons[step.icon]}
                                />
                            </div>
                            {i < steps.length - 1 && <div class="step__line" />}
                        </div>
                        <div class="step__body">
                            <h3 class="step__title">{step.title}</h3>
                            <p class="step__description">{step.description}</p>
                            <p class="step__detail">{step.detail}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .process {
        padding: 5rem 0;
    }

    .process__container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .process__header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .process__title {
        margin: 0 0 0.5rem;
        font-family: var(--font-brand, sans-serif);
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        font-weight: 750;
        letter-spacing: -0.03em;
        color: var(--text);
    }

    .process__subtitle {
        margin: 0;
        font-size: 1rem;
        color: var(--text-muted);
    }

    .process__timeline {
        max-width: 600px;
        margin: 0 auto;
    }

    /* Step */
    .step {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 1.25rem;
    }

    /* Rail: icon + line */
    .step__rail {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .step__icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--text) 4%, transparent);
        border: 1px solid var(--border);
        color: var(--text-muted);
        flex-shrink: 0;
        transition:
            color 0.2s ease,
            border-color 0.2s ease;
    }

    .step:hover .step__icon {
        color: var(--text);
        border-color: color-mix(in srgb, var(--text) 15%, var(--border));
    }

    .step__line {
        width: 1px;
        flex: 1;
        min-height: 24px;
        background: var(--border);
        margin: 0.75rem 0;
    }

    /* Body */
    .step__body {
        padding: 0.5rem 0 2rem;
    }

    .step__title {
        margin: 0 0 0.5rem;
        font-family: var(--font-brand, sans-serif);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
    }

    .step__description {
        margin: 0 0 0.5rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text);
        opacity: 0.9;
        line-height: 1.5;
    }

    .step__detail {
        margin: 0;
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* Last step: no extra padding */
    .step:last-child .step__body {
        padding-bottom: 0;
    }

    /* Responsive */
    @media (max-width: 600px) {
        .process {
            padding: 3.5rem 0;
        }

        .process__container {
            padding: 0 1.25rem;
        }

        .process__header {
            margin-bottom: 2.5rem;
        }

        .step {
            grid-template-columns: 36px 1fr;
            gap: 1rem;
        }

        .step__icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
        }

        .step__icon svg {
            width: 16px;
            height: 16px;
        }

        .step__body {
            padding: 0.25rem 0 1.5rem;
        }

        .step__title {
            font-size: 1rem;
        }

        .step__description {
            font-size: 0.9rem;
        }

        .step__detail {
            font-size: 0.825rem;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .step__icon {
            transition: none;
        }
    }
</style>
