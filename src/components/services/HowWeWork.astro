---
import ProcessIcon from "../shared/ProcessIcon.astro";

const steps = [
    {
        icon: "phone" as const,
        title: "The Call",
        description: "You talk. We ask annoying questions.",
        detail:
            "You explain the problem. We make sure we understand it."
    },
    {
        icon: "clipboard-list" as const,
        title: "The Plan",
        description: "We hand you the plan. You're mildly impressed.",
        detail:
            "You get a clear scope, timeline, and fixed cost — so you know what's being built, what it will do, and what it won't.",
    },
    {
        icon: "hammer" as const,
        title: "The Build",
        description: "We build. You see progress.",
        detail:
            "Every week you'll see what's done, what's next, and how it's looking. You won't have to guess."
    },
    {
        icon: "rocket" as const,
        title: "The Launch",
        description: "No drama here. Carry on.",
        detail:
            "It goes live. We watch it closely so you don't have to."
    },
    {
        icon: "life-buoy" as const,
        title: "The Aftermath",
        description: "We're here for you — just don't call before 10AM.",
        detail:
            "Something stops working at 2pm on a Tuesday? You message us, not Google."
    },
];
---

<section class="process" id="process">
    <div class="container">
        <header class="process__header">
            <h2>The Process</h2>
            <p>Simple steps. Clear costs. You own the code.</p>
        </header>

        <div class="process__timeline">
            {steps.map((step, i) => (
                    <article class="step" data-step>
                        <!-- Icon + Line -->
                        <div class="step__rail">
                            <div class="step__icon">
                                <ProcessIcon icon={step.icon} size={20}/>
                            </div>
                            {i < steps.length - 1 &&
                                    <div class="step__line"/>}
                        </div>

                        <!-- Content -->
                        <div class="step__body">
                            <button class="step__header" type="button" data-step-trigger aria-expanded="false">
                                <h3 class="step__title">{step.title}</h3>
                                <span class="step__chevron" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 9l6 6 6-6"/>
                                </svg>
                            </span>
                            </button>
                            <p class="step__desc">{step.description}</p>
                            <div class="step__detail" data-step-panel>
                                <p>{step.detail}</p>
                            </div>
                        </div>
                    </article>
            ))}
        </div>
    </div>
</section>

<script>
    function initProcess() {
        const steps = document.querySelectorAll('[data-step]');

        steps.forEach((step) => {
            const trigger = step.querySelector('[data-step-trigger]');
            const panel = step.querySelector('[data-step-panel]');

            if (!trigger || !panel) return;

            trigger.addEventListener('click', () => {
                const isOpen = step.classList.contains('is-open');

                // Close all others
                steps.forEach((s) => {
                    s.classList.remove('is-open');
                    const btn = s.querySelector('[data-step-trigger]');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                });

                // Toggle current
                if (!isOpen) {
                    step.classList.add('is-open');
                    trigger.setAttribute('aria-expanded', 'true');
                }
            });
        });
    }

    document.addEventListener('astro:page-load', initProcess);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcess);
    } else {
        initProcess();
    }
</script>

<style>
    .process {
        padding: 6rem 0;
    }

    .container {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header */
    .process__header {
        text-align: center;
        max-width: 600px;
        margin: 0 auto 4rem;
    }

    .process__header h2 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        color: var(--text);
        letter-spacing: -0.03em;
    }

    .process__header p {
        margin: 0;
        font-size: 1.05rem;
        color: var(--text-muted);
    }

    /* Timeline */
    .process__timeline {
        max-width: 540px;
        margin: 0 auto;
    }

    /* Step - simple grid: icon rail | content */
    .step {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 1.25rem;
    }

    /* Rail: icon + vertical line */
    .step__rail {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .step__icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        color: var(--text-muted);
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

    .step:hover .step__icon {
        color: var(--text);
        border-color: rgba(255, 255, 255, 0.15);
    }

    .step__line {
        width: 1px;
        flex: 1;
        background: var(--border);
        margin: 0.75rem 0;
        min-height: 20px;
    }

    /* Body */
    .step__body {
        padding: 0.5rem 0 2rem;
    }

    .step__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        text-align: left;
        color: inherit;
    }

    .step__title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
    }

    .step__chevron {
        color: var(--text-muted);
        transition: transform 0.2s ease;
    }

    .step.is-open .step__chevron {
        transform: rotate(180deg);
    }

    .step__desc {
        margin: 1.35rem 0;
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.5;
        max-height: 100px;
        opacity: 1;
        transition: all 0.25s ease;
    }

    .step.is-open .step__desc {
        max-height: 0;
        padding: 0.3rem;
        opacity: 0;
        margin: 0;
        overflow: hidden;
    }

    /* Detail - accordion */
    .step__detail {
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition: all 0.25s ease;
    }

    .step.is-open .step__detail {
        max-height: 150px;
        opacity: 1;
        margin-top: 0.75rem;
    }

    .step__detail p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-muted);
    }

    /* Desktop: hover reveals detail, hide chevron */
    @media (min-width: 721px) {
        .step__chevron {
            display: none;
        }

        .step__header {
            cursor: default;
        }

        .step__detail {
            max-height: 0;
            opacity: 0;
            margin-top: 0;
        }

        .step:hover .step__detail {
            max-height: 150px;
            opacity: 1;
            margin-top: 0.75rem;
        }
    }

    /* Mobile */
    @media (max-width: 720px) {
        .process {
            padding: 4rem 0;
        }

        .process__header {
            margin-bottom: 3rem;
        }

        .step {
            grid-template-columns: 36px 1fr;
            gap: 1rem;
        }

        .step__icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
        }

        .step__icon :global(svg) {
            width: 16px;
            height: 16px;
        }

        .step__body {
            padding: 0.25rem 0 1.5rem;
        }

        .step__title {
            font-size: 1rem;
        }

        .step__desc {
            font-size: 0.9rem;
        }

        .step__detail p {
            font-size: 0.85rem;
        }
    }

    /* Light mode */
    :global(:root[data-theme="light"]) .step__icon {
        background: rgba(0, 0, 0, 0.03);
    }

    :global(:root[data-theme="light"]) .step:hover .step__icon {
        border-color: rgba(0, 0, 0, 0.15);
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .step__icon,
        .step__chevron,
        .step__detail {
            transition: none;
        }
    }
</style>