---
interface Props {
    number: string;
    title: string;
    description: string;
}

const { number, title, description } = Astro.props;
---

<div class="how-card">
    <span class="how-card__num">{number}</span>
    <h3>{title}</h3>
    <p>{description}</p>
</div>

<style>
    .how-card {
        padding: 1.8rem 1.75rem;
        border-radius: 18px;
        background: var(--surface);
        border: 1px solid var(--border);
    }

    .how-card__num {
        display: inline-block;
        font-weight: 800;
        color: var(--text-muted);
        font-size: 0.85rem;
        letter-spacing: 0.12em;
        margin-bottom: 0.75rem;
    }

    .how-card h3 {
        margin: 0 0 0.6rem;
        font-size: 1.15rem;
    }

    .how-card p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.6;
    }

    @media (max-width: 900px) {
        .how-card {
            text-align: center;
        }
    }
</style>
