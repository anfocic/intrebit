---
import Chevron from "../shared/Chevron.astro";
---
<section class="services-hero">
    <div class="container services-hero__inner">
        <header class="services-hero__header hero-reveal">
            <h1 class="title reveal-1">Build it once.</h1>
            <h1 class="title reveal-2">Keep it working.</h1>

            <p class="subtitle reveal-3">
                You focus on the business. We'll make sure the software doesn't fall apart.
            </p>
        </header>
        <div class="chevron">

        </div>
        <Chevron target="services" delay="3.0s" />
    </div>
</section>

<style>
    .services-hero {
        position: relative;
        padding: 10rem 0;
        text-align: center;
        overflow: hidden;
    }

    .container {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .services-hero__inner {
        display: grid;
        place-items: center;
    }

    .services-hero__header {
        max-width: 760px;
    }

    .title {
        font-size: clamp(2.1rem, 4vw, 3.2rem);
        margin: 0;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text);
    }

    .subtitle {
        max-width: 650px;
        margin: 0 auto;
        padding-top: 2rem;
        font-size: 1.15rem;
        line-height: 1.65;
        color: var(--text-muted);
    }

    .chevron {
        padding-bottom: var(--s-11);

    }
    /* =========================================
       HERO REVEAL — staggered fade up + blur
       ========================================= */

    .hero-reveal > * {
        opacity: 0;
        transform: translateY(14px);
        filter: blur(12px);
        animation: heroReveal 700ms cubic-bezier(.2, .8, .2, 1) forwards;
        will-change: opacity, transform, filter;
    }

    /* Stagger: Title 1 → Title 2 → Subtitle */
    .hero-reveal .reveal-1 {
        animation-delay: 100ms;
    }

    .hero-reveal .reveal-2 {
        margin-top: 1rem;
        animation-delay: 1400ms;
    }

    .hero-reveal .reveal-3 {
        animation-delay: 2400ms;
    }

    @keyframes heroReveal {
        from {
            opacity: 0;
            transform: translateY(14px);
            filter: blur(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
        .hero-reveal > * {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
            filter: none !important;
        }
    }

    /* --- Responsive --- */
    @media (max-width: 520px) {
        .services-hero {
            padding: 5rem 0 3rem;
        }

        .subtitle {
            font-size: 1.05rem;
            padding-top: 1.5rem;
        }
    }
</style>