---
import {services as svcCopy} from "../../config/copy.ts";

const {grid} = svcCopy;
const items = grid.items;
---

<section class="services below-hero-content" id="services" data-services-section>
    <div class="services__container">
        <div class="services__layout">
            <header class="services__intro">
                <h2 class="services__title">{grid.title}</h2>
            </header>

            <div class="services__list" data-services>
                {items.map((service, i) => (
                        <article class="service" data-service data-index={i}>
                            <button
                                    class="service__trigger"
                                    type="button"
                                    data-trigger
                                    aria-expanded="false"
                                    aria-controls={`panel-${i}`}
                            >
                                <div class="service__meta">
                                    <h3 class="service__title">{service.title}</h3>
                                    <p class="service__description">{service.description}</p>
                                </div>
                                <span class="service__chevron" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            </button>

                            <div class="service__panel" id={`panel-${i}`} data-panel>
                                <p class="service__details">{service.details}</p>
                            </div>
                        </article>
                ))}
            </div>
        </div>
    </div>
</section>

<script is:inline src="/scripts/toggle.js" defer></script>

<style>
    .services {
        padding: 5rem 0;
    }

    .services__container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding: 0 var(--section-pad-x);
    }

    .services__layout {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 4rem;
        align-items: start;
    }

    .services__intro {
        position: sticky;
        top: 6rem;
    }

    .services__title {
        margin: 0;
        font-family: var(--font-brand, sans-serif);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 750;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text);
    }

    .services__list {
        display: grid;
        gap: 1rem;
    }

    /* Service card */
    .service {
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        transition: border-color 0.2s ease;
    }

    .service:hover {
        border-color: color-mix(in srgb, var(--text) 15%, var(--border));
    }

    /* Trigger */
    .service__trigger {
        width: 100%;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        text-align: left;
        color: inherit;
    }

    .service__meta {
        flex: 1;
    }

    .service__title {
        margin: 0 0 0.35rem;
        font-family: var(--font-brand, sans-serif);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
    }

    .service__description {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.5;
    }

    /* Chevron */
    .service__chevron {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        flex-shrink: 0;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease, background 0.2s ease;
    }

    .service:hover .service__chevron {
        color: var(--text);
    }

    .service[data-open="true"] .service__chevron {
        transform: rotate(180deg);
        color: var(--text);
        background: color-mix(in srgb, var(--text) 8%, transparent);
    }

    /* Panel */
    .service__panel {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transition:
            grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .service[data-open="true"] .service__panel {
        grid-template-rows: 1fr;
        opacity: 1;
        transition:
            grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
    }

    .service__details {
        overflow: hidden;
        margin: 0;
        padding-top: 1rem;
        margin-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .services {
            padding: 3.5rem 0;
        }

        .services__container {
            padding: 0 var(--section-pad-x-mobile);
        }

        .services__layout {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .services__intro {
            position: static;
            text-align: center;
        }

        .service {
            padding: 1rem 1.25rem;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .service__panel,
        .service__chevron {
            transition: none;
        }
    }
</style>