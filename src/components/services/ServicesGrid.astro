---
const services = [
    {
        title: "Build",
        description: "Custom software. No templates, no shortcuts.",
        story: "Websites, internal tools, customer portals, whatever you want - we build them.",
    },
    {
        title: "Fix",
        description: "Broken systems, slow sites, weird bugs. We sort it.",
        story: "Something broke and nobody knows why? We dig in and make it behave.",
    },
    {
        title: "Automate",
        description: "Less manual work. More time for actual work.",
        story: "If you're doing it twice, we can probably automate it.",
    },
];
---

<section class="services" id="services" data-services-section>
    <div class="container services__layout">
        <!-- LEFT -->
        <div class="services__intro">
            <h2 class="services__title" data-letters>
                What we do
            </h2>

            <p class="services__punchline">
                Or at least what we tell ourselves to sleep easier at night.
            </p>
        </div>

        <!-- RIGHT -->
        <div class="services__list" data-services>
            {services.map((service, i) => (
                    <article class="service" data-service data-step={i + 1}>
                        <button class="service__trigger" type="button" data-trigger aria-expanded="false">
                            <div class="service__meta">
                                <h3>{service.title}</h3>
                                <p>{service.description}</p>
                            </div>

                            <span class="service__chevron" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                                <path
                                        d="M6 9l6 6 6-6"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                        </button>

                        <div class="service__panel" data-panel>
                            <div class="service__content">
                                <p class="service__story">{service.story}</p>
                            </div>
                        </div>
                    </article>
            ))}
        </div>
    </div>
</section>

<script>
    // Letter animation split
    const splitLetters = () => {
        const titles = document.querySelectorAll("[data-letters]");
        titles.forEach((title) => {
            if (title.querySelector('.char')) return; // Already split
            const text = title.textContent || "";
            title.innerHTML = text
                .split("")
                .map((char) => {
                    if (char === " ") return `<span class="char">&nbsp;</span>`;
                    return `<span class="char">${char}</span>`;
                })
                .join("");
        });
    };

    // Accordion functionality
    const setupAccordions = () => {
        const services = document.querySelectorAll("[data-service]");

        services.forEach((service) => {
            const trigger = service.querySelector("[data-trigger]");
            if (!trigger) return;

            trigger.addEventListener("click", () => {
                const isOpen = service.getAttribute("data-open") === "true";

                services.forEach((s) => {
                    s.setAttribute("data-open", "false");
                    const btn = s.querySelector("[data-trigger]");
                    if (btn) btn.setAttribute("aria-expanded", "false");
                });

                if (!isOpen) {
                    service.setAttribute("data-open", "true");
                    trigger.setAttribute("aria-expanded", "true");
                }
            });
        });
    };

    const init = () => {
        splitLetters();
        setupAccordions();
    };

    document.addEventListener("astro:page-load", init);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>

<style>
    /* =========================================================
       Layout
       ========================================================= */
    .services {
        padding: 6rem 0;
    }

    .container {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .services__layout {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 4rem;
        align-items: start;
    }

    .services__intro {
        position: sticky;
        top: 7rem;
        align-self: start;
        max-width: 34ch;
    }

    .services__intro h2 {
        margin: 0 0 1.25rem;
        font-size: clamp(2.8rem, 5vw, 4rem);
        line-height: 1;
        letter-spacing: -0.04em;
        font-weight: 750;
        color: var(--text);
    }

    .services__intro p {
        margin: 0;
        font-size: clamp(1.15rem, 1.4vw, 1.35rem);
        line-height: 1.6;
        color: var(--text-muted);
        max-width: 30ch;
    }

    .services__title {
        margin: 0 0 1rem;
        font-size: clamp(2.2rem, 3.8vw, 3rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
    }

    .services__punchline {
        margin: 1.25rem 0 0.85rem;
        font-size: clamp(1.15rem, 1.4vw, 1.35rem);
        font-weight: 650;
        letter-spacing: -0.02em;
        line-height: 1.35;
        color: var(--text);
        opacity: 0.92;
    }

    .services__list {
        display: grid;
        gap: 1.5rem;
    }

    /* =========================================================
       Service items (accordion)
       ========================================================= */
    .service {
        padding: 1.5rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
    }

    /* =========================================================
       Trigger button
       ========================================================= */
    .service__trigger {
        width: 100%;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.25rem;
        align-items: start;
        text-align: left;
        color: inherit;
    }

    .service__meta h3 {
        font-size: clamp(1.2rem, 2vw, 1.4rem);
        margin: 0 0 0.4rem;
        font-weight: 650;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .service__meta p {
        margin: 0;
        font-size: 0.95rem;
        color: var(--text-muted);
        max-width: 68ch;
        line-height: 1.55;
    }

    /* Chevron */
    .service__chevron {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: var(--text-muted);
        transition: transform 300ms ease, background 300ms ease, color 300ms ease;
    }

    .service__trigger:hover .service__chevron {
        color: var(--text);
    }

    .service[data-open="true"] .service__chevron {
        transform: rotate(180deg);
        color: var(--text);
        background: rgba(255, 255, 255, 0.06);
    }

    /* =========================================================
       Panel (accordion content)
       ========================================================= */
    .service__panel {
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transform: translateY(-6px);
        transition:
                max-height 320ms ease,
                opacity 320ms ease,
                transform 320ms ease;
    }

    .service[data-open="true"] .service__panel {
        max-height: 400px;
        opacity: 1;
        transform: translateY(0);
    }

    .service__content {
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
        margin-top: 1.25rem;
    }

    .service__story {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.65;
        max-width: 72ch;
    }

    /* =========================================================
       Responsive
       ========================================================= */
    @media (max-width: 900px) {
        .services {
            padding: 4rem 0;
        }

        .container {
            padding: 0 1.25rem;
        }

        .services__layout {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .services__intro {
            position: relative;
            top: 0;
            padding: 0;
            text-align: center;
            max-width: none;
        }

        .services__intro p {
            max-width: none;
        }

        .service {
            padding: 1.25rem 1rem;
        }

        .service__trigger {
            gap: 0.75rem;
        }

        .service__chevron {
            width: 36px;
            height: 36px;
        }

        .service__meta h3 {
            font-size: 1.1rem;
        }

        .service__meta p {
            font-size: 0.9rem;
        }
    }

    /* =========================================================
       Light mode
       ========================================================= */
    :global(:root[data-theme="light"]) .service {
        background: rgba(0, 0, 0, 0.02);
    }

    :global(:root[data-theme="light"]) .service[data-open="true"] .service__chevron {
        background: rgba(0, 0, 0, 0.05);
    }

    /* =========================================================
       Reduced motion
       ========================================================= */
    @media (prefers-reduced-motion: reduce) {
        .service__panel,
        .service__chevron {
            transition: none !important;
        }
    }
</style>