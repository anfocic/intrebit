---
import SocialIcon from "../shared/SocialIcon.astro";

type Variant = "links" | "connect";

interface LinkItem {
    label: string;
    href: string;
}

interface Props {
    title: string;
    variant?: Variant;
    links?: LinkItem[];
}

const {
    title,
    variant = "links",
    links = [],
} = Astro.props;
---

<section class="footer-section">
    <h4 class="footer-section__heading">{title}</h4>

    {variant === "links" && links.length > 0 && (
            <ul class="footer-section__links">
                {links.map((link) => (
                        <li>
                            <a href={link.href} class="footer-section__link">{link.label}</a>
                        </li>
                ))}
            </ul>
    )}

    {variant === "connect" && (
            <div class="footer-section__connect">
                <div class="footer-section__social">
                    <SocialIcon
                            icon="mail"
                            href="mailto:hello@intrebit.com"
                            title="Email"
                            className="footer-section__icon"
                    />
                    <SocialIcon
                            icon="linkedin"
                            href="https://www.linkedin.com/company/intrebit"
                            title="LinkedIn"
                            className="footer-section__icon"
                    />
                    <SocialIcon
                            icon="mastodon"
                            href="https://mastodon.social/@intrebit"
                            title="Mastodon"
                            rel="me noopener noreferrer"
                            className="footer-section__icon"
                    />
                </div>

                <p class="footer-section__contact">
                    <a href="mailto:hello@intrebit.com">hello@intrebit.com</a>
                </p>
            </div>
    )}
</section>

<style>
    .footer-section__heading {
        color: var(--text);
        font-size: 1rem;
        font-weight: 650;
        margin: 0 0 1.25rem;
    }

    /* LINKS VARIANT */
    .footer-section__links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.75rem;
    }

    .footer-section__link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.98rem;
        transition: color 0.18s var(--ease);
    }

    .footer-section__link:hover {
        color: var(--text);
    }

    /* CONNECT VARIANT */
    .footer-section__connect {
        display: grid;
        gap: 1.1rem;
    }

    .footer-section__social {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .footer-section__icon {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;

        background: color-mix(in srgb, var(--text) 6%, transparent);
        border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
        color: color-mix(in srgb, var(--text) 72%, transparent);

        transition: transform 0.18s var(--ease),
        background 0.18s var(--ease),
        border-color 0.18s var(--ease),
        color 0.18s var(--ease);
    }

    .footer-section__icon:hover {
        transform: translateY(-2px);
        background: color-mix(in srgb, var(--text) 12%, transparent);
        border-color: color-mix(in srgb, var(--text) 25%, transparent);
        color: var(--text);
    }

    .footer-section__icon svg {
        width: 20px;
        height: 20px;
    }

    .footer-section__contact {
        margin: 0;
        font-size: 0.95rem;
        color: var(--text-muted);
    }

    .footer-section__contact a {
        color: inherit;
        text-decoration: none;
    }

    .footer-section__contact a:hover {
        color: var(--text);
        text-decoration: underline;
    }
</style>