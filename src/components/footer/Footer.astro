---
import SocialIcon from "../shared/SocialIcon.astro";
import ThemeToggle from "../shared/ThemeToggle.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
    <p class="footer__text">
        © {year} Intrebit. Software built properly.
    </p>
    <ThemeToggle />

    <div class="footer__social">
        <SocialIcon
                icon="mastodon"
                href="https://mastodon.social/@intrebit"
                title="Mastodon"
                rel="me noopener noreferrer"
                className="footer__social-icon footer__social-icon--mastodon"
        />
        <SocialIcon
                icon="linkedin"
                href="https://www.linkedin.com/company/intrebit"
                title="LinkedIn"
                target="_blank"
                rel="noopener noreferrer"
                className="footer__social-icon footer__social-icon--linkedin"
        />
    </div>
</footer>

<style>
    .footer {
        padding: 2rem;
        border-top: 1px solid var(--border);
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1.25rem;
    }

    .footer__text {
        margin: 0;
        font-size: 0.92rem;
        color: var(--text-muted);
    }

    .footer__social {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }



    /* Mobile: stack + center */
    @media (max-width: 720px) {
        .footer {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }

        .footer__social {
            justify-content: center;
        }
    }
</style>