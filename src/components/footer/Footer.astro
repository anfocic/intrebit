---
import SocialIcon from "../shared/SocialIcon.astro";
import FooterSection from "./FooterSection.astro";
import {companyLinks, servicesLinks} from "../../config/site.ts";
---

<footer class="scandi-footer">
    <div class="footer-content">
        <div class="footer-grid">
            <FooterSection links={servicesLinks} title="Services"/>
            <FooterSection links={companyLinks} title="Company"/>

            <div class="footer-section">
                <h4>Connect</h4>
                <div class="social-links">
                    <a href="mailto:hello@intrebit.com" title="Email" class="social-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </a>
                    <a href="https://linkedin.com" target="_blank" title="LinkedIn" class="social-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                        </svg>
                    </a>
                    <a
                            href="https://mastodon.social/@intrebit"
                            rel="me"
                            target="_blank"
                            title="Mastodon"
                            class="social-icon"
                    >
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M21.43 7.07c-.28-2.1-2.1-3.74-4.28-3.98C15.64 2.9 14.02 3 12 3s-3.64-.1-5.15.09C4.67 3.33 2.85 4.97 2.57 7.07c-.19 1.46-.29 3.04-.19 4.62.17 2.74 1.76 5.17 4.32 6.02.88.29 1.66.45 2.47.52 1.48.13 2.9-.06 4.36-.41.16-.04.32-.08.48-.12v-1.8c-.18.06-.37.11-.56.15-1.05.25-2.2.46-3.38.36-2.35-.2-3.04-1.2-3.21-1.75-.03-.09-.05-.18-.06-.28 0 0 1.42.35 3.22.43 1.1.05 2.13-.06 3.18-.18 2.02-.24 3.78-1.48 4-2.61.36-1.89.33-4.62.33-4.62zm-3.49 6.15h-2.18V9.1c0-.86-.36-1.3-1.08-1.3-.8 0-1.2.52-1.2 1.54v2.24H11.3V9.34c0-1.02-.4-1.54-1.2-1.54-.72 0-1.08.44-1.08 1.3v4.12H6.84V8.97c0-.86.22-1.54.66-2.05.45-.5 1.03-.76 1.75-.76.84 0 1.48.32 1.9.97l.85 1.42.85-1.42c.42-.65 1.06-.97 1.9-.97.72 0 1.3.26 1.75.76.44.51.66 1.19.66 2.05v4.25z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2025 Intrebit. We're just millennials trying to not burn out. No corporate BS here.</p>
        </div>
    </div>
</footer>

<style>
    .social-links {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .social-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.1 );
        color: rgba(255, 255, 255, 0.7);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .social-icon:hover {
        background-color: rgba(255, 255, 255, 0.2);
        color: rgba(255, 255, 255, 1);
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.4);
    }

    @media (max-width: 768px) {
        .social-links {
            gap: 1rem;
        }

        .social-icon {
            width: 36px;
            height: 36px;
        }

        .social-icon svg {
            width: 20px;
            height: 20px;
        }
    }

    @media (max-width: 480px) {
        .social-links {
            gap: 0.75rem;
        }

        .social-icon {
            width: 32px;
            height: 32px;
        }

        .social-icon svg {
            width: 18px;
            height: 18px;
        }
    }
</style>
