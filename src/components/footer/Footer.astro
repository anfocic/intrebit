---
import ThemeToggle from "../shared/ThemeToggle.astro";
import {legalLinks} from "../../config/site.ts";
import {header, footer} from "../../config/copy.ts";

const year = new Date().getFullYear();
---

<footer class="footer" aria-label="Site footer">
    <div class="footer__inner">
        <span class="mono footer__copy">
            © {year} {header.brand}
            {legalLinks.map((l) => (
                <>
                    <span class="footer__sep" aria-hidden="true">·</span>
                    <a href={l.href} class="footer__link">{l.label}</a>
                </>
            ))}
        </span>

        <div class="footer__icons">
            <a
                href={footer.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="footer__icon-link"
            >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"/>
                </svg>
            </a>
            <ThemeToggle/>
        </div>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--rule);
        background: var(--bg);
    }

    .footer__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 32px var(--section-pad-x);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-3);
        gap: 16px;
    }

    .footer__link {
        color: var(--ink-3);
        text-decoration: none;
        transition: color 0.2s var(--ease);
    }

    .footer__link:hover {
        color: var(--ink);
    }

    .footer__sep {
        margin: 0 8px;
        color: var(--ink-3);
    }

    .footer__icons {
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

    .footer__icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: none;
        background: transparent;
        color: var(--ink-3);
        transition: color 0.2s var(--ease);
    }

    .footer__icon-link:hover {
        color: var(--ink);
    }

    @media (max-width: 720px) {
        .footer__inner {
            padding: 24px var(--section-pad-x-mobile);
            gap: 12px;
        }
    }
</style>
