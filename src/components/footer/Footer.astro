---
import ThemeToggle from "../shared/ThemeToggle.astro";
import {legalLinks} from "../../config/site.ts";
import {header, footer} from "../../config/copy.ts";

const year = new Date().getFullYear();
const {socials} = footer;
---

<footer class="footer" aria-label="Site footer">
    <div class="footer__inner">
        <span class="mono footer__copy">
            © {year} {header.brand}
            {legalLinks.map((l) => (
                <>
                    <span class="footer__sep" aria-hidden="true">·</span>
                    <a href={l.href} class="footer__link">{l.label}</a>
                </>
            ))}
        </span>

        <ThemeToggle/>

        <span class="mono footer__social">
            {socials.map((s, i) => (
                <>
                    {i > 0 && <span class="footer__sep" aria-hidden="true">·</span>}
                    <a href={s.href} target="_blank" rel={s.rel} class="footer__link">{s.label}</a>
                </>
            ))}
        </span>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--rule);
        background: var(--bg);
    }

    .footer__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 32px var(--section-pad-x);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-3);
        gap: 16px;
        flex-wrap: wrap;
    }

    .footer__link {
        color: var(--ink-3);
        text-decoration: none;
        transition: color 0.2s var(--ease);
    }

    .footer__link:hover {
        color: var(--ink);
    }

    .footer__sep {
        margin: 0 8px;
        color: var(--ink-3);
    }

    @media (max-width: 720px) {
        .footer__inner {
            padding: 24px var(--section-pad-x-mobile);
            justify-content: center;
            text-align: center;
        }
    }
</style>
