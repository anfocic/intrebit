---
import SocialIcon from "../shared/SocialIcon.astro";
import ThemeToggle from "../shared/ThemeToggle.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
    <p class="footer__text">
        © {year} intrebit. MIT Licensed.
    </p>

    <div class="footer__social">
        <ThemeToggle />

        <SocialIcon
                icon="mastodon"
                href="https://mastodon.social/@intrebit"
                title="Mastodon"
                rel="me noopener noreferrer"
                className="footer__social-icon footer__social-icon--mastodon"
        />
        <SocialIcon
                icon="linkedin"
                href="https://www.linkedin.com/company/intrebit"
                title="LinkedIn"
                target="_blank"
                rel="noopener noreferrer"
                className="footer__social-icon footer__social-icon--linkedin"
        />
    </div>


    <nav class="footer__links" aria-label="Footer">
        <a class="footer__link" href="/privacy">Privacy</a>
        <a class="footer__link" href="/terms">Terms</a>
        <a
                class="footer__link"
                href="https://codeberg.org/intrebit/intrebit-web"
                target="_blank"
                rel="noopener noreferrer"
        >
            Source
        </a>
    </nav>
</footer>

<style>
    .footer {
        padding: 2rem;
        border-top: 1px solid var(--border);
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1.25rem;
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
    }

    .footer__text {
        margin: 0;
        font-size: 0.92rem;
        color: var(--text-muted);
    }

    .footer__links {
        display: inline-flex;
        align-items: center;
        gap: 0.9rem;
        justify-content: center;
    }

    .footer__link {
        font-size: 0.92rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.16s var(--ease);
    }

    .footer__link:hover {
        color: var(--text);
    }

    .footer__social {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    @media (max-width: 720px) {
        .footer {
            padding: 1.5rem 1.25rem;
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
            gap: 1rem;
        }

        .footer__social {
            order: 1;
            justify-content: center;
        }

        .footer__links {
            order: 2;
            flex-wrap: wrap;
            row-gap: 0.5rem;
        }

        .footer__text {
            order: 3;
            font-size: 0.85rem;
        }
    }
</style>