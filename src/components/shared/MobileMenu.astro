---
import {navLinks} from "../../config/navLinks";

const {ctaHref = "/contact", ctaLabel = "Get in touch"} = Astro.props;
---

<!-- Overlay (covers page below header) -->
<div class="mobile-nav__overlay" data-mobile-overlay></div>

<!-- Panel under header -->
<aside class="mobile-nav__panel" data-mobile-sidebar aria-hidden="true" hiddenwr>
    <nav class="mobile-nav__menu" aria-label="Mobile navigation">
        {navLinks.map(({href, label}) => (
                <a href={href} class="mobile-nav__link">{label}</a>
        ))}
    </nav>

    <div class="mobile-nav__bottom">
        <a href={ctaHref} class="mobile-nav__cta">
            {ctaLabel}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
        </a>

        <div class="mobile-nav__row">
            <a href="mailto:hello@intrebit.com" class="mobile-nav__email">hello@intrebit.com</a>
            <div class="mobile-nav__socials">
                <a href="https://www.linkedin.com/company/intrebit" target="_blank" rel="noopener noreferrer"
                   aria-label="LinkedIn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                </a>
                <a href="https://mastodon.social/@intrebit" target="_blank" rel="me noopener noreferrer"
                   aria-label="Mastodon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</aside>

<style>
    /* ---------------------------------------
   Mobile menu (panel under sticky header)
   Uses existing theme tokens:
   --bg, --surface, --surface-strong, --text, --text-muted, --border
   + hover-gated + a11y focus
   --------------------------------------- */

    .mobile-nav__overlay {
        position: fixed;
        left: 0;
        right: 0;
        top: calc(var(--header-height, 72px) - 1px);
        bottom: 0;
        z-index: 998;

        background: transparent;
        opacity: 0;
        pointer-events: none;

        transition: opacity 0.2s var(--ease);
    }

    .mobile-nav__overlay.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    /* Full-screen panel below header */
    .mobile-nav__panel {
        position: fixed;
        left: 0;
        right: 0;
        top: calc(var(--header-height, 72px) - 1px);
        z-index: 999;

        height: calc(100dvh - var(--header-height, 72px));
        display: flex;
        flex-direction: column;

        overflow: auto;
        -webkit-overflow-scrolling: touch;

        background: transparent; /* light theme example */
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);

        /* theme-aware shadow (deeper on dark) */
        box-shadow: 0 22px 60px color-mix(in srgb, black 30%, transparent);

        transform: translateY(-10px);
        opacity: 0;
        pointer-events: none;

        transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
    }

    :root[data-theme="dark"] .mobile-nav__panel {
        box-shadow: 0 22px 60px color-mix(in srgb, black 55%, transparent);
    }

    @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) .mobile-nav__panel {
            box-shadow: 0 22px 60px color-mix(in srgb, black 55%, transparent);
        }
    }

    .mobile-nav__panel.is-open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    /* Menu */
    .mobile-nav__menu {
        display: flex;
        flex-direction: column;
        padding: 0.75rem 1rem;
    }

    .mobile-nav__link {
        padding: 1.1rem 0.75rem;
        border-radius: 14px;

        font-size: 1.1rem;
        font-weight: 650;
        color: var(--text);
        text-decoration: none;

        transition: background 0.15s var(--ease), opacity 0.15s var(--ease);
    }

    .mobile-nav__link + .mobile-nav__link {
        margin-top: 0.25rem;
    }

    /* Bottom pinned */
    .mobile-nav__bottom {
        margin-top: auto;
        padding: 1rem 1.25rem 1.25rem;
        border-top: 1px solid var(--border);

        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* CTA smaller */
    .mobile-nav__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;

        height: 44px;
        padding: 0 1rem;
        border-radius: 999px;

        background: var(--text);
        color: var(--bg);
        font-size: 0.95rem;
        font-weight: 650;
        text-decoration: none;

        width: fit-content;
        align-self: flex-start;

        transition: opacity 0.2s ease, transform 0.16s var(--ease);
    }

    .mobile-nav__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .mobile-nav__email {
        font-size: 0.9rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .mobile-nav__socials {
        display: flex;
        gap: 0.35rem;
    }

    .mobile-nav__socials a {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;

        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--text-muted);
        text-decoration: none;

        transition: all 0.2s ease;
    }

    /* Hover only for real hover devices */
    @media (hover: hover) and (pointer: fine) {
        .mobile-nav__link:hover {
            background: color-mix(in srgb, var(--text) 6%, transparent);
        }

        .mobile-nav__cta:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .mobile-nav__email:hover {
            color: var(--text);
        }

        .mobile-nav__socials a:hover {
            color: var(--text);
            border-color: var(--text-muted);
        }
    }

    /* Keyboard focus (important even on "mobile") */
    .mobile-nav__link:focus-visible,
    .mobile-nav__cta:focus-visible,
    .mobile-nav__email:focus-visible,
    .mobile-nav__socials a:focus-visible {
        outline: none;
        box-shadow: 0 0 0 5px rgba(178, 223, 219, 0.18);
    }

    /* Prevent body scroll when menu open */
    :global(body.menu-open) {
        overflow: hidden;
    }
</style>