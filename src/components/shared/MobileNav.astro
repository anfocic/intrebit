---
import { navLinks } from "../../config/navLinks";
import SocialIcon from "../shared/SocialIcon.astro";
import Logo from "../shared/Logo.astro";
---

<!-- Overlay -->
<div class="mobile-nav__overlay" data-mobile-overlay></div>

<!-- Sidebar -->
<aside class="mobile-nav" data-mobile-sidebar aria-label="Mobile navigation">
    <!-- Top -->
    <div class="mobile-nav__top">
        <a href="/" class="mobile-nav__brand" aria-label="Home">
            <Logo size={28} />
            <span>Intrebit</span>
        </a>

        <button class="mobile-nav__close" type="button" aria-label="Close menu">
            ✕
        </button>
    </div>

    <!-- Links -->
    <nav class="mobile-nav__menu" aria-label="Mobile menu">
        <ul class="mobile-nav__links">
            {navLinks.map(({ path, label }) => (
                    <li>
                        <a href={path} class="mobile-nav__link">{label}</a>
                    </li>
            ))}
        </ul>
    </nav>

    <!-- Bottom -->
    <div class="mobile-nav__bottom">
        <div class="mobile-nav__social">
            <SocialIcon icon="mail" href="mailto:hello@intrebit.com" title="Email" className="mobile-nav__social-icon" />
            <SocialIcon icon="linkedin" href="https://www.linkedin.com/company/intrebit" title="LinkedIn" className="mobile-nav__social-icon" />
            <SocialIcon icon="mastodon" href="https://mastodon.social/@intrebit" title="Mastodon" rel="me noopener noreferrer" className="mobile-nav__social-icon" />
        </div>

        <a class="mobile-nav__cta" href="/contact">
            Get in touch →
        </a>

        <button class="mobile-nav__theme theme-toggle" type="button">
            Toggle theme
        </button>
    </div>
</aside>

<script is:inline>
    (() => {
        const overlay = document.querySelector("[data-mobile-overlay]");
        const sidebar = document.querySelector("[data-mobile-sidebar]");
        const openBtn = document.querySelector("[data-mobile-open]");
        const closeBtn = document.querySelector(".mobile-nav__close");

        // ✅ Don’t require openBtn — it may not exist on some pages (e.g. showHeader=false)
        if (!overlay || !sidebar || !closeBtn) return;

        const open = () => {
            document.body.classList.add("menu-open");
            sidebar.classList.add("is-open");
            overlay.classList.add("is-open");
        };

        const close = () => {
            document.body.classList.remove("menu-open");
            sidebar.classList.remove("is-open");
            overlay.classList.remove("is-open");
        };

        // ✅ ALWAYS start closed (fixes sidebar loading open)
        close();

        // ✅ Only bind open if the button exists
        if (openBtn) {
            openBtn.addEventListener("click", open);
        }

        closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", close);

        sidebar.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", close);
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") close();
        });

        // ✅ If using Astro View Transitions / SPA navigation
        document.addEventListener("astro:after-swap", close);
    })();
</script>

<style>
    /* Overlay */
    .mobile-nav__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(14px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.22s ease;
        z-index: 200;
    }

    .mobile-nav__overlay.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    /* Sidebar */
    .mobile-nav {
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        width: min(420px, 92vw);
        background: linear-gradient(
                180deg,
                color-mix(in srgb, var(--bg) 90%, black),
                color-mix(in srgb, var(--bg) 75%, black)
        );
        border-left: 1px solid var(--border);
        transform: translateX(100%);
        transition: transform 0.28s var(--ease);
        z-index: 250;

        display: flex;
        flex-direction: column;
    }

    .mobile-nav.is-open {
        transform: translateX(0);
    }

    /* Top bar */
    .mobile-nav__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.4rem 1.4rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .mobile-nav__brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        color: var(--text);
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
    }

    .mobile-nav__close {
        width: 46px;
        height: 46px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        color: var(--text);
        cursor: pointer;
        font-size: 1.2rem;
    }

    /* Menu */
    .mobile-nav__menu {
        flex: 1;
        padding: 0;
    }

    .mobile-nav__links {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .mobile-nav__link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.4rem 1.4rem;
        font-size: 1.35rem;
        font-weight: 650;
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        transition: background 0.15s ease;
    }

    .mobile-nav__link:hover {
        background: rgba(255,255,255,0.05);
    }

    /* Bottom */
    .mobile-nav__bottom {
        padding: 1.6rem 1.4rem 2rem;
        border-top: 1px solid rgba(255,255,255,0.08);
        display: grid;
        gap: 1.4rem;
    }

    .mobile-nav__social {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .mobile-nav__social-icon {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.75);
    }

    .mobile-nav__cta {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 54px;
        border-radius: 999px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 700;
        text-decoration: none;
        font-size: 1rem;
        letter-spacing: 0.01em;
        transition: transform 0.2s ease;
    }

    .mobile-nav__cta:hover {
        transform: translateY(-1px);
    }

    .mobile-nav__theme {
        height: 44px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.75);
        font-weight: 600;
        cursor: pointer;
    }

    /* Prevent background scroll */
    body.menu-open {
        overflow: hidden;
    }
</style>