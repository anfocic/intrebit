---
import { navLinks } from "../../config/navLinks";
import SocialIcon from "../shared/SocialIcon.astro";
import Logo from "../shared/Logo.astro";
---

<!-- Overlay -->
<div class="mobile-nav__overlay" data-mobile-overlay></div>

<!-- Sidebar -->
<aside class="mobile-nav" data-mobile-sidebar aria-label="Mobile navigation">
    <!-- Header -->
    <div class="mobile-nav__header">
        <a href="/" class="mobile-nav__brand" aria-label="Home">
            <Logo size={28} />
        </a>

        <button class="mobile-nav__close" type="button" aria-label="Close menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <!-- Content -->
    <div class="mobile-nav__content">
        <!-- Links -->
        <nav class="mobile-nav__menu" aria-label="Mobile menu">
            <ul class="mobile-nav__links">
                {navLinks.map(({ path, label }) => (
                        <li>
                            <a href={path} class="mobile-nav__link">{label}</a>
                        </li>
                ))}
            </ul>
        </nav>

        <!-- Bottom -->
        <div class="mobile-nav__bottom">
            <div class="mobile-nav__social">
                <SocialIcon icon="mail" href="mailto:hello@intrebit.com" title="Email" className="mobile-nav__social-icon" />
                <SocialIcon icon="linkedin" href="https://www.linkedin.com/company/intrebit" title="LinkedIn" className="mobile-nav__social-icon" />
                <SocialIcon icon="mastodon" href="https://mastodon.social/@intrebit" title="Mastodon" rel="me noopener noreferrer" className="mobile-nav__social-icon" />
            </div>

            <a class="mobile-nav__cta" href="/contact">
                Get in touch →
            </a>

            <button class="mobile-nav__theme theme-toggle" type="button">
                Toggle theme
            </button>
        </div>
    </div>
</aside>

<script is:inline>
    (() => {
        const overlay = document.querySelector("[data-mobile-overlay]");
        const sidebar = document.querySelector("[data-mobile-sidebar]");
        const openBtn = document.querySelector("[data-mobile-open]");
        const closeBtn = document.querySelector(".mobile-nav__close");

        if (!overlay || !sidebar || !closeBtn) return;

        const open = () => {
            document.body.classList.add("menu-open");
            sidebar.classList.add("is-open");
            overlay.classList.add("is-open");
        };

        const close = () => {
            document.body.classList.remove("menu-open");
            sidebar.classList.remove("is-open");
            overlay.classList.remove("is-open");
        };

        close();

        if (openBtn) {
            openBtn.addEventListener("click", open);
        }

        closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", close);

        sidebar.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", close);
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") close();
        });

        document.addEventListener("astro:after-swap", close);
    })();
</script>

<style>
    /* Overlay */
    .mobile-nav__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
        z-index: 200;
    }

    .mobile-nav__overlay.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    /* Sidebar */
    .mobile-nav {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        height: 100vh;
        width: 100%;
        background: var(--bg, #0a1628);
        /* Fallback solid colors */
        background-color: #0a1628;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 999;
        display: flex;
        flex-direction: column;
        isolation: isolate;
    }

    :global(:root[data-theme="light"]) .mobile-nav {
        background-color: #f5f5f0;
    }

    /* Only limit width on larger screens */
    @media (min-width: 600px) {
        .mobile-nav {
            left: auto;
            max-width: 420px;
        }
    }

    .mobile-nav.is-open {
        transform: translateX(0);
    }

    /* Header */
    .mobile-nav__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .mobile-nav__brand {
        display: flex;
        align-items: center;
    }

    .mobile-nav__close {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        border: none;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease;
    }

    .mobile-nav__close:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    /* Content */
    .mobile-nav__content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    /* Menu */
    .mobile-nav__menu {
        flex: 1;
        padding: 2rem 0;
    }

    .mobile-nav__links {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .mobile-nav__link {
        display: block;
        padding: 1.25rem 1.5rem;
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid var(--border);
        transition: background 0.15s ease;
        letter-spacing: -0.01em;
    }

    .mobile-nav__link:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .mobile-nav__links li:last-child .mobile-nav__link {
        border-bottom: none;
    }

    /* Bottom */
    .mobile-nav__bottom {
        padding: 2rem 1.5rem 2.5rem;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        flex-shrink: 0;
    }

    .mobile-nav__social {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    :global(.mobile-nav__social-icon) {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        color: var(--text-muted);
        transition: all 0.2s ease;
    }

    :global(.mobile-nav__social-icon:hover) {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
    }

    .mobile-nav__cta {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 52px;
        border-radius: 999px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-weight: 600;
        text-decoration: none;
        font-size: 1rem;
        transition: transform 0.2s ease;
    }

    .mobile-nav__cta:hover {
        transform: translateY(-1px);
    }

    .mobile-nav__theme {
        height: 48px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .mobile-nav__theme:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
    }

    /* Prevent scroll */
    :global(body.menu-open) {
        overflow: hidden;
    }

    /* Dark mode */
    :global(:root[data-theme="dark"]) .mobile-nav__header,
    :global(:root[data-theme="dark"]) .mobile-nav__link,
    :global(:root[data-theme="dark"]) .mobile-nav__bottom {
        border-color: rgba(255, 255, 255, 0.08);
    }

    /* Light mode */
    :global(:root[data-theme="light"]) .mobile-nav__close:hover {
        background: rgba(0, 0, 0, 0.04);
    }

    :global(:root[data-theme="light"]) .mobile-nav__link:hover {
        background: rgba(0, 0, 0, 0.02);
    }

    :global(:root[data-theme="light"]) :global(.mobile-nav__social-icon) {
        background: rgba(0, 0, 0, 0.02);
    }

    :global(:root[data-theme="light"]) :global(.mobile-nav__social-icon:hover) {
        background: rgba(0, 0, 0, 0.04);
    }

    :global(:root[data-theme="light"]) .mobile-nav__theme {
        background: rgba(0, 0, 0, 0.02);
    }

    :global(:root[data-theme="light"]) .mobile-nav__theme:hover {
        background: rgba(0, 0, 0, 0.04);
    }
</style>