---
import { navLinks } from "../../config/navLinks";

interface Props {
    id?: string;
}

const { id = "mobile-nav" } = Astro.props;
---

<!-- Overlay -->
<div class="mobile-nav__overlay" data-mobile-overlay></div>

<!-- Sidebar -->
<aside class="mobile-nav" data-mobile-sidebar aria-label="Mobile navigation">
    <div class="mobile-nav__top">
        <button class="mobile-nav__close" type="button" aria-label="Close menu">
            ✕
        </button>
    </div>

    <ul class="mobile-nav__links">
        {navLinks.map(({ path, label }) => (
                <li>
                    <a href={path} class="mobile-nav__link">{label}</a>
                </li>
        ))}
    </ul>

    <div class="mobile-nav__bottom">
        <slot name="actions" />
    </div>
</aside>

<script is:inline define:vars={{ id }}>
    (() => {
        const overlay = document.querySelector("[data-mobile-overlay]");
        const sidebar = document.querySelector("[data-mobile-sidebar]");
        const openBtn = document.querySelector("[data-mobile-open]");
        const closeBtn = document.querySelector(".mobile-nav__close");

        if (!overlay || !sidebar || !openBtn || !closeBtn) return;

        const open = () => {
            document.body.classList.add("menu-open");
            sidebar.classList.add("is-open");
            overlay.classList.add("is-open");
        };

        const close = () => {
            document.body.classList.remove("menu-open");
            sidebar.classList.remove("is-open");
            overlay.classList.remove("is-open");
        };

        openBtn.addEventListener("click", open);
        closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", close);

        sidebar.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", close);
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") close();
        });
    })();
</script>

<style>
    /* Overlay */
    .mobile-nav__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        backdrop-filter: blur(10px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 200;
    }

    .mobile-nav__overlay.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    /* Sidebar */
    .mobile-nav {
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        width: min(360px, 88vw);
        background: color-mix(in srgb, var(--bg) 92%, black);
        border-left: 1px solid var(--border);
        transform: translateX(100%);
        transition: transform 0.25s var(--ease);
        padding: 1.5rem;
        z-index: 250;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
    }

    .mobile-nav.is-open {
        transform: translateX(0);
    }

    .mobile-nav__top {
        display: flex;
        justify-content: flex-end;
    }

    .mobile-nav__close {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text);
        cursor: pointer;
        font-size: 1.2rem;
    }

    .mobile-nav__links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1.5rem;
    }

    .mobile-nav__link {
        font-size: 1.15rem;
        font-weight: 650;
        color: var(--text);
        text-decoration: none;
        transition: color 0.2s var(--ease);
    }

    .mobile-nav__link:hover {
        color: var(--accent);
    }

    .mobile-nav__bottom {
        border-top: 1px solid var(--border);
        padding-top: 1.5rem;
    }

    /* Prevent background scroll */
    body.menu-open {
        overflow: hidden;
    }
</style>