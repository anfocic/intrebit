---
type Props = {
    class?: string;       // class for the divider line itself
    spaceClass?: string;  // class for the outer spacer wrapper
};

const {
    class: lineClass = "",
    spaceClass = "",
    ...rest
} = Astro.props as Props;
---

<div class={`divider-space ${spaceClass}`.trim()}>
    <div {...rest} class={`section-divider ${lineClass}`.trim()}></div>
</div>

<style>
    .divider-space {
        padding-block: var(--s-11); /* default spacing between sections */
    }

    .section-divider {
        width: 80px;
        height: 1px;
        margin-inline: auto;
        border-radius: 999px;
        opacity: 0.9;
        background: var(--brand-navy);
    }
</style>