---
interface Props {
    size?: number;
    class?: string;
}

const {size = 120, class: className = ""} = Astro.props;
const angles = [0, 30, 60, 90, 120, 150];
---
<svg width={size} height={size} viewBox="0 0 120 120" fill="none" class={className} aria-hidden="true">
    {angles.map((deg) => (
        <line
            x1="60" y1="10" x2="60" y2="110"
            stroke="currentColor" stroke-width="3"
            transform={`rotate(${deg} 60 60)`}
        />
    ))}
</svg>
