---
interface Props {
    size?: number;
    color?: string;
    class?: string;
}

const {size = 80, color = "currentColor", class: className = ""} = Astro.props;
const n = 4;
const cell = size / n;

type Cell = { i: number; j: number; fill: boolean };
const cells: Cell[] = [];
for (let i = 0; i < n; i++) {
    for (let j = 0; j < n; j++) {
        cells.push({i, j, fill: (i + j) % 3 === 0});
    }
}
---
<svg width={size} height={size} class={className} aria-hidden="true">
    {cells.map(({i, j, fill}) => (
        <rect
            x={j * cell} y={i * cell}
            width={cell - 1} height={cell - 1}
            fill={fill ? color : "none"}
            stroke={color} stroke-opacity="0.3"
        />
    ))}
</svg>
