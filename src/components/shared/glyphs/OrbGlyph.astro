---
interface Props {
    size?: number;
    class?: string;
}

const {size = 220, class: className = ""} = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 220 220" fill="none" class={className} aria-hidden="true">
    <circle cx="110" cy="110" r="108" stroke="currentColor" stroke-opacity="0.18"/>
    <circle cx="110" cy="110" r="78" stroke="currentColor" stroke-opacity="0.22"/>
    <circle cx="110" cy="110" r="48" stroke="currentColor" stroke-opacity="0.3"/>
    <circle cx="110" cy="110" r="6" fill="var(--accent)"/>
    <line x1="0" y1="110" x2="220" y2="110" stroke="currentColor" stroke-opacity="0.12"/>
    <line x1="110" y1="0" x2="110" y2="220" stroke="currentColor" stroke-opacity="0.12"/>
</svg>
