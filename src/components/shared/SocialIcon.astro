---
type IconName = "linkedin" | "mastodon" | "codeberg";

import LinkedIn from "../../assets/icons/linkedin.svg?raw";
import Mastodon from "../../assets/icons/mastodon.svg?raw";
import Codeberg from "../../assets/icons/codeberg.svg?raw";

interface Props {
    icon: IconName;
    href: string;
    title?: string;
    className?: string;
    size?: number;
    rel?: string;
    target?: "_blank" | "_self";
}

const {
    icon,
    href,
    title = icon,
    className = "",
    size = 48, // better default for footers
    rel,
    target = "_blank",
} = Astro.props;

// ---------------------------
// rel handling (secure defaults)
// ---------------------------
const relTokens = new Set<string>();

if (target === "_blank") {
    relTokens.add("noopener");
    relTokens.add("noreferrer");
}

if (icon === "mastodon") relTokens.add("me");
if (rel) rel.split(" ").forEach((t) => t && relTokens.add(t));

const computedRel = Array.from(relTokens).join(" ");

const ICON_HTML: Record<IconName, string> = {
    linkedin: LinkedIn,
    mastodon: Mastodon,
    codeberg: Codeberg,
};
---

<a
        href={href}
        title={title}
        aria-label={title}
        class={`social-icon ${className}`.trim()}
        target={target}
        rel={computedRel}
>
  <span
          class="social-icon__svg"
          style={`width:${size}px;height:${size}px;`}
          set:html={ICON_HTML[icon]}
  />
</a>

<style>
    /* Make the injected SVG scale to the container */
    .social-icon__svg :global(svg) {
        width: 100%;
        height: 100%;
        display: block;
    }

    /* Make all icon shapes follow currentColor */
    .social-icon__svg :global(svg path),
    .social-icon__svg :global(svg g),
    .social-icon__svg :global(svg circle),
    .social-icon__svg :global(svg rect) {
        fill: currentColor;
        stroke: currentColor;
    }

    /* Base clickable icon styling */
    .social-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;
        color: var(--text-muted);
        text-decoration: none;

        transition: transform 0.16s var(--ease),
        background 0.16s var(--ease),
        border-color 0.16s var(--ease),
        color 0.16s var(--ease);
    }

    .social-icon:hover {
        transform: translateY(-2px);
        color: var(--text);
    }
</style>