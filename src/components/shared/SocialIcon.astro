---
type IconName = "mail" | "linkedin" | "mastodon";

import LinkedIn from "../../assets/icons/linkedin.svg?raw";
import Mastodon from "../../assets/icons/mastodon.svg?raw";

interface Props {
    icon: IconName;
    href: string;
    title?: string;
    className?: string;
    size?: number;
    rel?: string;
    target?: "_blank" | "_self";
}

const {
    icon,
    href,
    title = icon,
    className = "",
    size = 24,
    rel,
    target = "_blank",
} = Astro.props;

// ---------------------------
// rel handling (secure defaults)
// ---------------------------
const relTokens = new Set<string>();

if (target === "_blank") {
    relTokens.add("noopener");
    relTokens.add("noreferrer");
}

if (icon === "mastodon") relTokens.add("me");

if (rel) rel.split(" ").forEach((t) => t && relTokens.add(t));

const computedRel = Array.from(relTokens).join(" ");

// ---------------------------
// inline svg mapping (raw)
// ---------------------------
const ICON_HTML: Record<Exclude<IconName, "mail">, string> = {
    linkedin: LinkedIn,
    mastodon: Mastodon,
};
---

<a
        href={href}
        title={title}
        aria-label={title}
        class={className}
        target={target}
        rel={computedRel}
>
    {icon === "mail" ? (
            <svg
                    width={size}
                    height={size}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
            >
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
    ) : (
            <span
                    class="social-icon__svg"
                    style={`width:${size}px;height:${size}px;`}
                    set:html={ICON_HTML[icon]}
            />
    )}
</a>

<style>


    /* If your downloaded SVG uses stroke instead of fill */
    .social-icon__svg :global(svg path),
    .social-icon__svg :global(svg g),
    .social-icon__svg :global(svg circle) {
        fill: currentColor;
        stroke: currentColor;
    }

    .footer__social-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;

        display: inline-flex;
        align-items: center;
        justify-content: center;


        transition:
                transform 0.16s var(--ease),
                background 0.16s var(--ease),
                border-color 0.16s var(--ease),
                color 0.16s var(--ease);
    }

    .footer__social-icon:hover {
        transform: translateY(-2px);
        color: var(--text);
        border-color: color-mix(in srgb, var(--text) 18%, var(--border));
    }

    /* Brand hover accents */
    .footer__social-icon--linkedin:hover {
        background: rgba(10, 102, 194, 0.14);
        border-color: rgba(10, 102, 194, 0.35);
        color: rgba(10, 102, 194, 0.95);
    }

    .footer__social-icon--mastodon:hover {
        background: rgba(99, 77, 255, 0.14);
        border-color: rgba(99, 77, 255, 0.35);
        color: rgba(99, 77, 255, 0.95);
    }
</style>