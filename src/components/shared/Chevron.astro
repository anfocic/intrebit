---
const { targetId = "services", delay = "2.9s" } = Astro.props;
---

<a
        class="chevron"
        href={`#${targetId}`}
        aria-label="Scroll down"
        style={`--chevron-delay:${delay};`}
>
    <svg
            class="chevron__icon"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
    >
        <path
                d="M6 9l6 6 6-6"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
        />
    </svg>
</a>

<style>
    .chevron {
        position: absolute;
        left: 50%;
        bottom: 2rem;
        transform: translateX(-50%);
        display: grid;
        place-items: center;

        width: 64px;
        height: 64px;
        border-radius: 999px;

        color: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(8px);

        opacity: 0;
        animation: chevronReveal 500ms ease forwards;
        animation-delay: var(--chevron-delay, 2.9s);

        transition: transform 180ms ease, color 180ms ease, background 180ms ease;
        z-index: 5;
    }


    .chevron:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.35);
        outline-offset: 6px;
    }

    .chevron__icon {
        width: 34px;
        height: 34px;
        animation: chevronNudge 1.15s ease-in-out infinite;
        will-change: transform;
    }

    @keyframes chevronNudge {
        0%,
        100% { transform: translateY(0); }
        50% { transform: translateY(10px); }
    }

    @keyframes chevronReveal {
        from { opacity: 0; transform: translateX(-50%) translateY(6px); }
        to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .chevron,
        .chevron__icon {
            animation: none !important;
            opacity: 1 !important;
            transform: translateX(-50%) !important;
        }
    }
</style>