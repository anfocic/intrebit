---
/**
    * ProcessIcon — Lucide-style icons for the process steps
    * Icons are inline SVGs for zero network requests and easy styling
    *
    * To add more icons: https://lucide.dev/icons
    * Copy the SVG paths and add them to ICONS below
    */

type IconName = "phone" | "clipboard-list" | "hammer" | "rocket" | "life-buoy";

interface Props {
    icon: IconName;
    size?: number;
    class?: string;
}

const { icon, size = 24, class: className = "" } = Astro.props;

// Lucide icon paths (stroke-based, 24x24 viewBox)
const ICONS: Record<IconName, string> = {
    "phone": `
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    `,
    "clipboard-list": `
        <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
        <path d="M12 11h4"/>
        <path d="M12 16h4"/>
        <path d="M8 11h.01"/>
        <path d="M8 16h.01"/>
    `,
    "hammer": `
        <path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"/>
        <path d="m18.7 4.625-1.075-1.075a.856.856 0 0 0-1.2-.008L9.705 10.26a.5.5 0 0 0 0 .708l3.327 3.328a.5.5 0 0 0 .708 0l6.718-6.72a.856.856 0 0 0-.008-1.2l-1.075-1.076"/>
        <path d="m15.5 8.5 3 3"/>
    `,
    "rocket": `
        <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
        <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
        <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
        <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
    `,
    "life-buoy": `
        <circle cx="12" cy="12" r="10"/>
        <circle cx="12" cy="12" r="4"/>
        <line x1="4.93" x2="9.17" y1="4.93" y2="9.17"/>
        <line x1="14.83" x2="19.07" y1="14.83" y2="19.07"/>
        <line x1="14.83" x2="19.07" y1="9.17" y2="4.93"/>
        <line x1="14.83" x2="18.36" y1="9.17" y2="5.64"/>
        <line x1="4.93" x2="9.17" y1="19.07" y2="14.83"/>
    `,
};
---

<svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class:list={["process-icon", className]}
        aria-hidden="true"
        set:html={ICONS[icon]}
/>

<style>
    .process-icon {
        display: block;
        flex-shrink: 0;
    }
</style>