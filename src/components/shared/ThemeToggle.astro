---
const options = [
    {value: "light", label: "Light"},
    {value: "dark", label: "Dark"},
];
---

<div class="theme-toggle" data-theme-toggle role="radiogroup" aria-label="Theme">
    <span class="theme-toggle__indicator" aria-hidden="true"></span>
    {options.map((opt) => (
        <button
            type="button"
            class="theme-toggle__btn"
            data-theme-option={opt.value}
            role="radio"
            aria-checked="false"
            aria-label={`Switch to ${opt.label.toLowerCase()} theme`}
        >
            {opt.value === "light" ? (
                <svg class="theme-toggle__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
            ) : (
                <svg class="theme-toggle__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
            )}
            <span class="theme-toggle__label">{opt.label}</span>
        </button>
    ))}
</div>

<style>
    .theme-toggle {
        position: relative;
        display: inline-flex;
        align-items: stretch;
        border: 1px solid var(--rule-2);
        border-radius: 999px;
        padding: 3px;
        background: transparent;
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 1;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        gap: 0;
        isolation: isolate;
    }

    .theme-toggle__indicator {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 3px;
        width: calc(50% - 3px);
        background: var(--ink);
        border-radius: 999px;
        transition: transform 0.32s var(--ease);
        pointer-events: none;
        z-index: 0;
    }

    :global([data-theme="dark"]) .theme-toggle__indicator,
    .theme-toggle:has(.theme-toggle__btn[data-theme-option="dark"].is-active) .theme-toggle__indicator {
        transform: translateX(100%);
    }

    .theme-toggle__btn {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border: none;
        background: transparent;
        color: var(--ink-3);
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        cursor: pointer;
        flex: 1;
        justify-content: center;
        transition: color 0.25s var(--ease);
    }

    .theme-toggle__btn.is-active {
        color: var(--bg);
    }

    .theme-toggle__btn:not(.is-active):hover {
        color: var(--ink);
    }

    .theme-toggle__btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 999px;
    }

    .theme-toggle__icon {
        flex-shrink: 0;
    }

    .theme-toggle__label {
        white-space: nowrap;
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-toggle__indicator {
            transition: none;
        }
    }
</style>
