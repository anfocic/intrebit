---

interface Props {
    href?: string;
    type?: "button" | "submit" | "reset";
    target?: string;
    rel?: string;
    disabled?: boolean;
    class?: string;
    ariaLabel?: string;
}

const {
    href,
    type = "button",
    target,
    rel,
    disabled = false,
    class: className = "",
    ariaLabel,
} = Astro.props;

const classes = `btn ${className}`.trim();
---

{href ? (
<a class={classes} href={href} target={target} rel={rel} aria-label={ariaLabel}>
    <slot />
</a>
    ) : (
<button class={classes} type={type} disabled={disabled} aria-label={ariaLabel}>
    <slot />
</button>
    )}

<style>
    .btn {
        height: 56px;
        padding: 0 1.35rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;

        font-weight: 650;
        font-size: 1rem;
        letter-spacing: -0.01em;
        line-height: 1;

        cursor: pointer;
        user-select: none;
        text-decoration: none;

        border: 1px solid transparent;

        transition:
                transform 0.16s cubic-bezier(0.25, 0.8, 0.25, 1),
                background 0.16s cubic-bezier(0.25, 0.8, 0.25, 1),
                border-color 0.16s cubic-bezier(0.25, 0.8, 0.25, 1),
                box-shadow 0.16s cubic-bezier(0.25, 0.8, 0.25, 1),
                filter 0.16s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    /* Default: inverted against theme */
    .btn {
        background: var(--text);
        color: var(--bg);
        border-color: color-mix(in srgb, var(--text) 70%, transparent);
        box-shadow: 0 18px 42px rgba(7, 24, 38, 0.16);
    }

    /* Hover: nudge bg slightly so it's noticeable in both themes */
    .btn:hover {
        transform: translateY(-1px);
        background: color-mix(in srgb, var(--text) 88%, white); /* lighter ink */
        border-color: color-mix(in srgb, var(--text) 85%, white);
        box-shadow: 0 22px 56px rgba(7, 24, 38, 0.20);
    }

    /* Active */
    .btn:active {
        transform: translateY(0);
        filter: brightness(0.98);
    }

    /* Focus */
    .btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 5px rgba(178, 223, 219, 0.18), 0 18px 42px rgba(7, 24, 38, 0.18);
    }

    /* Disabled */
    .btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* If you want the shadow to flip in dark mode (optional but nice) */
    :root[data-theme="dark"] .btn {
        box-shadow: 0 18px 42px rgba(246, 244, 239, 0.08);
    }
    :root[data-theme="dark"] .btn:hover {
        box-shadow: 0 22px 56px rgba(246, 244, 239, 0.12);
    }

</style>