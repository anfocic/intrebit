---

const services = [
    {
        id: "development",
        title: "Development",
        tagline: "We build it. You own it.",
        description: "Custom software for your business — websites, apps, internal tools. No confusing jargon, no hidden costs.",
        icon: `<path d="M16 18l6-6-6-6"/><path d="M8 6l-6 6 6 6"/>`,
    },
    {
        id: "consulting",
        title: "Consulting",
        tagline: "Clarity before code.",
        description: "We'll look at how your business works, find the bottlenecks, and tell you what's worth fixing — honestly.",
        icon: `<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>`,
    },
    {
        id: "automation",
        title: "Automation",
        tagline: "Stop doing it manually.",
        description: "That repetitive task eating your week? We can make it run itself. Invoices, reports, data entry.",
        icon: `<path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/>`,
    },
];
---

<section class="services-section" aria-label="What we do">
    <div class="services-container">
        <header class="services-header">
            <p class="services-eyebrow">What we do</p>
            <h2 class="services-title">Build it right.<br/>Keep it running.</h2>
        </header>

        <div class="services-grid">
            {services.map((service) => (
                    <article class="service-card">

                        <h3 class="service-card__title">{service.title}</h3>
                        <p class="service-card__tagline">{service.tagline}</p>
                        <p class="service-card__description">{service.description}</p>
                    </article>
            ))}
        </div>
    </div>
</section>

<style is:global>
    .services-section {
        padding: 6rem 0;
        position: relative;
    }

    .services-container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header */
    .services-header {
        margin-bottom: 3rem;
    }

    .services-eyebrow {
        margin: 0 0 0.75rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
        opacity: 0.7;
    }

    .services-title {
        margin: 0;
        font-family: var(--font-brand, sans-serif),serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 750;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text);
    }

    /* Grid: 3 equal columns */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    /* Card */
    .service-card {
        padding: 1.75rem;
        border: 1px solid var(--border);
        border-radius: 16px;
        transition:
                transform 0.25s var(--ease, ease),
                border-color 0.25s var(--ease, ease),
                box-shadow 0.25s var(--ease, ease);
    }

    .service-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--text) 15%, var(--border));
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
    }

    /* Icon */
    .service-card__icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--text) 6%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        margin-bottom: 1.25rem;
        transition: color 0.2s ease, background 0.2s ease;
    }

    .service-card:hover .service-card__icon {
        color: var(--text);
        background: color-mix(in srgb, var(--text) 10%, transparent);
    }

    /* Text */
    .service-card__title {
        margin: 0 0 0.25rem;
        font-family: var(--font-brand, sans-serif);
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .service-card__tagline {
        margin: 0 0 0.75rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-muted);
    }

    .service-card__description {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-muted);
        opacity: 0.85;
    }

    /* Tablet: 2 columns */
    @media (max-width: 900px) {
        .services-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Mobile: 1 column */
    @media (max-width: 600px) {
        .services-section {
            padding: 4rem 0;
        }

        .services-container {
            padding: 0 1.25rem;
        }

        .services-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .services-title br {
            display: none;
        }

        .services-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .service-card {
            padding: 1.5rem;
        }
    }

    /* Light mode */
    :root[data-theme="light"] .service-card {
        box-shadow: 0 4px 20px rgba(14, 42, 71, 0.04);
    }

    :root[data-theme="light"] .service-card:hover {
        box-shadow: 0 12px 36px rgba(14, 42, 71, 0.08);
    }

    :root[data-theme="light"] .service-card__icon {
        background: rgba(14, 42, 71, 0.05);
    }

    :root[data-theme="light"] .service-card:hover .service-card__icon {
        background: rgba(14, 42, 71, 0.08);
    }
</style>