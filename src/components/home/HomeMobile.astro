---
import SectionDivider from "../shared/SectionDivider.astro";

import MobileAbout from "./mobile/MobileAbout.astro";
import MobileContact from "./mobile/MobileContact.astro";
import MobileHero from "./mobile/MobileHero.astro";
import MobileServices from "./mobile/MobileServices.astro";
import DelayedReveal from "../shared/DelayedReveal.astro";
---

<section class="wrap" aria-label="Home mobile">
    <MobileHero/>
    <SectionDivider/>

    <DelayedReveal delay={3.5}>
        <MobileServices/>
    </DelayedReveal>

    <SectionDivider/>

    <DelayedReveal delay={5.5}>
        <MobileAbout/>
    </DelayedReveal>

    <SectionDivider/>

    <DelayedReveal delay={7.5}>
        <MobileContact/>
    </DelayedReveal>
</section>

<style>
    .wrap {
        padding: 2.25rem 1.5rem 3rem;
        display: grid;
        gap: 1.75rem;
    }

    .divider {
        margin-top: 0.25rem;
    }

    @media (max-width: 420px) {
        .wrap {
            padding: 2rem 1.25rem 2.75rem;
        }
    }
</style>