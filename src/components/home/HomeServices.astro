---
import {services} from "../../config/site.ts";
import {home} from "../../config/copy.ts";

const c = home.services;
---

<section id="services" class="services" aria-label="Services" data-reveal>
    <div class="services__inner">
        <header class="services__header">
            <div>
                <h2 class="services__heading" set:html={c.heading}/>
            </div>
            <div class="services__intro">
                <p class="services__intro-body" set:html={c.intro}/>
            </div>
        </header>

        <div class="services__grid" data-reveal-stagger>
            {services.map((s, i) => (
                <a href={s.href} class="service-card" data-service={s.id}>
                    <h3 class="service-card__title">{s.title}.</h3>
                    <p class="service-card__outcome">{s.outcome}</p>
                    <p class="service-card__more">Find out more <span class="service-card__more-arrow">→</span></p>
                </a>
            ))}
        </div>
    </div>
</section>

<script>
    document.querySelectorAll('.service-card').forEach(card => {
        card.addEventListener('click', () => {
            const service = card.getAttribute('data-service');
            if (service) localStorage.setItem('contact-service', service);
        });
    });
</script>

<style>
    .services {
        padding: 100px var(--section-pad-x);
    }

    .services__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        width: 100%;
    }

    .services__header {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        margin-bottom: 48px;
        align-items: end;
    }

    .services__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(36px, 4.6vw, 56px);
        line-height: 0.98;
        margin: 12px 0 0;
        letter-spacing: -0.03em;
    }

    .services__intro {
        padding-bottom: 8px;
    }

    .services__intro-body {
        font-size: 17px;
        line-height: 1.55;
        color: var(--ink-2);
        margin: 0;
        max-width: 460px;
    }

    .services__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 64px;
    }

    .service-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        position: relative;
        padding: 24px 24px 24px 0;
        border-radius: 16px;
        transition: transform 0.3s var(--ease), background 0.3s var(--ease);
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    .service-card:hover {
        background: var(--surface);
    }

    .service-card:hover .service-card__title {
        color: var(--accent);
    }

    .service-card:hover .service-card__more {
        opacity: 1;
        transform: translateY(0);
    }

    .service-card:hover .service-card__more-arrow {
        transform: translateX(4px);
    }

    .service-card__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(32px, 3.6vw, 44px);
        margin: 0;
        letter-spacing: -0.025em;
        line-height: 1;
        color: var(--ink);
        transition: color 0.25s var(--ease);
    }

    .service-card__outcome {
        font-size: 17px;
        line-height: 1.4;
        color: var(--ink);
        margin: 0;
        font-weight: 500;
        letter-spacing: -0.005em;
        max-width: 320px;
    }

    .service-card__more {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--ink-3);
        margin: 8px 0 0;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .service-card__more-arrow {
        transition: transform 0.3s var(--ease);
    }

    @media (max-width: 900px) {
        .services {
            min-height: auto;
            padding: 56px var(--section-pad-x-mobile) 40px;
        }

        .services__header {
            grid-template-columns: 1fr;
            gap: 24px;
            margin-bottom: 48px;
        }

        .services__intro {
            padding-bottom: 0;
        }

        .services__grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .service-card {
            padding: 0;
        }

        .service-card__more {
            display: none;
        }
    }
</style>
