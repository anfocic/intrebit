---
import Heading from "../shared/Heading.astro";
import {services} from "../../config/site.ts";
---

<section class="services-section" aria-label="What we do">
    <div class="services-container">
        <Heading title="What we do " muted=" —  and we're good at it." align="left" mutedPosition="after" />

        <div class="services-grid">
            {services.map((service, index) => (
                    <article
                            class="service-card"
                            data-service={service.id}
                            data-card-index={index}
                    >
                        <!-- Background icon -->
                        <svg
                                class="service-card__bg-icon"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                set:html={service.icon}
                        />

                        <h3 class="service-card__title">{service.title}</h3>
                        <p class="service-card__description">{service.description}</p>
                    </article>
            ))}
        </div>
    </div>
</section>

<script>
    import {createSvgDraw, onClientReady} from "@lib";

    onClientReady(() => {
        const section = document.querySelector(".services-section");
        if (!section) return;

        createSvgDraw(".service-card__bg-icon path", {
            root: section,
            trigger: "scroll",
            scrollStart: "top 75%",
            duration: 3,
            stagger: 0.08,
            ease: "power2.out",
        });
    });
</script>

<style>
    /* Base */
    .services-container {
        max-width: var(--container-width, 1100px);
        margin: 0 auto;
        padding-top: 3rem;
    }

    .services-section {
        padding-bottom: 4rem;
    }

    /* Desktop */
    @media (min-width: 901px) {
        .services-section {
            padding-top: 2rem;
            padding-bottom: 6rem;
        }
    }

    /* Grid layout */
    .services-grid {
        display: grid;
        padding-top: 2rem;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    /* Card */
    .service-card {
        position: relative;
        overflow: hidden;
        padding: 1.5rem;
        gap: 1rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        min-height: 160px; /* Add back for desktop */
        transition:
                border-color 0.25s ease,
                box-shadow 0.25s ease;
    }

    .service-card:hover {
        border-color: color-mix(in srgb, var(--text) 15%, var(--border));
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
    }

    /* Background icon */
    .service-card__bg-icon {
        position: absolute;
        top: 0.3rem;
        right: .4rem;
        width: 70px;
        height: 70px;
        color: var(--text);
        opacity: 0.1;
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .service-card:hover .service-card__bg-icon {
        opacity: 0.2;
        transform: scale(1.05);
    }

    /* Mobile */
    @media (max-width: 600px) {
        .service-card {
            padding: 1.125rem;
        }

        .service-card__bg-icon {
            width: 50px;
            height: 50px;
        }
    }

    /* Content */
    .service-card__title {
        margin: 0 0 0.375rem;
        font-family: var(--font-brand, sans-serif), serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .service-card__description {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--text-muted);
        max-width: 90%;
    }

    /* Tablet */
    @media (max-width: 900px) {
        .services-grid {
            grid-template-columns: 1fr;
            gap: 0.75rem;
            max-width: 500px;
            margin: 0 auto;
        }

        .service-card {
            padding: 1.25rem;
        }

        .service-card__bg-icon {
            top: 1rem;
            right: 1rem;
            width: 60px;
            height: 60px;
        }

        .service-card__description {
            max-width: 80%;
        }
    }

    /* Mobile */
    @media (max-width: 600px) {
        .services-section {
            padding: 3.5rem 1.25rem;
        }

        .service-card {
            padding: 1.125rem;
        }

        .service-card__bg-icon {
            top: 0.875rem;
            right: 0.875rem;
            width: 50px;
            height: 50px;
        }

        .service-card__title {
            font-size: 1.1rem;
            margin-bottom: 0.25rem;
        }

        .service-card__description {
            font-size: 0.85rem;
            max-width: 75%;
        }
    }

    /* Light mode */
    :root[data-theme="light"] .service-card {
        box-shadow: 0 4px 20px rgba(14, 42, 71, 0.04);
    }

    :root[data-theme="light"] .service-card:hover {
        box-shadow: 0 12px 36px rgba(14, 42, 71, 0.08);
    }

    :root[data-theme="light"] .service-card__bg-icon {
        opacity: 0.1;
    }

    :root[data-theme="light"] .service-card:hover .service-card__bg-icon {
        opacity: 0.2;
    }

    /* Spinning automation icon */
    .service-card[data-service="automation"] .service-card__bg-icon {
        animation: spin 20s linear infinite;
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .service-card[data-service="automation"] .service-card__bg-icon {
            animation: none;
        }
    }

    @media (max-width: 900px) {
        .service-card {
            min-height: 160px;
            justify-content: space-between;
        }
    }

    /* Mobile */
    @media (max-width: 600px) {
        .service-card {
            min-height: 140px;
            justify-content: space-between;
        }
    }

    .service-card__description {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--text-muted);
        max-width: calc(100% - 5rem);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const prefersReduced = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
    const isDesktop = window.matchMedia("(min-width: 769px)").matches;

    const section = document.querySelector(".services-section");
    const cards = gsap.utils.toArray<HTMLElement>(".service-card");

    if (!prefersReduced && section && cards.length) {
        if (isDesktop) {
            gsap.set(cards, {
                opacity: 0,
                y: 50,
                filter: "blur(8px)"
            });

            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: section,
                    start: "top 65%",
                    end: "top 10%",
                    scrub: 0.6,
                    once: true
                }
            });

            cards.forEach((card, i) => {
                tl.to(card, {
                    opacity: 1,
                    y: 0,
                    filter: "blur(0px)",
                    duration: 1,
                    ease: "power2.out",
                }, i * 0.5);
            });
        } else {
            gsap.set(cards, {
                opacity: 0,
                y: 30,
            });

            cards.forEach((card) => {
                gsap.to(card, {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: card,
                        start: "top 65%",
                        toggleActions: "play none none none",
                    }
                });
            });
        }
    }
</script>