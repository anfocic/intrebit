---
import {services} from "../../config/site.ts";
import {home} from "../../config/copy.ts";

const c = home.services;
---

<section id="services" class="services" aria-label="Services" data-reveal>
    <div class="services__inner">
        <header class="services__header">
            <div>
                <h2 class="services__heading" set:html={c.heading}/>
            </div>
            <div class="services__intro">
                <p class="services__intro-body">{c.intro}</p>
            </div>
        </header>

        <div class="services__grid">
            {services.map((s, i) => (
                <article class="service-card" data-service={s.id}>
                    <span class="mono service-card__num">{String(i + 1).padStart(2, "0")}</span>
                    <h3 class="service-card__title">{s.title}.</h3>
                    <p class="service-card__outcome">{s.outcome}</p>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .services {
        padding: 100px var(--section-pad-x) 80px;
    }

    .services__inner {
        max-width: var(--container-width);
        margin: 0 auto;
    }

    .services__header {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        margin-bottom: 56px;
        align-items: end;
    }

    .services__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(36px, 4.6vw, 56px);
        line-height: 0.98;
        margin: 12px 0 0;
        letter-spacing: -0.03em;
    }

    .services__intro {
        padding-bottom: 8px;
    }

    .services__intro-body {
        font-size: 17px;
        line-height: 1.55;
        color: var(--ink-2);
        margin: 0;
        max-width: 460px;
    }

    .services__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 48px;
    }

    .service-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        position: relative;
        transition: transform 0.3s var(--ease);
        cursor: default;
    }

    .service-card__num {
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.14em;
        transition: color 0.25s var(--ease);
    }

    .service-card:hover .service-card__num {
        color: var(--accent);
    }

    .service-card:hover .service-card__title {
        color: var(--accent);
    }

    .service-card__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(32px, 3.6vw, 44px);
        margin: 0;
        letter-spacing: -0.025em;
        line-height: 1;
        color: var(--ink);
        transition: color 0.25s var(--ease);
    }

    .service-card__outcome {
        font-size: 17px;
        line-height: 1.4;
        color: var(--ink);
        margin: 0;
        font-weight: 500;
        letter-spacing: -0.005em;
        max-width: 320px;
    }

    @media (max-width: 900px) {
        .services {
            padding: 56px var(--section-pad-x-mobile) 40px;
        }

        .services__header {
            grid-template-columns: 1fr;
            gap: 24px;
            margin-bottom: 32px;
        }

        .services__intro {
            padding-bottom: 0;
        }

        .services__grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }
    }
</style>
