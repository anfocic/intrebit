---
import {contact} from "../../config/copy.ts";

const {faq} = contact;
const items = faq.items;
---

<section class="faq" aria-label="Frequently asked questions" data-reveal>
    <div class="faq__inner">
        <div class="faq__intro">
            <h2 class="faq__heading" set:html={faq.heading}/>
        </div>

        <div class="faq__list" data-faq-list>
            {items.map(([q, a], i) => (
                <details class="faq__item" name="faq" open={i === 0}>
                    <summary class="faq__q">
                        <span>{q}</span>
                        <span class="faq__toggle" aria-hidden="true"></span>
                    </summary>
                    <p class="faq__a">{a}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<style>
    .faq {
        --faq-bg: var(--bg);
        --faq-fg: var(--ink);
        --faq-rule: var(--rule);
        position: relative;
        overflow: hidden;
        padding: 80px var(--section-pad-x);
        background: var(--faq-bg);
        color: var(--faq-fg);
        border-top: 1px solid var(--rule);
    }

    .faq__glyph {
        position: absolute;
        left: var(--section-pad-x);
        bottom: 40px;
        color: var(--ink);
        pointer-events: none;
    }

    .faq__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 80px;
        position: relative;
    }

    .faq p {
        color: var(--faq-fg);
    }

    .faq .label {
        color: var(--accent);
    }

    .faq__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 6vw, 64px);
        line-height: 1;
        margin: 12px 0 0;
        letter-spacing: -0.03em;
        color: var(--faq-fg);
    }

    .faq__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .faq__list {
        margin-top: 24px;
    }

    .faq__item {
        border-bottom: 1px solid var(--faq-rule);
        interpolate-size: allow-keywords;
    }

    .faq__item::details-content {
        block-size: 0;
        overflow: clip;
        opacity: 0;
        transition:
            block-size 0.4s var(--ease),
            opacity 0.25s var(--ease),
            content-visibility 0.4s allow-discrete;
        transition-behavior: allow-discrete;
    }

    .faq__item[open]::details-content {
        block-size: auto;
        opacity: 1;
        transition:
            block-size 0.4s var(--ease),
            opacity 0.3s var(--ease) 0.08s;
    }

    .faq__q {
        list-style: none;
        cursor: pointer;
        padding: 20px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-display);
        font-size: 22px;
        letter-spacing: -0.015em;
        color: var(--faq-fg);
        gap: 16px;
    }

    .faq__q::-webkit-details-marker,
    .faq__q::marker {
        display: none;
        content: "";
    }

    .faq__toggle {
        position: relative;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        color: color-mix(in srgb, var(--faq-fg) 55%, var(--faq-bg) 45%);
        transition: color 0.25s var(--ease), transform 0.35s var(--ease);
    }

    .faq__item[open] .faq__toggle {
        color: var(--accent);
        transform: rotate(180deg);
    }

    .faq__toggle::before,
    .faq__toggle::after {
        content: "";
        position: absolute;
        background: currentColor;
        border-radius: 1px;
    }

    .faq__toggle::before {
        left: 0;
        right: 0;
        top: 50%;
        height: 1.5px;
        transform: translateY(-50%);
    }

    .faq__toggle::after {
        top: 0;
        bottom: 0;
        left: 50%;
        width: 1.5px;
        transform: translateX(-50%);
        transition: opacity 0.25s var(--ease);
    }

    .faq__item[open] .faq__toggle::after {
        opacity: 0;
    }

    .faq__a {
        margin: 0 0 20px;
        font-size: 15px;
        line-height: 1.55;
        color: color-mix(in srgb, var(--faq-fg) 80%, var(--faq-bg) 20%);
        max-width: 600px;
    }

    @media (max-width: 900px) {
        .faq {
            padding: 56px var(--section-pad-x-mobile);
        }

        .faq__glyph {
            display: none;
        }

        .faq__inner {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .faq__q {
            font-size: 18px;
        }
    }
</style>
