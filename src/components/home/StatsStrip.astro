---
const items = [
    {stat: "1 day", label: "to first reply", sub: "Real answer — not an auto-responder."},
    {stat: "4 weeks", label: "average to ship", sub: "From signed scope to live in production."},
    {stat: "Fixed", label: "price, signed up front", sub: "No hourly meter. No surprise invoices."},
    {stat: "100%", label: "yours from day one", sub: "Code, accounts, hosting — all in your name."},
];
---

<section class="strip" aria-label="How we're different" data-reveal data-reveal-stagger>
    <div class="strip__head">
        <span class="mono strip__head-label">— How we're different</span>
        <span class="mono strip__head-deco" aria-hidden="true">◆ ◆ ◆ ◆</span>
    </div>

    <div class="strip__grid">
        {items.map((it, i) => (
            <div class="strip__item">
                <span class="mono strip__index">0{i + 1}/04</span>
                <p class="strip__stat">{it.stat}</p>
                <p class="strip__label">{it.label}</p>
                <p class="strip__sub">{it.sub}</p>
            </div>
        ))}
    </div>
</section>

<style>
    .strip {
        max-width: var(--container-width);
        margin: 0 auto;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        background: var(--bg);
        position: relative;
    }

    .strip__head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 32px;
        border-bottom: 1px solid var(--rule);
    }

    .strip__head-label {
        font-size: 10px;
        color: var(--ink-3);
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .strip__head-deco {
        font-size: 10px;
        color: var(--ink-3);
        letter-spacing: 0.4em;
    }

    .strip__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .strip__item {
        padding: 48px 32px 40px;
        border-right: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
        gap: 10px;
        position: relative;
        min-height: 260px;
    }

    .strip__item:last-child {
        border-right: none;
    }

    .strip__index {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 10px;
        color: var(--ink-3);
        margin: 0;
    }

    .strip__stat {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(64px, 9vw, 132px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        color: var(--ink);
        margin: 0;
    }

    .strip__label {
        font-size: 16px;
        color: var(--ink);
        font-weight: 500;
        letter-spacing: -0.005em;
        margin: 16px 0 0;
    }

    .strip__sub {
        font-size: 13px;
        color: var(--ink-2);
        line-height: 1.5;
        margin: auto 0 0;
        padding-top: 12px;
        border-top: 1px dashed var(--rule-2);
    }

    @media (max-width: 900px) {
        .strip__head {
            padding: 12px 22px;
        }

        .strip__head-deco {
            display: none;
        }

        .strip__grid {
            grid-template-columns: 1fr 1fr;
        }

        .strip__item {
            padding: 32px 22px 28px;
            min-height: 220px;
        }

        .strip__item:nth-child(2n) {
            border-right: none;
        }

        .strip__item:nth-child(-n+2) {
            border-bottom: 1px solid var(--rule);
        }

        .strip__stat {
            font-size: clamp(48px, 12vw, 72px);
        }
    }

    @media (max-width: 520px) {
        .strip__grid {
            grid-template-columns: 1fr;
        }

        .strip__item {
            border-right: none;
            border-bottom: 1px solid var(--rule);
        }

        .strip__item:last-child {
            border-bottom: none;
        }
    }
</style>
