---
const items = [
    {
        n: "W/01",
        client: "Helix Logistics",
        kind: "Internal tool",
        year: "2026",
        blurb: "Replaced 4 spreadsheets with a single dispatching dashboard. Cut admin time by 60%.",
        tag1: "Build",
        tag2: "Internal dashboard",
    },
    {
        n: "W/02",
        client: "Marsala Coffee Co.",
        kind: "E-commerce",
        year: "2025",
        blurb: "Rebuilt the storefront and subscription flow. 3× faster checkout, fewer abandoned carts.",
        tag1: "Build",
        tag2: "Subscriptions",
    },
    {
        n: "W/03",
        client: "Kestrel Lab",
        kind: "Automation",
        year: "2025",
        blurb: "Automated weekly reporting across three CRMs. Saved ~12 hours per week.",
        tag1: "Automate",
        tag2: "Reporting",
    },
    {
        n: "W/04",
        client: "Bramble & Co.",
        kind: "Performance",
        year: "2025",
        blurb: "Audited and fixed a slow legacy site. Page loads from 4.1s to 380ms.",
        tag1: "Fix",
        tag2: "Performance",
    },
];

const slug = (s: string) => s.toLowerCase().replace(/[^a-z]/g, "-");
---

<section id="work" class="work" aria-label="Recent work" data-reveal>
    <div class="work__inner">
        <header class="work__header">
            <div>
                <p class="label">— Recent work</p>
                <h2 class="work__heading">A few recent <em>builds</em>.</h2>
            </div>
            <a href="/#work" class="mono work__see-all">See all work →</a>
        </header>

        <div class="work__rows">
            {items.map((w) => (
                <a href="/#work" class="work__row">
                    <span class="mono work__n">{w.n}</span>
                    <div class="work__client">
                        <p class="work__client-name">{w.client}</p>
                        <p class="mono work__client-meta">{w.kind} · {w.year}</p>
                    </div>
                    <div class="work__tags">
                        <span class="mono tag tag--solid">{w.tag1}</span>
                        <span class="mono tag tag--outline">{w.tag2}</span>
                    </div>
                    <p class="work__blurb">{w.blurb}</p>
                    <div class="work__thumb">
                        <span class="mono work__thumb-label">[ {slug(w.client)}.png ]</span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .work {
        padding: 100px var(--section-pad-x) 80px;
        border-top: 1px solid var(--rule);
    }

    .work__inner {
        max-width: var(--container-width);
        margin: 0 auto;
    }

    .work__header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 48px;
        gap: 24px;
    }

    .work__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 6vw, 64px);
        line-height: 1;
        margin: 12px 0 0;
        letter-spacing: -0.03em;
    }

    .work__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .work__see-all {
        font-size: 12px;
        color: var(--ink);
        border-bottom: 1px solid var(--ink);
        padding-bottom: 2px;
        text-decoration: none;
    }

    .work__rows {
        border-top: 1px solid var(--rule);
    }

    .work__row {
        display: grid;
        grid-template-columns: 60px 1.4fr 1fr 1.6fr 200px;
        align-items: center;
        gap: 24px;
        padding: 28px 0;
        border-bottom: 1px solid var(--rule);
        text-decoration: none;
        color: inherit;
        transition: background 0.25s var(--ease), padding 0.25s var(--ease);
    }

    .work__row:hover {
        background: var(--bg-2);
        padding-left: 16px;
        padding-right: 16px;
    }

    .work__n {
        font-size: 11px;
        color: var(--ink-3);
    }

    .work__client-name {
        font-family: var(--font-display);
        font-size: 28px;
        letter-spacing: -0.02em;
        line-height: 1.05;
        margin: 0;
        color: var(--ink);
    }

    .work__client-meta {
        font-size: 11px;
        color: var(--ink-3);
        margin: 4px 0 0;
    }

    .work__tags {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .tag {
        font-size: 11px;
        padding: 3px 8px;
    }

    .tag--solid {
        background: var(--ink);
        color: var(--bg);
    }

    .tag--outline {
        border: 1px solid var(--rule-2);
        color: var(--ink-2);
    }

    .work__blurb {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--ink-2);
    }

    .work__thumb {
        height: 80px;
        border: 1px solid var(--rule-2);
        background: repeating-linear-gradient(45deg, var(--bg-2), var(--bg-2) 6px, var(--bg) 6px, var(--bg) 12px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .work__thumb-label {
        font-size: 10px;
        color: var(--ink-3);
    }

    @media (max-width: 900px) {
        .work {
            padding: 56px var(--section-pad-x-mobile) 40px;
        }

        .work__header {
            flex-direction: column;
            gap: 16px;
            margin-bottom: 32px;
        }

        .work__row {
            grid-template-columns: 1fr;
            gap: 12px;
            padding: 20px 0;
        }

        .work__row:hover {
            padding-left: 0;
            padding-right: 0;
        }

        .work__thumb {
            height: 100px;
        }
    }
</style>
