---
import {home} from "../../config/copy.ts";

const {work} = home;
const items = work.items;
---

<section id="work" class="work" aria-label="Work" data-reveal>
    <div class="work__inner">
        <div class="work__layout">
            <div class="work__left">
                <header class="work__header">
                    <h2 class="work__heading" set:html={work.heading}/>
                </header>

                <ol class="work__rows" role="list">
                    {items.map((w) => {
                        const isLink = !!w.href;
                        const linkProps = isLink
                            ? {href: w.href, ...(w.external ? {target: "_blank", rel: "noopener"} : {})}
                            : {};
                        const yearMatch = w.year.match(/\d{4}/);
                        const yearAttr = yearMatch ? yearMatch[0] : undefined;
                        return (
                            <li class="work__item">
                                <article class:list={["work__row", {"work__row--link": isLink}]}>
                                    {isLink ? <a class="work__link" {...linkProps} aria-labelledby={`work-${w.n}-name`}/> : null}
                                    <header class="work__client">
                                        <div class="work__client-head">
                                            <h3 class="work__client-name" id={`work-${w.n}-name`}>{w.client}</h3>
                                            <span class:list={["mono", "work__status", `work__status--${w.status.toLowerCase().replace(/\s+/g, "-")}`]}>
                                                <span class="work__dot" aria-hidden="true"></span>
                                                <span class="sr-only">Status: </span>
                                                {w.status}
                                            </span>
                                        </div>
                                        <p class="mono work__client-meta">
                                            {w.kind} · <time datetime={yearAttr}>{w.year}</time>
                                        </p>
                                    </header>
                                    <p class="work__blurb">{w.blurb}</p>
                                    <span class="mono work__cta" aria-hidden="true">{isLink ? "→" : ""}</span>
                                </article>
                            </li>
                        );
                    })}
                </ol>
            </div>

        </div>
    </div>
</section>

<style>
    .work {
        padding: 100px var(--section-pad-x) 80px;
        border-top: 1px solid var(--rule);
    }

    .work__inner {
        max-width: var(--container-width);
        margin: 0 auto;
    }

    .work__layout {
        display: block;
    }

    .work__header {
        margin-bottom: 40px;
    }

    .work__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(36px, 4.6vw, 56px);
        line-height: 0.98;
        margin: 12px 0 0;
        letter-spacing: -0.03em;
    }

    .work__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .work__rows {
        list-style: none;
        padding: 0;
        margin: 0;
        border-top: 1px solid var(--rule);
    }

    .work__item {
        list-style: none;
    }

    .work__row {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1.4fr 24px;
        align-items: center;
        gap: 18px;
        padding: 22px 0;
        border-bottom: 1px solid var(--rule);
        color: inherit;
        transition: padding 0.25s var(--ease), background 0.25s var(--ease);
    }

    .work__client-head {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .work__link {
        position: absolute;
        inset: 0;
        z-index: 1;
        text-decoration: none;
    }

    .work__link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
    }

    .work__row--link:hover {
        background: var(--bg-2);
        padding-left: 12px;
        padding-right: 12px;
    }

    .work__row--link:hover .work__cta {
        color: var(--accent);
        transform: translateX(4px);
    }

    .work__status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 0;
        border: none;
        justify-self: start;
    }

    .work__dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
    }

    .work__status--ongoing .work__dot,
    .work__status--building .work__dot,
    .work__status--coming-soon .work__dot {
        animation: workPulse 1.8s ease-in-out infinite;
        box-shadow: 0 0 0 0 var(--accent);
    }

    @keyframes workPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
            opacity: 1;
        }
        50% {
            box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 0%, transparent);
            opacity: 0.6;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .work__status--ongoing .work__dot,
        .work__status--building .work__dot,
        .work__status--coming-soon .work__dot {
            animation: none;
        }
    }

    .work__status--shipped {
        color: var(--ink-3);
    }

    .work__status--building,
    .work__status--ongoing,
    .work__status--coming-soon {
        color: var(--accent);
    }

    .work__client-name {
        font-family: var(--font-display);
        font-size: 22px;
        letter-spacing: -0.02em;
        line-height: 1.05;
        margin: 0;
        color: var(--ink);
    }

    .work__client-meta {
        font-size: 11px;
        color: var(--ink-3);
        margin: 4px 0 0;
    }

    .work__blurb {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
        color: var(--ink-2);
    }

    .work__cta {
        font-size: 16px;
        color: var(--ink-3);
        transition: color 0.25s var(--ease), transform 0.25s var(--ease);
        justify-self: end;
    }

    .work__right {
        position: sticky;
        top: 100px;
        padding-left: 32px;
        border-left: 1px solid var(--rule);
    }

    .work__values-heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 24px;
        letter-spacing: -0.02em;
        margin: 12px 0 24px;
        color: var(--ink);
    }

    .work__values {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .work__value {
        padding-bottom: 18px;
        border-bottom: 1px solid var(--rule);
    }

    .work__value:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .work__value-title {
        font-size: 15px;
        font-weight: 500;
        color: var(--ink);
        margin: 0 0 6px;
        letter-spacing: -0.01em;
    }

    .work__value-body {
        font-size: 13px;
        line-height: 1.55;
        color: var(--ink-2);
        margin: 0;
    }

    @media (max-width: 1100px) {
        .work__layout {
            gap: 48px;
        }

        .work__row {
            grid-template-columns: 1fr 24px;
            gap: 14px;
        }

        .work__blurb {
            display: none;
        }
    }

    @media (max-width: 900px) {
        .work {
            padding: 56px var(--section-pad-x-mobile) 40px;
        }

        .work__layout {
            grid-template-columns: 1fr;
            gap: 48px;
        }

        .work__header {
            margin-bottom: 24px;
        }

        .work__row {
            grid-template-columns: 1fr;
            gap: 10px;
            padding: 20px 0;
        }

        .work__row--link:hover {
            padding-left: 0;
            padding-right: 0;
        }

        .work__blurb {
            display: block;
        }

        .work__cta {
            display: none;
        }

        .work__right {
            position: static;
            padding-left: 0;
            border-left: none;
            padding-top: 32px;
            border-top: 1px solid var(--rule);
        }
    }
</style>
