---
interface Props {
    heading?: string;
    paragraphs?: string[];
    ctaLabel?: string;
    ctaHref?: string;
    imageSrc?: string;
    imageAlt?: string;
}

const {
    heading = "We're millennials who got tired of the corporate grind.",
    paragraphs = [
        "No more 6am standups. No more “synergies.” No more pretending that 47-slide presentations are productive.",
        "We build software that's clean, efficient, and actually solves problems. We treat our team right. We ship quality work.",
        "If you're tired of corporate BS too, let's build something better. Or don't, it's your choice.",
    ],
    ctaLabel = "Read our story",
    ctaHref = "/about",
    imageSrc = "https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&q=80",
    imageAlt = "Team collaboration",
} = Astro.props;
---

<section class="section">
    <div class="container philosophy">
        <div class="philosophy__media">
            <img src={imageSrc} alt={imageAlt} loading="lazy" class="philosophy__image" />
        </div>

        <div class="philosophy__content">
            <h2>{heading}</h2>

            <div class="philosophy__text">
                {paragraphs.map((p) => (
                        <p>{p}</p>
                ))}
            </div>

            <a href={ctaHref} class="philosophy__cta">
                <button class="btn btn--outline">{ctaLabel}</button>
            </a>
        </div>
    </div>
</section>

<style>
    .section {
        padding: 5.5rem 0;
    }

    .philosophy {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 5rem;
        align-items: center;
    }

    .philosophy__media {
        width: 100%;
    }

    .philosophy__image {
        width: 100%;
        border-radius: var(--radius-soft);
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--border);
        background: var(--surface);
    }

    .philosophy__content h2 {
        margin-bottom: 1.4rem;
        max-width: 520px;
    }

    .philosophy__text {
        display: grid;
        gap: 1.2rem;
        margin-bottom: 2rem;
    }

    .philosophy__text p {
        font-size: 1.05rem;
        color: var(--text-muted);
        margin: 0;
        max-width: 560px;
    }

    .philosophy__cta {
        display: inline-flex;
    }

    /* Responsive */
    @media (max-width: 900px) {
        .philosophy {
            grid-template-columns: 1fr;
            gap: 2.75rem;
        }

        .section {
            padding: 4rem 0;
        }

        .philosophy__content h2 {
            max-width: none;
        }

        .philosophy__text p {
            max-width: none;
        }
    }
</style>