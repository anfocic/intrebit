---
const services = [
    {
        icon: "💻",
        title: "Custom Software",
        description: "Web apps, mobile apps, APIs—whatever you need. Built right, not rushed.",
    },
    {
        icon: "👥",
        title: "Outsourcing",
        description: "Need more hands on deck? We've got experienced developers, designers, and QA engineers ready to roll.",
    },
    {
        icon: "🏗️",
        title: "Infrastructure & Consulting",
        description: "Cloud architecture, DevOps, security—the boring stuff that actually matters.",
    },
];
---

<section class="section section--soft">
    <div class="container">
        <header class="section__header">
            <h2>What we do</h2>
            <p>Or at least we think we do.</p>
        </header>

        <div class="grid">
            {services.map((s) => (
                    <article class="card service-card">
                        <div class="service-card__icon">{s.icon}</div>
                        <h3>{s.title}</h3>
                        <p>{s.description}</p>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .section {
        padding: 5rem 0;
    }

    .section--soft {
        background: rgba(0, 0, 0, 0.01);
    }

    .section__header {
        text-align: center;
        max-width: 560px;
        margin: 0 auto 3rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
    }

    .service-card {
        padding: 2rem;
    }

    .service-card__icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(178, 223, 219, 0.22);
        font-size: 1.4rem;
        margin-bottom: 1.25rem;
    }

    @media (max-width: 900px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>