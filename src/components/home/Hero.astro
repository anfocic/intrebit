---
import {home} from "../../config/copy.ts";

const {hero} = home;
---

<section class="hero" aria-label="Hero">
    <div class="hero__inner">
        <p class="hero__eyebrow hero__anim" style="--d: 0ms">{hero.tagline}</p>

        <h1 class="hero__title hero__anim" style="--d: 120ms" set:html={hero.title}/>

        <div class="hero__grid">
            <p class="hero__lead hero__anim" style="--d: 340ms">{hero.lead}</p>

            <div class="hero__ctas hero__anim" style="--d: 500ms">
                <a class="hero__cta hero__cta--primary" href={hero.ctaPrimary.href}>
                    <span>{hero.ctaPrimary.label}</span>
                    <span class="hero__cta-arrow" aria-hidden="true">→</span>
                </a>
                <a class="hero__cta" href={hero.ctaSecondary.href}>
                    <span>{hero.ctaSecondary.label}</span>
                    <span class="hero__cta-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        padding: 80px var(--section-pad-x) 60px;
    }

    .hero__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .hero__orb {
        position: absolute;
        top: -10px;
        right: 0;
        color: var(--ink);
        pointer-events: none;
    }

    .hero__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(56px, 11vw, 132px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        margin: 0;
        max-width: 1100px;
        text-wrap: balance;
        position: relative;
    }

    .hero__title em {
        font-style: italic;
        color: var(--accent);
        display: inline-block;
        animation: hero-em-pop 1s var(--ease) 700ms both;
    }

    .hero__eyebrow {
        margin: 0 0 24px;
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .hero__anim {
        opacity: 0;
        transform: translateY(18px);
        animation: hero-rise 0.85s var(--ease) forwards;
        animation-delay: var(--d, 0ms);
    }

    @keyframes hero-rise {
        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes hero-em-pop {
        0% { transform: translateY(0) scale(1); }
        40% { transform: translateY(-4px) scale(1.02); }
        100% { transform: translateY(0) scale(1); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__anim,
        .hero__title em {
            opacity: 1;
            transform: none;
            animation: none;
        }
    }

    .hero__grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        margin-top: 64px;
        align-items: center;
    }

    .hero__lead {
        font-family: var(--font-sans);
        font-size: 20px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 0;
        max-width: 520px;
        text-wrap: pretty;
    }

    .hero__ctas {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
    }

    .hero__cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 4px;
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--ink);
        text-decoration: none;
        cursor: pointer;
        border-bottom: 1px solid var(--rule);
        transition: background 0.22s var(--ease), color 0.22s var(--ease), padding 0.22s var(--ease);
    }

    .hero__cta:last-child {
        border-bottom: none;
    }

    .hero__cta:hover {
        background: var(--ink);
        color: var(--bg);
        padding-left: 16px;
        padding-right: 16px;
    }

    .hero__cta-arrow {
        font-size: 16px;
        transition: transform 0.3s var(--ease), color 0.22s var(--ease);
    }

    .hero__cta--primary .hero__cta-arrow {
        color: var(--accent);
    }

    .hero__cta:hover .hero__cta-arrow {
        transform: translateX(6px);
    }

    .hero__cta--primary:hover .hero__cta-arrow {
        color: var(--bg);
    }

    @media (max-width: 900px) {
        .hero {
            padding: 64px var(--section-pad-x-mobile) 56px;
        }

        .hero__orb {
            opacity: 0.5;
            top: 20px;
            right: -40px;
        }

        .hero__title {
            font-size: 56px;
            line-height: 0.95;
            letter-spacing: -0.03em;
        }

        .hero__grid {
            grid-template-columns: 1fr;
            gap: 28px;
            margin-top: 48px;
            align-items: stretch;
        }

        .hero__lead {
            order: 1;
        }

        .hero__ctas {
            order: 2;
        }

        .hero__cta {
            padding: 24px 6px;
            font-size: 13px;
        }
    }
</style>
