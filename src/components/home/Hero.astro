---
import Button from "../shared/Button.astro";
---
<section class="hero" aria-label="Coming soon hero">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>

    <div class="hero__inner">
        <header class="hero__header">
            <h1 class="hero__title">intrebit</h1>
            <p class="hero__subtitle">
                <strong>Software, built properly.</strong><br/>
                <span class="hero__subtitle--soft">No buzzwords. No nonsense.</span>
            </p>
        </header>

        <p class="hero__availability">
            Open for new work.
        </p>

        <div class="hero__actions">
            <Button href="#contact" variant="primary">
                Get in touch
            </Button>
            <Button
                    href="https://www.linkedin.com/company/intrebit"
                    variant="ghost"
                    target="_blank"
                    rel="noopener noreferrer"
            >
                Follow us
            </Button>
        </div>

    </div>
</section>

<style>
    /* ---------- Hero ---------- */
    .hero {
        position: relative;
        flex: 1;
        display: grid;
        place-items: center;
        overflow: hidden;
        padding: 8rem 2rem 6rem;
    }

    .hero__inner {
        text-align: center;
        max-width: 650px;
        position: relative;
        z-index: 2;
        animation: fadeUp 0.8s ease-out both;
    }

    .hero__title {
        font-family: var(--font-brand), serif;
        letter-spacing: 0.05em;
        font-size: clamp(2.5rem, 7vw, 4rem);
        font-weight: 750;
        margin: 0 0 0.6rem;
        color: var(--brand-navy);
    }

    .hero__subtitle {
        margin: 0 auto 2.25rem;
        font-size: 1.15rem;
        color: var(--text-muted);
        max-width: 560px;
        line-height: 1.6;
    }

    .hero__actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }

    .hero__availability {
        margin: 0 0 1.2rem;
        font-size: 0.95rem;
        font-weight: 650;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--text-muted);
        opacity: 0.9;
        padding: 2rem 0;
    }

    .hero__availability {
        color: var(--brand-ivory);
    }

    .hero__title {
        color: var(--text) !important;
    }

    .hero__subtitle,
    .hero__subtitle strong,
    .hero__subtitle--soft {
        color: var(--text-muted) !important;
    }

    @media (max-height: 800px) {
        .hero { padding-bottom: 5rem; }
    }

    @media (max-width: 520px) {
        .hero {
            padding: 3.25rem 1.25rem 2.5rem;
        }

        .hero__subtitle {
            font-size: 1.05rem;
            margin-bottom: 1.75rem;
        }

        .hero__actions {
            margin-bottom: 1.75rem;
            gap: 0.75rem;
        }
    }
</style>