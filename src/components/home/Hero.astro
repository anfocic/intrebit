---
import OrbGlyph from "../shared/glyphs/OrbGlyph.astro";
---

<section class="hero" aria-label="Hero">
    <div class="hero__inner">
        <div class="hero__orb" aria-hidden="true">
            <OrbGlyph size={260}/>
        </div>

        <h1 class="hero__title">
            Software,<br/>
            built <em>properly</em>.
        </h1>

        <div class="hero__grid">
            <p class="hero__lead">
                We're a small studio handling the technical work small and
                mid-sized businesses don't have the headcount for.
                No buzzwords. No nonsense.
            </p>

            <div class="hero__ctas">
                <a class="btn btn--solid" href="/contact">
                    <span>Tell us what's broken</span><span class="btn__arrow">→</span>
                </a>
                <a class="btn btn--outline" href="/#work">
                    <span>Read the work</span><span class="btn__arrow">→</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        padding: 80px var(--section-pad-x) 60px;
    }

    .hero__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .hero__orb {
        position: absolute;
        top: -10px;
        right: 0;
        color: var(--ink);
        pointer-events: none;
    }

    .hero__title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(56px, 11vw, 132px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        margin: 0;
        max-width: 1100px;
        text-wrap: balance;
        position: relative;
    }

    .hero__title em {
        font-style: italic;
        color: var(--accent);
    }

    .hero__grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-top: 64px;
        align-items: end;
    }

    .hero__lead {
        font-family: var(--font-sans);
        font-size: 20px;
        line-height: 1.4;
        color: var(--ink-2);
        margin: 0;
        max-width: 380px;
        text-wrap: pretty;
    }

    .hero__ctas {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 14px;
        text-decoration: none;
        padding: 18px 24px;
        transition: transform 0.25s var(--ease);
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn__arrow {
        display: inline-block;
        margin-left: 12px;
        transition: transform 0.3s var(--ease);
    }

    .btn:hover .btn__arrow {
        transform: translateX(6px);
    }

    .btn--solid {
        background: var(--ink);
        color: var(--bg);
    }

    .btn--outline {
        border: 1px solid var(--rule-2);
        color: var(--ink);
    }

    @media (max-width: 900px) {
        .hero {
            padding: 32px var(--section-pad-x-mobile) 28px;
        }

        .hero__orb {
            opacity: 0.5;
            top: 20px;
            right: -40px;
        }

        .hero__title {
            font-size: 56px;
            line-height: 0.95;
            letter-spacing: -0.03em;
        }

        .hero__grid {
            grid-template-columns: 1fr;
            gap: 24px;
            margin-top: 24px;
        }

    }
</style>
