---
import Heading from "../shared/Heading.astro";
const principles = [
    { label: "How we think", text: "Clear thinking over corporate performance." },
    { label: "How we work", text: "Few clients. Direct communication." },
    { label: "Where we are", text: "Europe-based. Timezone-flexible." },
];
---

<section class="about" aria-label="About us">
    <Heading title=" About us" muted="a bit more — " align="right" mutedPosition="before" />

    <div class="principles">
        {principles.map((p) => (
                <div class="principle">
                    <div class="label">{p.label}</div>
                    <div class="value">{p.text}</div>
                </div>
        ))}
    </div>
</section>

<style>
    .about {
        max-width: 1100px;
        margin-inline: auto;
        padding: 4rem 2rem;
    }

    .principles {
        display: grid;
        padding-top: 1rem;
        gap: 0.9rem;
    }

    .principle {
        display: grid;
        gap: 0.25rem;
        padding: 0.85rem 0;
        border-bottom: var(--border) 1px solid;
    }

    .label {
        font-size: 1rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text);
        font-weight: 650;
    }

    .value {
        color: var(--text);
        opacity: 0.7;
        line-height: 1.5;
    }

    .principle:last-child {
        border-bottom: none;
    }

    @media (max-width: 600px) {
        .about {
            padding: 3.5rem 1.25rem;
        }
    }
</style>