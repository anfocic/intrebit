---
import Button from "../../shared/Button.astro";

const title = "intrebit";
const subtitle = "Software, built properly.";
const tagline = "No buzzwords. No nonsense.";

const proof = [
    { k: "Websites", v: "fast, clean, conversion-ready" },
    { k: "Internal apps", v: "tools your team actually uses" },
    { k: "Automation", v: "invoices, reports, admin" },
];
---

<section class="mhero" aria-label="Hero">
    <div class="mhero__inner">
        <header class="mhero__header">
            <h1 class="mhero__title" aria-label={title}>
        <span class="mhero__title-text">
          {title.split("").map((letter, i) => (
                  <span class={`hc hc-t${i}`}>{letter}</span>
          ))}
        </span>
                <span class="mhero__cursor" aria-hidden="true" />
            </h1>

            <p class="mhero__subtitle" aria-label={subtitle}>
                {subtitle.split("").map((letter, i) => (
                        <span class={`hc hc-s${i}`}>{letter === " " ? "\u00A0" : letter}</span>
                ))}
            </p>

            <p class="mhero__tagline" aria-label={tagline}>
                {tagline.split("").map((letter, i) => (
                        <span class={`hc hc-g${i}`}>{letter === " " ? "\u00A0" : letter}</span>
                ))}
            </p>
        </header>



        <p class="mhero__micro">
            Small team. Few clients. Direct communication.
        </p>
    </div>
</section>

<style is:global>
    /* Container */
    .mhero {
        padding: 1.75rem 1.25rem 1.25rem;
    }

    .mhero__inner {
        max-width: 720px;
        margin: 0 auto;
        display: grid;
        gap: 1.15rem; /* tighter rhythm */
    }

    .mhero__header {
        display: grid;
        gap: 0.45rem;
        text-align: left;
    }

    /* Title */
    .mhero__title {
        margin: 0;
        font-family: var(--font-brand), serif;
        letter-spacing: 0.04em;
        font-size: clamp(2.6rem, 11vw, 3.6rem);
        font-weight: 750;
        color: var(--text);

        display: inline-flex;
        align-items: baseline;
        gap: 0.25rem;
        line-height: 1.05;
    }

    .mhero__title-text {
        display: inline-flex;
    }

    /* Subtitle / tagline */
    .mhero__subtitle {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        font-size: 1.1rem;
        font-weight: 650;
        color: var(--text);
        line-height: 1.45;
    }

    .mhero__tagline {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        font-size: 1rem;
        color: var(--text-muted);
        opacity: 0.9;
        line-height: 1.5;
    }

    /* Typed animation base */
    .hc {
        display: inline-block;
        opacity: 0;
        animation: heroTypeIn 0.1s ease-out forwards;
    }

    @keyframes heroTypeIn {
        0% { opacity: 0; transform: translateY(4px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    /* Cursor */
    .mhero__cursor {
        display: inline-block;
        width: 3px;
        height: 0.78em;
        background: var(--text);
        border-radius: 2px;
        opacity: 0;
        animation:
                heroCursorAppear 0.1s ease-out 0.25s forwards,
                heroCursorBlink 0.9s ease-in-out 1.1s infinite;
    }

    @keyframes heroCursorAppear { to { opacity: 1; } }
    @keyframes heroCursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* Proof pills (adds content + reduces whitespace) */
    .mhero__proof {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
        margin-top: 0.35rem;
    }

    .mhero__pill {
        padding: 0.9rem 1rem;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.03);
        display: grid;
        gap: 0.2rem;
    }

    .mhero__pill-k {
        font-weight: 750;
        color: var(--text);
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .mhero__pill-v {
        color: var(--text-muted);
        opacity: 0.9;
        line-height: 1.35;
        font-size: 0.98rem;
    }

    /* Actions */
    .mhero__actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        opacity: 0;
        animation: heroFadeUp 0.45s ease-out 3.2s forwards;
        margin-top: 0.25rem;
    }

    @keyframes heroFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Micro line */
    .mhero__micro {
        margin: 0.25rem 0 0;
        color: var(--text-muted);
        opacity: 0.85;
        line-height: 1.45;
        font-size: 0.95rem;
    }

    /* ===== animation delays (keep your existing timing, shortened a bit) ===== */
    .hc-t0 { animation-delay: 0.22s; }
    .hc-t1 { animation-delay: 0.30s; }
    .hc-t2 { animation-delay: 0.38s; }
    .hc-t3 { animation-delay: 0.46s; }
    .hc-t4 { animation-delay: 0.54s; }
    .hc-t5 { animation-delay: 0.62s; }
    .hc-t6 { animation-delay: 0.70s; }
    .hc-t7 { animation-delay: 0.78s; }

    /* subtitle: "Software, built properly." */
    .hc-s0  { animation-delay: 0.95s; }
    .hc-s1  { animation-delay: 0.99s; }
    .hc-s2  { animation-delay: 1.03s; }
    .hc-s3  { animation-delay: 1.07s; }
    .hc-s4  { animation-delay: 1.11s; }
    .hc-s5  { animation-delay: 1.15s; }
    .hc-s6  { animation-delay: 1.19s; }
    .hc-s7  { animation-delay: 1.23s; }
    .hc-s8  { animation-delay: 1.27s; }
    .hc-s9  { animation-delay: 1.31s; }
    .hc-s10 { animation-delay: 1.35s; }
    .hc-s11 { animation-delay: 1.39s; }
    .hc-s12 { animation-delay: 1.43s; }
    .hc-s13 { animation-delay: 1.47s; }
    .hc-s14 { animation-delay: 1.51s; }
    .hc-s15 { animation-delay: 1.55s; }
    .hc-s16 { animation-delay: 1.59s; }
    .hc-s17 { animation-delay: 1.63s; }
    .hc-s18 { animation-delay: 1.67s; }
    .hc-s19 { animation-delay: 1.71s; }
    .hc-s20 { animation-delay: 1.75s; }
    .hc-s21 { animation-delay: 1.79s; }
    .hc-s22 { animation-delay: 1.83s; }
    .hc-s23 { animation-delay: 1.87s; }
    .hc-s24 { animation-delay: 1.91s; }

    /* tagline: "No buzzwords. No nonsense." */
    .hc-g0  { animation-delay: 2.05s; }
    .hc-g1  { animation-delay: 2.09s; }
    .hc-g2  { animation-delay: 2.13s; }
    .hc-g3  { animation-delay: 2.17s; }
    .hc-g4  { animation-delay: 2.21s; }
    .hc-g5  { animation-delay: 2.25s; }
    .hc-g6  { animation-delay: 2.29s; }
    .hc-g7  { animation-delay: 2.33s; }
    .hc-g8  { animation-delay: 2.37s; }
    .hc-g9  { animation-delay: 2.41s; }
    .hc-g10 { animation-delay: 2.45s; }
    .hc-g11 { animation-delay: 2.49s; }
    .hc-g12 { animation-delay: 2.53s; }
    .hc-g13 { animation-delay: 2.57s; }
    .hc-g14 { animation-delay: 2.61s; }
    .hc-g15 { animation-delay: 2.65s; }
    .hc-g16 { animation-delay: 2.69s; }
    .hc-g17 { animation-delay: 2.73s; }
    .hc-g18 { animation-delay: 2.77s; }
    .hc-g19 { animation-delay: 2.81s; }
    .hc-g20 { animation-delay: 2.85s; }
    .hc-g21 { animation-delay: 2.89s; }
    .hc-g22 { animation-delay: 2.93s; }
    .hc-g23 { animation-delay: 2.97s; }
    .hc-g24 { animation-delay: 3.01s; }
    .hc-g25 { animation-delay: 3.05s; }

    /* Smaller phones */
    @media (max-width: 420px) {
        .mhero { padding: 1.5rem 1.1rem 1.1rem; }
        .mhero__actions { grid-template-columns: 1fr; }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .hc { opacity: 1; animation: none; }
        .mhero__cursor { opacity: 1; animation: heroCursorBlink 1.2s ease-in-out infinite; }
        .mhero__actions { opacity: 1; animation: none; }
    }
</style>