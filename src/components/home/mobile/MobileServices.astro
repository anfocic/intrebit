---
import Heading from "../../shared/Heading.astro";
import Subcopy from "../../shared/Subcopy.astro";
import DelayedReveal from "../../shared/DelayedReveal.astro";
import { Paintbrush, Code, MessageCircle, Zap } from "lucide-astro";

const {
    href = "#contact",
    items = [
        {
            title: "Design",
            body: "UI/UX for websites and product interfaces.",
            icon: Paintbrush,
        },
        {
            title: "Development",
            body: "Websites, apps, and internal tools built to last.",
            icon: Code,
        },
        {
            title: "Consulting",
            body: "Find bottlenecks, cut the waste, ship what matters.",
            icon: MessageCircle,
        },
        {
            title: "Automation",
            body: "Invoices, reports, deployments — hands-off.",
            icon: Zap,
        },
    ],
} = Astro.props;
---

<DelayedReveal delay={5.2}>
    <Heading title="What we do" muted=" — and we're good at it" />

    <div class="services" role="list" aria-label="Services">
        {items.map(({ title, body, icon: Icon }) => (
                <a class="service-card" href={href} role="listitem" aria-label={`Contact us about ${title}`}>
                    <div class="service-card__header">
                        <Icon size={20} strokeWidth={1.75} />
                        <h3 class="service-card__title">{title}</h3>
                    </div>
                    <p class="service-card__body">{body}</p>
                </a>
        ))}
    </div>

    <div class="service__subcopy">
        <Subcopy>
            Tell us what you need. We’ll make it done right.
        </Subcopy>
    </div>
</DelayedReveal>

<style>
    .services {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .service-card {
        padding: 1.25rem;
        border-radius: 22px;
        text-decoration: none;
        background: var(--surface);
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        box-shadow:
                0 1px 2px rgba(0, 0, 0, 0.04),
                0 4px 12px rgba(0, 0, 0, 0.03);
    }

    .service-card__header {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
    }

    .service-card__title {
        margin: 0;
        font-size: 1.2rem;
        line-height: 1.1;
        letter-spacing: -0.015em;
        color: var(--text);
        font-weight: 750;
    }

    .service-card__body {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--text-muted);
    }

    .service__subcopy {
        margin-top: 2rem;
        text-align: center;
        text-wrap: nowrap;
    }

    @media (max-width: 480px) {
        .services {
            grid-template-columns: 1fr;
        }
    }
</style>