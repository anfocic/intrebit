---
import {Pencil, Code2, MessageCircleQuestion, Sparkles} from "lucide-astro";
import Heading from "../../shared/Heading.astro";
import Subcopy from "../../shared/Subcopy.astro";
import DelayedReveal from "../../shared/DelayedReveal.astro";

const {
    href = "#contact",
    items = [
        {title: "Design", icon: Pencil},
        {title: "Build", icon: Code2},
        {title: "Consulting", icon: MessageCircleQuestion},
        {title: "Automate", icon: Sparkles},
    ],
} = Astro.props;
---
<DelayedReveal delay={5.2}>

    <div class="service-heading">

    </div>
    <Heading title="What we do" muted=" — and we’re good at it"/>

    <div class="grid" role="list" aria-label="Services">
        {items.map(({title, icon: Icon}) => (
                <a class="chip" href={href} role="listitem" aria-label={`Go to contact: ${title}`}>
      <span class="icon" aria-hidden="true">
        <Icon size={18}/>
      </span>
                    <span class="text">{title}</span>
                </a>
        ))}
    </div>

    <div class="service__subcopy">
        <Subcopy>
            Websites, internal apps, honest consulting, and automations for the things you never want to do twice.
        </Subcopy>
    </div>
</DelayedReveal>

<style>

    .service-heading {
    }

    .grid {
        display: grid;
        padding: 1rem 0;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 0.25rem;
    }

    /* Premium “card chip” */
    .chip {
        display: flex;
        align-items: center;
        gap: 0.9rem;

        padding: 1.1rem 1.15rem;
        border-radius: 18px;
        text-decoration: none;

        /* subtle surface, not an outline */
        background: rgba(255, 255, 255, 0.045);
        border: 1px solid rgba(255, 255, 255, 0.09);

        /* depth */
        box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.07),
                0 18px 45px rgba(0, 0, 0, 0.22);

        /* typography */
        color: rgba(255, 255, 255, 0.88);

        transition:
                transform 0.18s var(--ease),
                background 0.18s var(--ease),
                border-color 0.18s var(--ease),
                box-shadow 0.18s var(--ease);
    }

    .chip:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.14);
        box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 24px 60px rgba(0, 0, 0, 0.28);
    }

    .chip:active {
        transform: translateY(0);
    }

    /* Icon chip looks “designed” */
    .icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;

        display: grid;
        place-items: center;
        flex: 0 0 auto;

        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.10);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);

        color: rgba(255, 255, 255, 0.90); /* makes lucide pop */
    }

    .icon :global(svg) {
        stroke: currentColor;
    }

    .text {
        font-weight: 650;
        letter-spacing: -0.01em;
        line-height: 1;
        color: rgba(255, 255, 255, 0.86); /* remove the “disabled” look */
    }

    /* Keep 2x2 on normal phones; only stack on tiny widths */
    @media (max-width: 360px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

    .service__subcopy {
        padding: 0 1rem;
    }
</style>