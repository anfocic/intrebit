---
import Heading from "../../shared/Heading.astro";
import MetaLink from "../../shared/MetaLink.astro";

const principles = [
    { label: "Who we are", text: "Millennials done with corporate theatre." },
    { label: "How we work", text: "Few clients. Direct communication. No surprises." },
    { label: "Where we are", text: "Europe-based. Timezone-flexible." },
];
---

<section class="about" aria-label="About us">
    <Heading title="About us" align="right" />

    <div class="principles">
        {principles.map((p) => (
                <div class="principle">
                    <div class="label">{p.label}</div>
                    <div class="value">{p.text}</div>
                </div>
        ))}
    </div>

    <div class="meta">
        <MetaLink href="/about" line1="We’re not for everyone." line2="Read how we work →" />
    </div>
</section>

<style>
    .about {
        margin-top: 1.75rem;
        padding-top: 2.75rem;
    }

    .principles {
        display: grid;
        gap: 0.9rem;
    }

    .principle {
        display: grid;
        gap: 0.25rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .label {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text);
        opacity: 0.75;
        font-weight: 650;
    }

    .value {
        color: var(--text);
        opacity: 0.9;
        line-height: 1.5;
    }

    .meta {
        margin-top: 1.25rem;
    }
</style>