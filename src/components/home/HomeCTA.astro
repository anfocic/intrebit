---
import AsteriskGlyph from "../shared/glyphs/AsteriskGlyph.astro";

const blocks = [
    ["Get in touch", "We'll reply with a straight answer within a day."],
    ["What to include", "Deadline, budget range, what you've tried."],
    ["What happens next", "A couple of questions, then a proposal. Or an honest no."],
];
---

<section class="cta" aria-label="Contact us" data-reveal>
    <div class="cta__glyph" aria-hidden="true">
        <AsteriskGlyph size={200}/>
    </div>

    <div class="cta__inner">
        <p class="label cta__label">— Let's talk</p>

        <h2 class="cta__heading">
            Tell us what's broken<br/>
            <em>— or what you want built.</em>
        </h2>

        <div class="cta__grid">
            {blocks.map(([t, b]) => (
                <div>
                    <p class="mono cta__block-label">{t}</p>
                    <p class="cta__block-body">{b}</p>
                </div>
            ))}
        </div>

        <a class="cta__email" href="mailto:hello@intrebit.com">
            <span>hello@intrebit.com</span>
            <span class="cta__email-arrow">→</span>
        </a>
    </div>
</section>

<style>
    .cta {
        position: relative;
        overflow: hidden;
        padding: 100px var(--section-pad-x);
        background: var(--ink);
        color: var(--bg);
        border-top: 1px solid var(--rule);
    }

    .cta__glyph {
        position: absolute;
        right: var(--section-pad-x);
        top: 60px;
        color: var(--bg);
        opacity: 0.5;
        pointer-events: none;
    }

    .cta__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .cta__label {
        color: color-mix(in srgb, var(--bg) 60%, var(--ink) 40%);
    }

    .cta__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(56px, 9vw, 120px);
        line-height: 0.95;
        margin: 16px 0 0;
        letter-spacing: -0.04em;
        text-wrap: balance;
        color: var(--bg);
    }

    .cta__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .cta__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-top: 64px;
        padding-top: 32px;
        border-top: 1px solid color-mix(in srgb, var(--bg) 13%, transparent);
    }

    .cta__block-label {
        font-size: 11px;
        color: color-mix(in srgb, var(--bg) 60%, var(--ink) 40%);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin: 0;
    }

    .cta__block-body {
        font-size: 15px;
        line-height: 1.55;
        color: color-mix(in srgb, var(--bg) 85%, var(--ink) 15%);
        margin: 12px 0 0;
    }

    .cta__email {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 48px;
        padding: 20px 28px;
        background: var(--accent);
        color: var(--accent-ink);
        font-family: var(--font-mono);
        font-size: 14px;
        text-decoration: none;
        transition: transform 0.25s var(--ease);
    }

    .cta__email:hover {
        transform: translateY(-2px);
    }

    .cta__email-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .cta__email:hover .cta__email-arrow {
        transform: translateX(6px);
    }

    @media (max-width: 900px) {
        .cta {
            padding: 56px var(--section-pad-x-mobile);
        }

        .cta__glyph {
            display: none;
        }

        .cta__grid {
            grid-template-columns: 1fr;
            gap: 24px;
            margin-top: 40px;
            padding-top: 24px;
        }
    }
</style>
