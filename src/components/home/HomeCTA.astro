---
import {home} from "../../config/copy.ts";

const {cta} = home;
---

<section class="cta" aria-label="Contact us" data-reveal>
    <div class="cta__inner">
        <h2 class="cta__heading" transition:name="cta-heading" set:html={cta.heading}/>

        <a class="cta__button" href={cta.button.href} transition:name="cta-button">
            <span>{cta.button.label}</span>
            <span class="cta__button-arrow">→</span>
        </a>
    </div>
</section>

<style>
    .cta {
        --cta-bg: #071826;
        --cta-fg: #f6f4ef;
        position: relative;
        overflow: hidden;
        padding: 100px var(--section-pad-x);
        background: var(--cta-bg);
        color: var(--cta-fg);
        border-top: 1px solid var(--rule);
    }

    :global([data-theme="dark"]) .cta {
        --cta-bg: #f6f4ef;
        --cta-fg: #071826;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme])) .cta {
            --cta-bg: #f6f4ef;
            --cta-fg: #071826;
        }
    }

    .cta__glyph {
        position: absolute;
        right: var(--section-pad-x);
        top: 60px;
        color: var(--bg);
        opacity: 0.5;
        pointer-events: none;
    }

    .cta__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .cta__label {
        color: var(--accent);
    }

    .cta__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(56px, 9vw, 120px);
        line-height: 0.95;
        margin: 16px 0 0;
        letter-spacing: -0.04em;
        text-wrap: balance;
        color: var(--cta-fg);
    }

    .cta__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .cta__lead {
        font-size: 18px;
        line-height: 1.55;
        color: color-mix(in srgb, var(--cta-fg) 80%, var(--cta-bg) 20%);
        margin: 32px 0 0;
        max-width: 640px;
    }

    .cta__button {
        display: inline-flex;
        align-items: center;
        gap: 20px;
        margin-top: 56px;
        padding: 28px 40px;
        background: var(--accent);
        color: var(--accent-ink);
        font-family: var(--font-mono);
        font-size: 18px;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: transform 0.25s var(--ease);
    }

    .cta__button:hover {
        transform: translateY(-2px);
    }

    .cta__button-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .cta__button:hover .cta__button-arrow {
        transform: translateX(6px);
    }

    .cta__meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin: 24px 0 0;
        font-size: 11px;
        color: color-mix(in srgb, var(--cta-fg) 55%, var(--cta-bg) 45%);
        letter-spacing: 0.05em;
    }

    .cta__meta-sep {
        color: color-mix(in srgb, var(--cta-fg) 30%, var(--cta-bg) 70%);
    }

    @media (max-width: 900px) {
        .cta {
            padding: 56px var(--section-pad-x-mobile);
        }

        .cta__glyph {
            display: none;
        }

        .cta__button {
            margin-top: 32px;
            padding: 22px 28px;
            font-size: 15px;
        }
    }
</style>
