---
import {home} from "../../config/copy.ts";

const {studio} = home;
---

<section id="studio" class="studio" aria-label="The studio" data-reveal>
    <div class="studio__inner">
        <header class="studio__opener">
            <h2 class="studio__heading" set:html={studio.heading}/>
        </header>

        <article class="studio__article">
            <p class="studio__lede">
                <span class="studio__dropcap">{studio.article.ledeDropcap}</span><span set:html={studio.article.lede}/>
            </p>

            <p class="studio__body studio__body--last">{studio.article.closing}</p>
        </article>

    </div>
</section>

<style>
    .studio {
        position: relative;
        overflow: hidden;
        padding: 120px var(--section-pad-x) 100px;
        background: var(--bg);
        border-top: 1px solid var(--rule);
    }

    .studio__glyph {
        position: absolute;
        color: var(--ink);
        pointer-events: none;
    }

    .studio__glyph--orb {
        right: -60px;
        top: -40px;
        opacity: 0.5;
    }

    .studio__glyph--grid {
        left: 32px;
        bottom: 32px;
        opacity: 0.6;
    }

    .studio__inner {
        max-width: var(--container-width);
        margin: 0 auto;
        position: relative;
    }

    .studio__opener {
        max-width: 660px;
        margin: 0 auto 56px;
    }

    .studio__heading {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 5vw, 64px);
        line-height: 0.95;
        margin: 12px 0 0;
        letter-spacing: -0.035em;
        color: var(--ink);
    }

    .studio__heading em {
        font-style: italic;
        color: var(--accent);
    }

    .studio__intro-meta {
        font-size: 11px;
        color: var(--ink-3);
        margin: 0;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .studio__article {
        max-width: 660px;
        margin: 0 auto;
        position: relative;
    }

    .studio__lede {
        font-family: var(--font-display);
        font-size: clamp(22px, 2.4vw, 28px);
        line-height: 1.35;
        letter-spacing: -0.012em;
        color: var(--ink);
        margin: 0 0 32px;
        text-wrap: pretty;
        text-align: justify;
        hyphens: auto;
    }

    .studio__dropcap {
        float: left;
        font-family: var(--font-display);
        font-size: 96px;
        line-height: 0.85;
        letter-spacing: -0.04em;
        color: var(--accent);
        padding: 6px 14px 0 0;
        margin: 0;
        font-weight: 400;
    }

    .studio__pullquote {
        position: relative;
        margin: 56px 0 56px -120px;
        padding: 8px 0 8px 32px;
        max-width: 460px;
        border-left: 2px solid var(--accent);
    }

    .studio__pullquote-mark {
        position: absolute;
        left: 0;
        top: -20px;
        font-family: var(--font-display);
        font-size: 80px;
        line-height: 1;
        color: var(--accent);
        letter-spacing: -0.04em;
    }

    .studio__pullquote-body {
        font-family: var(--font-display);
        font-style: italic;
        font-size: clamp(26px, 3vw, 36px);
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 0;
        text-wrap: balance;
    }

    .studio__pullquote-body em {
        color: var(--accent);
    }

    .studio__body {
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink-2);
        margin: 0 0 24px;
        text-wrap: pretty;
        max-width: 580px;
    }

    .studio__body--last {
        font-family: var(--font-display);
        font-size: 22px;
        line-height: 1.4;
        letter-spacing: -0.012em;
        color: var(--ink);
        margin-top: 32px;
        padding-top: 32px;
        border-top: 1px solid var(--rule);
    }

    .studio__ledger {
        margin-top: 80px;
        padding-top: 24px;
        border-top: 1px solid var(--rule);
    }

    .studio__ledger-meta {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 24px;
        flex-wrap: wrap;
        margin: 0 0 32px;
    }

    .studio__ledger-label {
        color: var(--ink-3);
        margin: 0;
    }

    .studio__ledger-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
    }

    .studio__ledger-item {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-right: 20px;
        border-right: 1px solid var(--rule);
    }

    .studio__ledger-item:last-child {
        border-right: none;
    }

    .studio__ledger-n {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(48px, 5vw, 72px);
        line-height: 0.85;
        letter-spacing: -0.04em;
        color: var(--ink);
        display: inline-flex;
        align-items: baseline;
    }

    .studio__ledger-unit {
        font-size: 0.4em;
        color: var(--ink-3);
        letter-spacing: 0;
        margin-left: 2px;
    }

    .studio__ledger-body {
        font-size: 13px;
        line-height: 1.5;
        color: var(--ink-2);
        font-family: var(--font-mono);
    }

    @media (max-width: 900px) {
        .studio {
            padding: 64px var(--section-pad-x-mobile) 56px;
        }

        .studio__glyph--orb {
            opacity: 0.3;
            right: -100px;
        }

        .studio__glyph--grid {
            display: none;
        }

        .studio__opener {
            margin-bottom: 32px;
        }

        .studio__intro-meta {
            gap: 12px;
        }

        .studio__article {
            margin-left: 0;
            max-width: 100%;
        }

        .studio__lede {
            font-size: 20px;
        }

        .studio__dropcap {
            font-size: 72px;
            padding: 4px 10px 0 0;
        }

        .studio__pullquote {
            margin: 32px 0;
            padding-left: 20px;
            max-width: 100%;
        }

        .studio__pullquote-mark {
            font-size: 56px;
            top: -12px;
        }

        .studio__pullquote-body {
            font-size: 22px;
        }

        .studio__body {
            font-size: 16px;
        }

        .studio__body--last {
            font-size: 18px;
        }

        .studio__ledger {
            margin-top: 48px;
        }

        .studio__ledger-list {
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .studio__ledger-item {
            padding-right: 0;
            padding-bottom: 16px;
            border-right: none;
            border-bottom: 1px solid var(--rule);
        }

        .studio__ledger-item:nth-last-child(-n+2) {
            border-bottom: none;
            padding-bottom: 0;
        }
    }
</style>
