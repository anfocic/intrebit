---
const title = "intrebit";
const subtitle = "Software, built properly.";
const tagline1 = "No buzzwords. No nonsense.";
---

<section class="hero-section" aria-label="Hero">
    <div class="hero-inner">
        <header class="hero-header">
            <h1 class="hero-title">
        <span class="hero-title-text" aria-label={title}>
          {title.split("").map((letter, i) => (
                  <span class="hc" data-line="title" data-i={i}>{letter}</span>
          ))}
        </span>
            </h1>

            <p class="hero-subtitle" aria-label={subtitle}>
                {subtitle.split("").map((letter, i) => (
                        <span class="hc" data-line="subtitle" data-i={i}>
            {letter === " " ? "\u00A0" : letter}
          </span>
                ))}
            </p>

            <p class="hero-tagline" aria-label={`${tagline1}}`}>
                {tagline1.split("").map((letter, i) => (
                        <span class="hc" data-line="tagline" data-i={i}>
            {letter === " " ? "\u00A0" : letter}
          </span>
                ))}
                <br />
            </p>
        </header>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    const prefersReduced =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!prefersReduced) {
        // --- Option C: mask reveal the title, then fade up the other lines
        gsap.set(".hero-title", { opacity: 0, y: 18, clipPath: "inset(0 0 100% 0)" });
        gsap.set([".hero-subtitle", ".hero-tagline", ".hero-easteregg"], { opacity: 0, y: 14 });
        gsap.set(".hero-section", { backgroundPosition: "50% 0%" });

        const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

        tl.to(".hero-title", {
            opacity: 1,
            y: 0,
            clipPath: "inset(0 0 0% 0)",
            duration: 0.9,
        })
            .to(
                [".hero-subtitle", ".hero-tagline"],
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.15,
                },
                "-=0.35"
            )
            .to(
                ".hero-easteregg",
                {
                    opacity: 0.85,
                    y: 0,
                    filter: "blur(0px)",
                    duration: 0.5,
                },
                "+=0.15"
            );

        // 1) Breathing title (subtle idle motion)
        // Use a tiny y shift; it's "felt", not noticed.
        gsap.to(".hero-title", {
            y: -2,
            duration: 3.6,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 0.8, // start after intro begins
        });

        // 2) Hover letter lift (title only)
        const titleEl = document.querySelector(".hero-title");
        const titleLetters = ".hero-title .hc";

        titleEl?.addEventListener("mouseenter", () => {
            gsap.to(titleLetters, {
                y: -4,
                duration: 0.25,
                stagger: 0.02,
                ease: "power2.out",
                overwrite: "auto",
            });
        });

        titleEl?.addEventListener("mouseleave", () => {
            gsap.to(titleLetters, {
                y: 0,
                duration: 0.3,
                stagger: 0.02,
                ease: "power2.out",
                overwrite: "auto",
            });
        });

        // 3) Soft background drift (ambient)
        gsap.to(".hero-section", {
            backgroundPosition: "50% 12%",
            duration: 12,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        // (keep your existing extras)
        window.addEventListener("scroll", () => {
            const y = window.scrollY;
            gsap.to(".hero-inner", {
                y: y * 0.08,
                opacity: Math.max(1 - y / 600, 0.85),
                overwrite: true,
                duration: 0.3,
            });
        });

        const hero = document.querySelector(".hero-inner");

        hero?.addEventListener("mousemove", (e) => {
            const rect = hero.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;

            gsap.to(".hero-title", {
                x: x * 0.02,
                y: y * 0.02,
                duration: 0.4,
                ease: "power3.out",
                overwrite: true,
            });
        });

        hero?.addEventListener("mouseleave", () => {
            gsap.to(".hero-title", {
                x: 0,
                y: 0,
                duration: 0.6,
                ease: "power3.out",
                overwrite: true,
            });
        });
    } else {
        // Reduced motion: show everything immediately (and skip all loops)
        gsap.set([".hero-title", ".hero-subtitle", ".hero-tagline", ".hero-easteregg"], {
            opacity: 1,
            y: 0,
            clipPath: "none",
            filter: "none",
        });
    }
</script>


<style>
    .hero-section {
        min-height: calc(100svh - var(--header-height, 72px));
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero-inner {
        text-align: center;
        width: 100%;
        max-width: 750px;
        margin: 0 auto;
        position: relative;
    }

    .hero-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 2.5rem;
    }

    /* ---------- Title ---------- */
    .hero-title {
        font-family: var(--font-brand), serif;
        letter-spacing: 0.04em;
        font-size: clamp(3rem, 10vw, 5.5rem);
        font-weight: 750;
        margin: 0 0 1.5rem;
        color: var(--text);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        will-change: transform, opacity, clip-path;
    }

    .hero-title-text {
        display: inline-flex;
    }

    /* ---------- Subtitle & Tagline ---------- */
    .hero-subtitle {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0 0 0.5rem;
        font-size: clamp(1.1rem, 2.5vw, 1.35rem);
        font-weight: 600;
        color: var(--text);
        line-height: 1.5;
        will-change: transform, opacity;
    }

    .hero-tagline {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.15rem);
        color: var(--text-muted);
        line-height: 1.5;
        will-change: transform, opacity;
    }

    .hc {
        display: inline-block;
    }

    .hero-easteregg {
        display: block;
        margin-top: 0.25rem;
        font-style: italic;
        opacity: 0;
        transform: translateY(6px);
        filter: blur(6px);
        will-change: opacity, transform, filter;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 520px) {
        .hero-section {
            padding: 3rem 1.25rem 2.5rem;
            min-height: calc(100vh - 60px);
            min-height: calc(100svh - 60px);
        }

        .hero-title {
            font-size: clamp(2.5rem, 12vw, 3.5rem);
            margin-bottom: 1.25rem;
        }

        .hero-subtitle {
            font-size: 1.05rem;
        }

        .hero-tagline {
            font-size: 0.95rem;
        }

        .hero-header {
            margin-bottom: 2rem;
        }
    }

    /* ---------- Reduced motion ---------- */
    @media (prefers-reduced-motion: reduce) {
        .hero-title,
        .hero-subtitle,
        .hero-tagline,
        .hero-easteregg {
            opacity: 1 !important;
            transform: none !important;
            filter: none !important;
            clip-path: none !important;
        }
    }
</style>