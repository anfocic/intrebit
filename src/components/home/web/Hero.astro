---
const title = "intrebit";
const subtitle = "Software, built properly.";
const tagline = "No buzzwords. No nonsense.";
---

<section class="hero-section" aria-label="Hero">
    <div class="hero-inner">
        <header class="hero-header">
            <h1 class="hero-title">
                <span class="hero-title-text" aria-label={title}>
                    {title}
                </span>
            </h1>

            <p class="hero-subtitle" aria-label={subtitle}>
                {subtitle}
            </p>

            <p class="hero-tagline" aria-label={tagline}>
                {tagline}
            </p>
        </header>
    </div>
</section>
<script>
    import * as lib from "@lib";
    console.log("lib keys", Object.keys(lib));
</script>

<script>
    import { createHoverLift, createRevealSequence } from "@lib";



    const run = () => {
        const root = document.querySelector(".hero-section");
        if (!root) return;

        createRevealSequence({
            root,
            title: ".hero-title",
            text: ".hero-subtitle, .hero-tagline",
            titleDuration: 0.9,
            textDuration: 0.6,
            stagger: 0.15,
        });

        createHoverLift(".hero-title", {
            y: -2,
            scale: 1.05,
            durationIn: 0.25,
            durationOut: 0.3,
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", run, { once: true });
    } else {
        run();
    }
</script>

<style>


    .hero-section {
        min-height: calc(100svh - var(--header-height, 72px));
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero-inner {
        text-align: center;
        width: 100%;
        max-width: 750px;
        margin: 0 auto;
        position: relative;
    }

    .hero-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 2.5rem;
    }

    /* ---------- Title ---------- */
    .hero-title {
        font-family: var(--font-brand), serif;
        letter-spacing: 0.04em;
        font-size: clamp(3rem, 10vw, 5.5rem);
        font-weight: 750;
        margin: 0 0 1.5rem;
        color: var(--text);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        will-change: transform, opacity, clip-path;
        cursor: default; /* or pointer if it’s a link */
        transform-origin: center;
    }

    .hero-title-text {
        display: inline-flex;
    }

    /* ---------- Subtitle & Tagline ---------- */
    .hero-subtitle {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0 0 0.5rem;
        font-size: clamp(1.1rem, 2.5vw, 1.35rem);
        font-weight: 600;
        color: var(--text);
        line-height: 1.5;
        will-change: transform, opacity;
    }

    .hero-tagline {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.15rem);
        color: var(--text-muted);
        line-height: 1.5;
        will-change: transform, opacity;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 520px) {
        .hero-section {
            padding: 3rem 1.25rem 2.5rem;
            min-height: calc(100svh - 60px);
        }

        .hero-title {
            font-size: clamp(2.5rem, 12vw, 3.5rem);
            margin-bottom: 1.25rem;
        }

        .hero-subtitle {
            font-size: 1.05rem;
        }

        .hero-tagline {
            font-size: 0.95rem;
        }

        .hero-header {
            margin-bottom: 2rem;
        }
    }

    /* ---------- Reduced motion ---------- */
    @media (prefers-reduced-motion: reduce) {
        .hero-title,
        .hero-subtitle,
        .hero-tagline {
            opacity: 1 !important;
            transform: none !important;
            filter: none !important;
            clip-path: none !important;
        }
    }
</style>