---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/base.css";

import Footer from "../components/footer/Footer.astro";
import Header from "../components/header/Header.astro";
import {buildSEO, type SEOOverrides} from "../config/seo.ts";


interface Props {
    title?: string;
    seo?: SEOOverrides;
}

const {
    title,
    seo: seoOverrides = {},
} = Astro.props;

const seo = buildSEO(Astro.url, {
    ...seoOverrides,
    ...(title ? {title} : {}),
});
---

<!doctype html>
<html lang="en" data-theme="">
<head>
    <script is:inline src="/scripts/theme.js"/>
    <script is:inline src="/scripts/mobile-nav.js" defer/>
    <!-- Favicons -->
    <link rel="icon" href="/favicons/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Fonts -->
    <link rel="preload" href="/fonts/inter/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/space-grotesk/SpaceGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Meta -->
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description}/>
    <link rel="canonical" href={seo.canonical}/>
    <meta name="robots" content={seo.robots}/>

    <!-- Theme color -->
    <meta name="theme-color" content="#0E2A47" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#071826" media="(prefers-color-scheme: dark)">

    <!-- Open Graph -->
    <meta property="og:site_name" content={seo.site.siteName}/>
    <meta property="og:type" content={seo.type}/>
    <meta property="og:title" content={seo.title}/>
    <meta property="og:description" content={seo.description}/>
    <meta property="og:url" content={seo.canonical}/>
    <meta property="og:image" content={seo.image.url}/>
    {seo.image.width &&
            <meta property="og:image:width" content={seo.image.width.toString()}/>}
    {seo.image.height &&
            <meta property="og:image:height" content={seo.image.height.toString()}/>}
    {seo.image.alt &&
            <meta property="og:image:alt" content={seo.image.alt}/>}
</head>

<body>

<Header/>

<main>
    <slot/>
</main>

<Footer/>

</body>
</html>